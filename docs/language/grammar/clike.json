{
  "schema_version": 1,
  "language_version": "0.1-draft",
  "syntax": "clike",
  "entrypoint": "source",
  "root_entrypoints": {"library": "module", "executable": "module", "submission": "submission", "script": "submission"},
  "rule_id_template": "F-LEX-CLIKE-{production}",
  "imports": ["common.json"],
  "tokens": {
    "line_comment": {"pattern": "//[^\\r\\n]*", "skip": true},
    "delimiter": {"pattern": "[()\\[\\]{};,.:<>=!+\\-*/\"`]"},
    "word_extra": {"pattern": "(?!)", "description": "This frontend's identifiers are XID only, so no extra word characters exist and `a-b` is a subtraction."},
    "identifier": {"pattern": "\\p{XID_Start}\\p{XID_Continue}*", "description": "A lowercase-initial spelling is camelCase for the canonical hyphenated name; an uppercase-initial spelling is canonical as written."},
    "raw_identifier": {"pattern": "`[^`\\r\\n]+`", "description": "The canonical name written verbatim, for names camelCase cannot spell."}
  },
  "productions": {
    "source": {"alternatives": ["module", "submission"], "semantic_node": "SourceRoot"},
    "module": {"alternatives": ["declaration* EOF"], "semantic_node": "Module"},
    "submission": {"alternatives": ["items EOF"], "semantic_node": "Submission"},
    "items": {"alternatives": ["(declaration | local_decl | expression ';')* expression?"], "semantic_node": "Sequence"},
    "declaration": {"alternatives": ["function_decl", "variant_decl"]},
    "function_decl": {"alternatives": ["ctype name '(' parameters? ')' attribute* block"], "semantic_node": "FunctionDecl"},
    "parameters": {"alternatives": ["parameter (',' parameter)*"]},
    "parameter": {"alternatives": ["'mut' ctype name", "'move' ctype name", "ctype name"], "semantic_node": "Parameter"},
    "attribute": {"alternatives": ["'plain'", "'inferred'", "'pure'", "'nothrow'", "'suspends'", "'nonSuspending'", "'effectsInfer'", "'throwsInfer'", "'suspendsInfer'"], "semantic_node": "CallableContract"},
    "variant_decl": {"alternatives": ["'variant' name '{' variant_case (',' variant_case)* ','? '}'"], "semantic_node": "VariantDecl"},
    "variant_case": {"alternatives": ["name '(' ctype (',' ctype)* ')'", "name"], "semantic_node": "VariantCase"},
    "local_decl": {"alternatives": ["'mut'? local_type name '=' expression ';'"], "semantic_node": "Let"},
    "local_type": {"alternatives": ["'auto'", "ctype"]},
    "name": {"alternatives": ["raw_identifier", "identifier"]},
    "ctype": {"alternatives": ["ctype_base array_suffix* function_suffix?"], "semantic_node": "TypeExpression"},
    "array_suffix": {"alternatives": ["'[' (dimension (',' dimension)*)? ']'"]},
    "dimension": {"alternatives": ["integer", "name"]},
    "ctype_base": {"alternatives": ["name '!' '(' ctype (',' ctype)* ')'", "name"]},
    "function_suffix": {"alternatives": ["'function' '(' (type_parameter (',' type_parameter)*)? ')' attribute*"], "semantic_node": "CallableType"},
    "type_parameter": {"alternatives": ["'mut' ctype", "'move' ctype", "ctype"]},
    "expression": {"alternatives": ["'return' expression", "'throw' expression", "'yield' expression", "assignment", "comparison"]},
    "assignment": {"alternatives": ["name '=' expression"], "semantic_node": "Assign"},
    "comparison": {"alternatives": ["additive (comparison_operator additive)?"], "semantic_node": "Call"},
    "comparison_operator": {"alternatives": ["'=='", "'!='", "'<='", "'>='", "'<'", "'>'"]},
    "additive": {"alternatives": ["multiplicative (additive_operator multiplicative)*"], "semantic_node": "Call"},
    "additive_operator": {"alternatives": ["'+'", "'-'"]},
    "multiplicative": {"alternatives": ["unary (multiplicative_operator unary)*"], "semantic_node": "Call"},
    "multiplicative_operator": {"alternatives": ["'*'", "'/'"]},
    "unary": {"alternatives": ["'-' unary", "postfix"]},
    "postfix": {"alternatives": ["primary postfix_operator*"]},
    "postfix_operator": {"alternatives": ["call_arguments", "'.' name"]},
    "call_arguments": {"alternatives": ["'(' (expression (',' expression)*)? ')'"], "semantic_node": "Call"},
    "primary": {"alternatives": ["literal", "if_expression", "while_expression", "match_expression", "try_expression", "scope_expression", "lambda", "'break'", "'continue'", "'rethrow'", "block", "record_construct", "unit", "'(' expression ')'", "name"]},
    "literal": {"alternatives": ["integer", "escaped_string", "'true'", "'false'"]},
    "unit": {"alternatives": ["'(' ')'"], "semantic_node": "UnitLiteral"},
    "block": {"alternatives": ["'{' items '}'"], "semantic_node": "Sequence"},
    "if_expression": {"alternatives": ["'if' '(' expression ')' expression ('else' expression)?"], "semantic_node": "If"},
    "while_expression": {"alternatives": ["'while' '(' expression ')' expression"], "semantic_node": "While"},
    "match_expression": {"alternatives": ["'match' 'move'? '(' expression ')' '{' match_arm (',' match_arm)* ','? '}'"], "semantic_node": "Match"},
    "match_arm": {"alternatives": ["pattern '=>' expression"], "semantic_node": "MatchArm"},
    "pattern": {"alternatives": ["'_'", "literal", "name '(' (pattern (',' pattern)*)? ')'", "name '{' field_pattern (',' field_pattern)* '}'", "name"], "semantic_node": "Pattern"},
    "field_pattern": {"alternatives": ["name ':' pattern"]},
    "try_expression": {"alternatives": ["'try' expression catch_clause+"], "semantic_node": "Try"},
    "catch_clause": {"alternatives": ["'catch' '(' pattern ')' expression"], "semantic_node": "Catch"},
    "scope_expression": {"alternatives": ["'scope' '{' guard* items '}'"], "semantic_node": "Scope"},
    "guard": {"alternatives": ["guard_word expression ';'"], "semantic_node": "Guard"},
    "guard_word": {"alternatives": ["'onExit'", "'onSuccess'", "'onFailure'", "'onCancel'"]},
    "lambda": {"alternatives": ["capture_list? '(' parameters? ')' attribute* '=>' expression"], "semantic_node": "Lambda"},
    "capture_list": {"alternatives": ["'[' (capture (',' capture)*)? ']'"], "semantic_node": "CaptureSpec"},
    "capture": {"alternatives": ["'move'", "capture_mode name"], "semantic_node": "CaptureEntry"},
    "capture_mode": {"alternatives": ["'borrow'", "'mut'", "'steal'", "'copy'", "'retain'", "'weaken'"]},
    "record_construct": {"alternatives": ["name '{' (field_init (',' field_init)*)? ','? '}'"], "semantic_node": "RecordConstruct"},
    "field_init": {"alternatives": ["name ':' expression"]}
  },
  "reserved_words": ["plain", "inferred", "pure", "nothrow", "suspends", "auto", "mut", "move", "if", "else", "while", "break", "continue", "return", "match", "try", "catch", "throw", "rethrow", "yield", "scope", "onExit", "onSuccess", "onFailure", "onCancel", "variant", "function", "nonSuspending", "effectsInfer", "throwsInfer", "suspendsInfer", "copy", "retain", "weaken"]
}
