{
  "schema_version": 1,
  "language_version": "0.1-draft",
  "syntax": "colisp",
  "entrypoint": "source",
  "root_entrypoints": {"library": "module", "executable": "module", "submission": "submission", "script": "submission"},
  "rule_id_template": "F-LEX-COLISP-{production}",
  "imports": ["common.json"],
  "tokens": {
    "line_comment": {"pattern": ";[^\\r\\n]*", "skip": true},
    "delimiter": {"pattern": "[()\\[\\]{}'`,@.:<>=]"},
    "triple_string": {"pattern": "TRIPLE-QUOTE TRIPLE-CONTENT TRIPLE-QUOTE", "scanner": "triple-string"},
    "colisp_character": {"pattern": "#\\\\(?:space|newline|tab|u\\{[0-9A-Fa-f]+\\}|[^\\r\\n])", "description": "Escape processing and the exactly-one-Unicode-scalar constraint are checked after tokenization."},
    "colisp_boolean": {"pattern": "#(?:t|f)(?![\\p{XID_Continue}?!-])"},
    "json_string": {"pattern": "\\\"(?:[\\x20-\\x21\\x23-\\x5b\\x5d-\\x7e]|[^\\x00-\\x1f\\x7f-\\x9f\\\"\\\\]|\\\\(?:[\\\"\\\\/bfnrt]|u[0-9A-Fa-f]{4}))*\\\"", "description": "RFC 8259 JSON string; surrogate-pair validation and scalar decoding occur after tokenization."},
    "json_number": {"pattern": "-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"}
  },
  "productions": {
    "source": {"alternatives": ["module", "submission"], "semantic_node": "SourceRoot"},
    "module": {"alternatives": ["declaration* EOF"], "semantic_node": "Module", "recovery": ["top_level_close", "EOF"]},
    "submission": {"alternatives": ["form* EOF"], "semantic_node": "Submission", "recovery": ["top_level_close", "EOF"]},
    "declaration": {"alternatives": ["'(' (define_form | record_form | variant_form | concept_form | implementation_form | import_form | from_form | export_form | extern_form | test_form | test_suite_form) ')'", "reader_decorator"]},
    "literal": {"alternatives": ["triple_string", "colisp_character", "colisp_boolean", "base_literal"]},
    "form": {"alternatives": ["expression"]},
    "quote": {"alternatives": ["\"'\" form"], "semantic_node": "DatumQuote"},
    "syntax_quote": {"alternatives": ["'`' syntax_form"], "semantic_node": "SyntaxQuote"},
    "reader_decorator": {"alternatives": ["'@' identifier form"], "semantic_node": "MixinSugar"},
    "syntax_form": {"alternatives": ["',@' form", "',' form", "literal", "identifier", "operator_identifier", "keyword", "vector_syntax", "list_syntax"]},
    "vector_syntax": {"alternatives": ["'[' syntax_form* ']'"]},
    "list_syntax": {"alternatives": ["'(' syntax_form* ')'"]},
    "json_literal": {"alternatives": ["'json[' json_array_tail", "'json{' json_object_tail"], "semantic_node": "JsonLiteral", "recovery": ["']'", "'}'"]},
    "json_array_tail": {"alternatives": ["json_value (',' json_value)* ']'", "']'"]},
    "json_object_tail": {"alternatives": ["json_string ':' json_value (',' json_string ':' json_value)* '}'", "'}'"]},
    "json_value": {"alternatives": ["json_string", "json_number", "'true'", "'false'", "'null'", "'[' json_array_tail", "'{' json_object_tail"]},
    "vector": {"alternatives": ["'[' form* ']'"], "semantic_node": "SequenceSyntax", "recovery": ["']'"]},
    "list": {"alternatives": ["'(' list_body ')'"], "recovery": ["')'"]},
    "list_body": {"alternatives": ["record_constructor", "reserved_form", "call", "empty"]},
    "empty": {"alternatives": ["EPSILON"], "semantic_node": "UnitLiteral"},
    "call": {"alternatives": ["form form*"], "semantic_node": "Call"},
    "reserved_form": {"alternatives": ["define_form", "lambda_form", "let_form", "set_form", "begin_form", "if_form", "while_form", "break_form", "continue_form", "return_form", "match_form", "try_form", "throw_form", "rethrow_form", "yield_form", "scope_form", "record_form", "variant_form", "concept_form", "implementation_form", "index_form", "import_form", "from_form", "export_form", "mixin_form", "ct_foreach_form", "unsafe_form", "extern_form", "test_form", "test_suite_form", "member_access"]},
    "member_access": {"alternatives": ["'.' expression identifier"], "semantic_node": "MemberAccess"},
    "index_form": {"alternatives": ["'get' expression expression"], "semantic_node": "Call"},
    "define_form": {"alternatives": ["'define' '(' identifier generic_header? parameter* ')' ':' type contract? expression+"], "semantic_node": "FunctionDecl"},
    "lambda_form": {"alternatives": ["'lambda' capture_spec? '(' parameter* ')' contract? expression+"], "semantic_node": "Lambda"},
    "parameter": {"alternatives": ["'(' identifier ':' type ')'", "'(' 'borrow-mut' identifier ':' type ')'", "'(' 'steal' identifier ':' type ')'"], "semantic_node": "Parameter"},
    "generic_header": {"alternatives": ["'<' colisp_generic_entry (',' colisp_generic_entry)* '>'"]},
    "colisp_generic_entry": {"alternatives": ["'value' identifier ':' type where_clause?", "'effect' identifier", "'exceptions' identifier", "'region' identifier", "'stack' identifier", "'infer' identifier ':' kind", "'(' 'types' identifier+ '...' ')'", "'(' 'values' identifier+ ':' type+ '...' ')'", "'(' 'params' identifier+ '...' ')'", "type_generic_entry"]},
    "where_clause": {"alternatives": ["'where' expression"]},
    "capture_spec": {"alternatives": ["':move'", "'(' ':captures' ':move'? capture_entry* ')'"], "semantic_node": "CaptureSpec"},
    "capture_entry": {"alternatives": ["'(' ownership_mode identifier ')'"], "semantic_node": "CaptureEntry"},
    "let_form": {"alternatives": ["'let' '[' binding* ']' expression+"], "semantic_node": "Let"},
    "binding": {"alternatives": ["'mut' identifier (':' type)? expression", "identifier (':' type)? expression"]},
    "set_form": {"alternatives": ["'set!' place expression"], "semantic_node": "Assign"},
    "begin_form": {"alternatives": ["'begin' expression*"], "semantic_node": "Sequence"},
    "if_form": {"alternatives": ["'if' expression expression expression"], "semantic_node": "If"},
    "while_form": {"alternatives": ["'while' expression expression+"], "semantic_node": "While"},
    "break_form": {"alternatives": ["'break'"], "semantic_node": "Break"},
    "continue_form": {"alternatives": ["'continue'"], "semantic_node": "ContinueLoop"},
    "return_form": {"alternatives": ["'return' expression"], "semantic_node": "Return"},
    "match_form": {"alternatives": ["'match' ownership_marker? expression match_arm+"], "semantic_node": "Match"},
    "ownership_marker": {"alternatives": ["':borrow'", "':steal'"]},
    "match_arm": {"alternatives": ["'(' pattern expression+ ')'"], "semantic_node": "MatchArm"},
    "try_form": {"alternatives": ["'try' expression+ catch_clause+"], "semantic_node": "Try"},
    "catch_clause": {"alternatives": ["'(' 'catch' pattern expression+ ')'"], "semantic_node": "Catch"},
    "throw_form": {"alternatives": ["'throw' expression"], "semantic_node": "Throw"},
    "rethrow_form": {"alternatives": ["'rethrow'"], "semantic_node": "Rethrow"},
    "yield_form": {"alternatives": ["'yield' expression"], "semantic_node": "Yield"},
    "scope_form": {"alternatives": ["'scope' scope_guard* expression+"], "semantic_node": "Scope"},
    "scope_guard": {"alternatives": ["'(' 'on-exit' expression+ ')'", "'(' 'on-success' expression+ ')'", "'(' 'on-failure' expression+ ')'", "'(' 'on-cancel' expression+ ')'"], "semantic_node": "Guard"},
    "record_form": {"alternatives": ["'record' identifier generic_header? repr_clause? field_decl*"], "semantic_node": "RecordDecl"},
    "record_constructor": {"alternatives": ["identifier keyword expression (keyword expression)*"], "semantic_node": "RecordConstruct"},
    "field_decl": {"alternatives": ["'(' 'field' visibility? identifier ':' type ')'"], "semantic_node": "FieldDecl"},
    "variant_form": {"alternatives": ["'variant' identifier generic_header? variant_case*"], "semantic_node": "VariantDecl"},
    "variant_case": {"alternatives": ["'(' identifier ')'", "'(' identifier type+ ')'", "'(' identifier field_decl+ ')'"], "semantic_node": "VariantCase"},
    "repr_clause": {"alternatives": ["'(' 'repr' repr_mode ')'"], "semantic_node": "Representation"},
    "repr_mode": {"alternatives": ["'native'", "'C'", "'stable' integer"]},
    "concept_form": {"alternatives": ["'concept' identifier concept_modifier* generic_header? concept_requirement*"], "semantic_node": "ConceptDecl"},
    "concept_modifier": {"alternatives": ["'symmetric'", "'commutative'", "'trusted-law'", "'stable-evidence'", "'(' 'evidence-version' integer ')'" ]},
    "concept_requirement": {"alternatives": ["'(' operation_form ')'", "'(' associated_form ')'", "axiom_form"]},
    "axiom_form": {"alternatives": ["'(' 'axiom' identifier expression ')'"], "semantic_node": "AxiomDecl"},
    "implementation_form": {"alternatives": ["'implementation' generic_header? type (':' type)? implementation_member*"], "semantic_node": "ImplementationDecl"},
    "implementation_member": {"alternatives": ["'(' constructor_form ')'", "'(' get_form ')'", "'(' set_member_form ')'", "'(' operation_form ')'", "'(' associated_form ')'" ]},
    "constructor_form": {"alternatives": ["'constructor' '(' identifier parameter* ')' ':' type contract? expression+"], "semantic_node": "ConstructorDecl"},
    "get_form": {"alternatives": ["'get' '(' identifier '(' 'self' ')' ')' ':' type contract? expression+"], "semantic_node": "GetterDecl"},
    "set_member_form": {"alternatives": ["'set' '(' identifier '(' 'borrow-mut' 'self' ')' parameter ')' ':' 'unit' contract? expression+"], "semantic_node": "SetterDecl"},
    "operation_form": {"alternatives": ["'operation' stable_key? (identifier | operator_identifier) callable_signature operation_body?"], "semantic_node": "OperationDecl"},
    "stable_key": {"alternatives": ["'#' integer"]},
    "callable_signature": {"alternatives": ["'(' parameter* ')' ':' type contract?"], "semantic_node": "CallableSignature"},
    "operation_body": {"alternatives": ["'=>' qualified_name", "expression+"]},
    "associated_form": {"alternatives": ["'associated' identifier associated_value?"], "semantic_node": "AssociatedDecl"},
    "associated_value": {"alternatives": ["type !expression", "expression"]},
    "import_form": {"alternatives": ["'import' module_path import_binding*"], "semantic_node": "ImportDecl"},
    "from_form": {"alternatives": ["'from' module_path ':import' import_binding*"], "semantic_node": "ImportDecl"},
    "import_binding": {"alternatives": ["identifier", "'(' identifier ':as' identifier ')'", "'(' ':as' identifier ')'", "'*'"]},
    "export_form": {"alternatives": ["'export' identifier*"], "semantic_node": "ExportDecl"},
    "mixin_form": {"alternatives": ["'mixin' expression"], "semantic_node": "Mixin"},
    "ct_foreach_form": {"alternatives": ["'ct-foreach' '[' identifier expression ']' expression+"], "semantic_node": "CtForeach"},
    "unsafe_form": {"alternatives": ["'unsafe' expression+"], "semantic_node": "Unsafe"},
    "extern_form": {"alternatives": ["'extern' escaped_string identifier callable_signature"], "semantic_node": "ExternDecl"},
    "test_suite_form": {"alternatives": ["'test-suite' escaped_string ('(' test_form ')')*"], "semantic_node": "TestSuiteDecl"},
    "test_form": {"alternatives": ["'test' escaped_string '(' identifier ')' expression+"], "semantic_node": "TestDecl"},
    "expression": {"alternatives": ["json_literal", "literal", "identifier", "operator_identifier", "keyword", "vector", "list", "quote", "syntax_quote", "reader_decorator"]},
    "place": {"alternatives": ["identifier", "'(' '.' place identifier ')'", "'(' 'get' place expression ')'"], "semantic_node": "Place"},
    "pattern": {"alternatives": ["'_'", "literal", "identifier", "keyword pattern", "'(' ':or' pattern+ ')'", "'(' ':as' pattern identifier ')'", "'(' identifier pattern* ')'", "'[' pattern* ']'"], "semantic_node": "Pattern"}
  },
  "reserved_words": ["mut", "on-exit", "on-success", "on-failure", "on-cancel","associated", "axiom", "begin", "borrow-mut", "break", "catch", "concept", "constructor", "continue", "ct-foreach", "define", "export", "extern", "field", "from", "get", "if", "implementation", "import", "lambda", "let", "match", "mixin", "operation", "record", "repr", "rethrow", "return", "scope", "set", "set!", "stable-evidence", "steal", "test", "test-suite", "throw", "trusted-law", "try", "unsafe", "variant", "while", "yield"]
}
