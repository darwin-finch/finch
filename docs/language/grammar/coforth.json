{
  "schema_version": 1,
  "language_version": "0.1-draft",
  "syntax": "coforth",
  "entrypoint": "source",
  "root_entrypoints": {"library": "module", "executable": "module", "submission": "submission", "script": "submission"},
  "rule_id_template": "F-LEX-COFORTH-{production}",
  "imports": ["common.json"],
  "tokens": {
    "line_comment": {"pattern": "\\\\[^\\r\\n]*", "skip": true},
    "delimiter": {"pattern": "[()\\[\\]{};|,.:<>=]"},
    "label": {"pattern": "(?:\\p{XID_Start})(?:\\p{XID_Continue}|[-?!])*:", "description": "Normalizes to the identifier payload plus a colon terminal; permits canonical name: spelling without whitespace."},
    "escaped_string": {"pattern": "S-PREFIX? QUOTE ESCAPED-CONTENT QUOTE", "scanner": "coforth-string", "description": "Linear escaped-string scanner; when the s prefix is present, exactly one ASCII space immediately after the opener is syntax and not content."},
    "member_projection": {"pattern": "\\.(?:\\p{XID_Start})(?:\\p{XID_Continue}|[-?!])*"},
    "member_mutation": {"pattern": "\\.(?:\\p{XID_Start})(?:\\p{XID_Continue}|[-?])*!(?![\\p{XID_Continue}?!-])", "description": "Consumes receiver then value from the typed stack and invokes the field/property setter."},
    "triple_string": {"pattern": "S-PREFIX? TRIPLE-QUOTE TRIPLE-CONTENT TRIPLE-QUOTE", "scanner": "triple-string"},
    "coforth_character": {"pattern": "c\\\"(?:[^\\\"\\\\\\r\\n]|\\\\u\\{[0-9A-Fa-f]+\\})\\\"", "description": "Only a literal scalar or the normative Unicode escape is accepted; exactly one Unicode scalar is required."}
    ,"parenthesized_comment": {"pattern": "balanced('(',')')", "scanner": "balanced", "skip": true, "description": "Enabled only in the expression lexical mode of explicitly tagged Co-Forth; disabled in signature mode. Nesting is allowed."}
  },
  "productions": {
    "source": {"alternatives": ["module", "submission"], "semantic_node": "SourceRoot"},
    "module": {"alternatives": ["declaration* EOF"], "semantic_node": "Module", "recovery": ["';'", "EOF"]},
    "submission": {"alternatives": ["top_level* EOF"], "semantic_node": "Submission", "recovery": ["';'", "EOF"]},
    "declaration": {"alternatives": ["function_decl", "record_decl", "variant_decl", "concept_decl", "implementation_decl", "import_decl", "from_decl", "export_decl", "extern_decl", "test_suite_decl", "test_decl"]},
    "literal": {"alternatives": ["triple_string", "coforth_character", "base_literal"]},
    "top_level": {"alternatives": ["function_decl", "record_decl", "variant_decl", "concept_decl", "implementation_decl", "import_decl", "from_decl", "export_decl", "extern_decl", "test_suite_decl", "test_decl", "expression"]},
    "function_decl": {"alternatives": ["':' identifier generic_header? stack_signature expression* ';'"], "semantic_node": "FunctionDecl", "recovery": ["';'"]},
    "generic_header": {"alternatives": ["'<' generic_entry (',' generic_entry)* '>'"]},
    "where_clause": {"alternatives": ["'where' expression"]},
    "stack_signature": {"alternatives": ["'(' stack_input '--' stack_output contract? ')'"], "semantic_node": "CallableSignature", "recovery": ["')'"]},
    "stack_input": {"alternatives": ["stack_entry*"]},
    "stack_output": {"alternatives": ["stack_entry*"]},
    "stack_entry": {"alternatives": ["stack_row", "source_mode? label type", "source_mode? identifier ':' type", "source_mode? type"]},
    "stack_row": {"alternatives": ["identifier '...'"], "semantic_node": "StackRow"},
    "source_mode": {"alternatives": ["'borrow'", "'borrow-mut'", "'steal'", "'copy'"]},
    "quotation": {"alternatives": ["'[' capture_spec? stack_signature '|' expression* ']'"], "semantic_node": "Lambda", "recovery": ["']'"]},
    "capture_spec": {"alternatives": ["'captures:' 'move' capture_entries", "'captures:' 'move'", "'captures:' capture_entries"], "semantic_node": "CaptureSpec"},
    "capture_entries": {"alternatives": ["'{' capture_entry* '}'"]},
    "capture_entry": {"alternatives": ["ownership_mode identifier"]},
    "locals": {"alternatives": ["'{' local_entry* '--' local_entry* '}'"], "semantic_node": "Locals"},
    "local_entry": {"alternatives": ["'mut'? label type", "'mut'? identifier ':' type", "'mut'? identifier"]},
    "assignment": {"alternatives": ["'to' identifier"], "semantic_node": "Assign", "recovery": ["';'", "']'", "'}'"]},
    "if_expression": {"alternatives": ["'if' expression* ('else' expression*)? 'then'"], "semantic_node": "If"},
    "while_expression": {"alternatives": ["'begin' expression* 'while' expression* 'repeat'"], "semantic_node": "While"},
    "break_expression": {"alternatives": ["'break'"], "semantic_node": "Break"},
    "continue_expression": {"alternatives": ["'continue'"], "semantic_node": "ContinueLoop"},
    "return_expression": {"alternatives": ["'return'"], "semantic_node": "Return"},
    "match_expression": {"alternatives": ["ownership_marker? 'match' match_arm+ 'endmatch'"], "semantic_node": "Match"},
    "ownership_marker": {"alternatives": ["'borrow'", "'steal'"]},
    "match_arm": {"alternatives": ["pattern 'of' expression* 'endof'"], "semantic_node": "MatchArm"},
    "try_expression": {"alternatives": ["'try' expression* catch_arm+ 'endtry'"], "semantic_node": "Try"},
    "catch_arm": {"alternatives": ["'catch' pattern 'of' expression* 'endof'"], "semantic_node": "Catch"},
    "throw_expression": {"alternatives": ["'throw'"], "semantic_node": "Throw"},
    "rethrow_expression": {"alternatives": ["'rethrow'"], "semantic_node": "Rethrow"},
    "scope_expression": {"alternatives": ["'scope' scope_guard* expression* 'endscope'"], "semantic_node": "Scope"},
    "scope_guard": {"alternatives": ["'on-exit' quotation", "'on-success' quotation", "'on-failure' quotation", "'on-cancel' quotation"], "semantic_node": "Guard"},
    "record_decl": {"alternatives": ["'record:' identifier generic_header? repr_clause? 'fields{' field_decl* '}' ';'"], "semantic_node": "RecordDecl", "recovery": ["';'"]},
    "field_decl": {"alternatives": ["visibility? label type", "visibility? identifier ':' type"], "semantic_node": "FieldDecl"},
    "variant_decl": {"alternatives": ["'variant:' identifier generic_header? 'cases{' variant_case* '}' ';'"], "semantic_node": "VariantDecl", "recovery": ["';'"]},
    "variant_case": {"alternatives": ["identifier '(' type_list ')'", "identifier '{' field_decl* '}'", "identifier"], "semantic_node": "VariantCase"},
    "repr_clause": {"alternatives": ["'repr(' repr_mode ')'"], "semantic_node": "Representation"},
    "repr_mode": {"alternatives": ["'native'", "'C'", "'stable' integer"]},
    "concept_decl": {"alternatives": ["'concept:' identifier concept_modifier* generic_header? concept_requirement* ';'"], "semantic_node": "ConceptDecl", "recovery": ["';'"]},
    "concept_modifier": {"alternatives": ["'symmetric'", "'commutative'", "'trusted-law'", "'stable-evidence'", "'evidence-version' integer"]},
    "concept_requirement": {"alternatives": ["operation_decl", "associated_decl", "axiom_decl"]},
    "axiom_decl": {"alternatives": ["'axiom:' identifier expression+ ';'"], "semantic_node": "AxiomDecl"},
    "implementation_decl": {"alternatives": ["'implementation:' generic_header? type (':' type)? implementation_member* ';'"], "semantic_node": "ImplementationDecl", "recovery": ["';'"]},
    "implementation_member": {"alternatives": ["constructor_decl", "get_decl", "set_decl", "operation_decl", "associated_decl"]},
    "constructor_decl": {"alternatives": ["'constructor:' identifier stack_signature expression* ';'"], "semantic_node": "ConstructorDecl"},
    "get_decl": {"alternatives": ["'get:' identifier stack_signature expression* ';'"], "semantic_node": "GetterDecl"},
    "set_decl": {"alternatives": ["'set:' identifier stack_signature expression* ';'"], "semantic_node": "SetterDecl"},
    "operation_decl": {"alternatives": ["'operation:' stable_key? (identifier | operator_identifier) stack_signature ('=>' qualified_name | expression*) ';'"], "semantic_node": "OperationDecl"},
    "stable_key": {"alternatives": ["'#' integer"]},
    "associated_decl": {"alternatives": ["'associated:' identifier type ';'", "'associated:' identifier expression* ';'"], "semantic_node": "AssociatedDecl"},
    "import_decl": {"alternatives": ["'import:' module_path 'import{' import_binding* '}' ';'"], "semantic_node": "ImportDecl"},
    "from_decl": {"alternatives": ["'from:' module_path 'import{' import_binding* '}' ';'"], "semantic_node": "ImportDecl"},
    "import_binding": {"alternatives": ["identifier 'as' identifier", "identifier", "'*'"]},
    "export_decl": {"alternatives": ["'export:' identifier* ';'"], "semantic_node": "ExportDecl"},
    "extern_decl": {"alternatives": ["'extern:' escaped_string identifier stack_signature ';'"], "semantic_node": "ExternDecl"},
    "test_suite_decl": {"alternatives": ["'test-suite:' escaped_string '{' test_decl* '}'"], "semantic_node": "TestSuiteDecl"},
    "test_decl": {"alternatives": ["'test:' escaped_string stack_signature '{' expression* '}'"], "semantic_node": "TestDecl"},
    "ct_foreach": {"alternatives": ["'ct-foreach' identifier expression+ 'do' expression* 'end-ct-foreach'"], "semantic_node": "CtForeach"},
    "mixin": {"alternatives": ["'mixin'"], "semantic_node": "Mixin"},
    "syntax_argument": {"alternatives": ["'syntax[' expression* ']'"], "semantic_node": "RetainedSyntax"},
    "unsafe_expression": {"alternatives": ["'unsafe[' expression* ']'"], "semantic_node": "Unsafe"},
    "record_constructor": {"alternatives": ["identifier '{' named_argument* '}'"], "semantic_node": "RecordConstruct"},
    "named_argument": {"alternatives": ["field_label field_value+"]},
    "field_label": {"alternatives": ["label", "identifier ':'"]},
    "field_value": {"alternatives": ["!field_label expression"]},
    "args_block": {"alternatives": ["'args{' expression* '}'"], "semantic_node": "ArgumentPack"},
    "rest_block": {"alternatives": ["'rest{' expression* '}'"], "semantic_node": "RestArguments"},
    "reference": {"alternatives": ["\"'\" (identifier | operator_identifier)"], "semantic_node": "Read"},
    "call_expression": {"alternatives": ["'call'"], "semantic_node": "Call"},
    "yield_expression": {"alternatives": ["'yield'"], "semantic_node": "Yield"},
    "expression": {"alternatives": ["literal", "keyword", "syntax_argument", "unsafe_expression", "args_block", "rest_block", "record_constructor", "reference", "call_expression", "identifier", "operator_identifier", "member_mutation", "member_projection", "quotation", "locals", "assignment", "if_expression", "while_expression", "break_expression", "continue_expression", "return_expression", "match_expression", "try_expression", "throw_expression", "rethrow_expression", "yield_expression", "scope_expression", "ct_foreach", "mixin"]},
    "pattern": {"alternatives": ["pattern_atom ('as' identifier)?"], "semantic_node": "Pattern"},
    "pattern_atom": {"alternatives": ["'_'", "literal", "'or{' pattern+ '}'", "identifier '(' pattern* ')'", "identifier '{' named_pattern* '}'", "identifier", "'[' pattern* ']'"]},
    "named_pattern": {"alternatives": ["label pattern", "identifier ':' pattern"]}
  },
  "reserved_words": ["args{", "as", "associated:", "axiom:", "begin", "borrow", "borrow-mut", "break", "captures:", "cases{", "catch", "concept:", "constructor:", "continue", "ct-foreach", "on-exit", "call", "do", "else", "end-ct-foreach", "endmatch", "endof", "endscope", "endtry", "export:", "extern:", "fields{", "from:", "get:", "if", "implementation:", "import:", "import{", "match", "mixin", "mut", "of", "on-cancel", "on-failure", "on-success", "operation:", "or{", "record:", "repeat", "repr(", "rest{", "rethrow", "return", "scope", "set:", "stable-evidence", "steal", "syntax[", "test-suite:", "test:", "then", "throw", "to", "trusted-law", "try", "unsafe[", "variant:", "where", "while", "yield"]
}
