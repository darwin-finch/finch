{
  "schema_version": 1,
  "language_version": "0.1-draft",
  "syntax": "common",
  "entrypoint": "type",
  "rule_id_template": "F-LEX-COMMON-{production}",
  "tokens": {
    "identifier": {"pattern": "(?:\\p{XID_Start})(?:\\p{XID_Continue}|[-?!])*"},
    "operator_identifier": {"pattern": "(?:\\+|-|\\*|/|==|!=|<=|>=|<|>)"},
    "integer": {"pattern": "(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*)(?:i8|i16|i32|i64|u8|u16|u32|u64)?"},
    "float": {"pattern": "(?:[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)|[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*)(?:f32|f64)?"},
    "negative_numeric": {"pattern": "-(?:(?:[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)|[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*)(?:f32|f64)?|(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*)(?:i8|i16|i32|i64|u8|u16|u32|u64)?)", "description": "Reader composite normalized to unary negation of the unsigned numeric token; minimum signed values are range-checked after folding."},
    "escaped_string": {"pattern": "\\\"(?:[^\\\"\\\\]|\\\\(?:[\\\\\\\"nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}))*\\\""},
    "raw_string": {"pattern": "r HASH{0,255} QUOTE RAW-CONTENT MATCHING-CLOSE", "scanner": "raw-string", "description": "A linear scanner records the opening hash count and advances once to the first quote followed by exactly that count."},
    "keyword": {"pattern": ":[\\p{XID_Start}](?:\\p{XID_Continue}|[-?!])*"},
    "whitespace": {"pattern": "[\\p{White_Space}]+", "skip": true},
    "word_extra": {"pattern": "[-?!]", "description": "Characters that continue a word in addition to XID_Continue; a frontend may replace this class."}
  },
  "productions": {
    "type": {"alternatives": ["primary_type type_suffix*"], "semantic_node": "TypeExpression"},
    "primary_type": {"alternatives": ["callable_type", "exception_set_type", "loan_type", "'scoped' 'stable' loan_type", "'scoped' loan_type", "'stable' loan_type", "'dyn' type", "'some' type", "qualified_name"]},
    "callable_type": {"alternatives": ["'callable' '<' '(' (callable_parameter (',' callable_parameter)*)? ')' '->' type contract? '>'"], "semantic_node": "CallableType"},
    "callable_parameter": {"alternatives": ["'borrow-mut' type", "'steal' type", "type"]},
    "loan_type": {"alternatives": ["'&mut' type", "'&' type"]},
    "exception_set_type": {"alternatives": ["'throws' '<' type_list? '>'"], "semantic_node": "ExceptionSetType"},
    "type_suffix": {"alternatives": ["generic_arguments", "projection"]},
    "generic_arguments": {"alternatives": ["'<' type_argument (',' type_argument)* '>'"]},
    "type_argument": {"alternatives": ["associated_binding", "refined_path_argument", "type !const_operator", "const_expression"], "semantic_node": "GenericArgument"},
    "const_operator": {"alternatives": ["'+'", "'-'", "'*'", "'/'"]},
    "associated_binding": {"alternatives": ["identifier '=' type_argument"]},
    "refined_path_argument": {"alternatives": ["qualified_name ':' escaped_string"], "semantic_node": "RefinedPathArgument"},
    "projection": {"alternatives": ["'::' identifier"]},
    "qualified_name": {"alternatives": ["identifier ('::' identifier)*"]},
    "module_path": {"alternatives": ["'pkg' ('.' 'super')* '.' identifier ('.' identifier)*", "identifier ('.' identifier)*"], "semantic_node": "ModulePath"},
    "const_expression": {"alternatives": ["const_sum"]},
    "const_sum": {"alternatives": ["const_product (('+' | '-') const_product)*"]},
    "const_product": {"alternatives": ["const_primary (('*' | '/') const_primary)*"]},
    "const_primary": {"alternatives": ["integer", "negative_numeric", "identifier", "'(' const_expression ')'"]},
    "selector": {"alternatives": ["'root' '(' identifier ')'", "'arg' '(' identifier ')'", "escaped_string", "'join' '(' selector ',' selector ')'", "'narrow' '(' selector ',' selector_pattern ')'"]},
    "selector_pattern": {"alternatives": ["escaped_string"], "semantic_node": "SelectorPattern"},
    "contract": {"alternatives": ["'!' contract_item ('|' contract_item)*"], "semantic_node": "CallableContract"},
    "contract_item": {"alternatives": ["capability_request", "'plain'", "'inferred'", "'pure'", "'effects' '<' identifier? '>'", "'effects-infer'", "'state' '<' state_target '>'", "'state-read' '<' state_target '>'", "'returns-loan' '<' 'arg' '(' identifier ')' '>'", "'nothrow'", "'throws' '<' exception_spec? '>'", "'throws-infer'", "'non-suspending'", "'suspends'", "'suspends-infer'", "'comptime'"]},
    "state_target": {"alternatives": ["'arg' '(' identifier ')'", "'result'", "identifier"]},
    "capability_request": {"alternatives": ["capability_name '{' named_selector (',' named_selector)* '}'"], "semantic_node": "CapabilityRequest"},
    "capability_name": {"alternatives": ["identifier ('.' identifier)+"]},
    "named_selector": {"alternatives": ["identifier '=' selector"]},
    "type_list": {"alternatives": ["type (',' type)*"]},
    "exception_spec": {"alternatives": ["type (',' type)*"], "semantic_node": "ExceptionSummary"},
    "generic_entry": {"alternatives": ["'value' identifier ':' type where_clause?", "'effect' identifier", "'exceptions' identifier", "'region' identifier", "'stack' identifier", "'infer' identifier ':' kind", "type_pack", "value_pack", "parameter_pack", "type_generic_entry"]},
    "type_generic_entry": {"alternatives": ["identifier (':' type ('+' type)*)? where_clause?"]},
    "kind": {"alternatives": ["'Type'", "'Const' '<' type '>'", "'EffectRow'", "'ExceptionSet'", "'Region'", "'StackRow'", "'TypePack'", "'ValuePack' '<' type_list? '>'", "'ParamPack'", "'Syntax'"]},
    "type_pack": {"alternatives": ["'types' identifier+ '...'?"]},
    "value_pack": {"alternatives": ["'values' identifier+ ':' type+ '...'?"]},
    "parameter_pack": {"alternatives": ["'params' identifier+ '...'?"]},
    "where_clause": {"alternatives": ["'where' expression_placeholder"]},
    "expression_placeholder": {"alternatives": ["identifier", "integer", "'(' identifier expression_placeholder* ')'"], "semantic_node": "DeferredExpression"},
    "visibility": {"alternatives": ["'pub'", "'pkg'"]},
    "ownership_mode": {"alternatives": ["'borrow'", "'borrow-mut'", "'steal'", "'copy'", "'retain'", "'weaken'"]},
    "base_literal": {"alternatives": ["negative_numeric", "float", "integer", "raw_string", "escaped_string", "'true'", "'false'", "'null'"]}
  },
  "reserved_words": ["true", "false", "null", "callable", "arg", "borrow", "borrow-mut", "comptime", "dyn", "effect", "effects", "effects-infer", "exceptions", "infer", "inferred", "narrow", "non-suspending", "nothrow", "pkg", "plain", "pub", "pure", "region", "returns-loan", "stack", "state", "state-read", "steal", "suspends", "suspends-infer", "throws-infer", "value"]
}
