{
  "schema_version": 1,
  "language_version": "0.1-draft",
  "attribute_types": ["string", "integer", "boolean", "null", "array", "object"],
  "attribute_schemas": {
    "identity": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "unsafe": {"type": "boolean"},
    "name": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1},
    "visibility": {"enum": ["private", "pkg", "pub"]},
    "generics": {"type": "array"},
    "captures": {"type": "array"},
    "type": {"type": "string", "minLength": 1},
    "ownership": {"enum": ["borrow", "borrow-mut", "steal", "copy", "retain", "weaken"]},
    "representation": {"type": "string", "minLength": 1},
    "payload_kind": {"enum": ["unit", "tuple", "record"]},
    "modifiers": {"type": "array", "items": {"type": "string"}},
    "evidence_version": {"type": "integer", "minimum": 0},
    "concept": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "stable_key": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "target": {"type": "string", "minLength": 1},
    "value": {"type": ["string", "integer", "boolean", "null", "array", "object"]},
    "module": {"type": "string", "minLength": 1},
    "bindings": {"type": "array"},
    "mutable": {"type": "boolean"},
    "place": {"type": "string", "minLength": 1},
    "callee": {"type": "string", "minLength": 1},
    "generic_arguments": {"type": "array"},
    "tail": {"type": "boolean"},
    "pattern": {"type": ["string", "integer", "boolean", "null", "array", "object"]},
    "reason": {"enum": ["exit", "success", "failure", "cancel"]},
    "binding": {"type": "string", "minLength": 1},
    "abi": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "case": {"type": "string", "minLength": 1},
    "capture_default": {"enum": ["borrow", "move", "exact"]},
    "resume": {"type": "string", "minLength": 1},
    "payload": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resume_type": {"type": "string", "minLength": 1}
  },
  "tree_invariants": [
    "Events are in preorder and sequence equals the zero-based array position.",
    "The root has null parent_id, role, and index; every other event names an earlier parent node.",
    "role is the canonical snake_case normalized-AST field containing the child.",
    "index is null for a singular child and is the zero-based position for an array child.",
    "Within one parent and role, singular children occur at most once and indexed children are contiguous from zero.",
    "Every origin span has start <= end and names the stream source identity; expansion spans are ordered outermost to innermost."
  ],
  "kinds": {
    "module-begin": {"required": ["identity"], "optional": ["profile", "unsafe"]},
    "module-end": {"required": [], "optional": []},
    "function": {"required": ["name", "result", "contract"], "optional": ["visibility", "generics"]},
    "lambda": {"required": ["contract", "capture_default"], "optional": []},
    "yield": {"required": [], "optional": []},
    "break": {"required": [], "optional": []},
    "continue-loop": {"required": [], "optional": []},
    "field-init": {"required": ["name"], "optional": []},
    "member": {"required": ["name"], "optional": []},
    "parameter": {"required": ["name", "type", "ownership"], "optional": []},
    "capture": {"required": ["name", "ownership"], "optional": []},
    "record": {"required": ["name", "representation"], "optional": ["visibility", "generics"]},
    "field": {"required": ["name", "type"], "optional": ["visibility"]},
    "variant": {"required": ["name", "representation"], "optional": ["visibility", "generics"]},
    "case": {"required": ["name", "payload_kind"], "optional": ["payload"]},
    "concept": {"required": ["name"], "optional": ["generics", "modifiers", "evidence_version"]},
    "implementation": {"required": ["type"], "optional": ["concept", "generics"]},
    "constructor": {"required": ["name", "result", "contract"], "optional": []},
    "getter": {"required": ["name", "result", "contract"], "optional": []},
    "setter": {"required": ["name", "contract"], "optional": []},
    "operation": {"required": ["name", "signature"], "optional": ["stable_key", "target"]},
    "associated": {"required": ["name"], "optional": ["value"]},
    "axiom": {"required": ["name"], "optional": []},
    "import": {"required": ["module", "bindings"], "optional": []},
    "export": {"required": ["bindings"], "optional": []},
    "test-suite": {"required": ["name"], "optional": []},
    "test": {"required": ["name"], "optional": []},
    "literal": {"required": ["value"], "optional": ["type"]},
    "binding": {"required": ["name"], "optional": ["mutable", "type"]},
    "read": {"required": ["place"], "optional": []},
    "write": {"required": ["place"], "optional": []},
    "call": {"required": [], "optional": ["callee", "generic_arguments"]},
    "sequence": {"required": [], "optional": []},
    "if": {"required": [], "optional": []},
    "while": {"required": [], "optional": []},
    "match": {"required": ["ownership"], "optional": []},
    "match-arm": {"required": ["pattern"], "optional": []},
    "try": {"required": [], "optional": []},
    "catch": {"required": ["pattern"], "optional": []},
    "throw": {"required": [], "optional": []},
    "rethrow": {"required": [], "optional": []},
    "scope": {"required": [], "optional": []},
    "guard": {"required": ["reason"], "optional": []},
    "mixin": {"required": [], "optional": []},
    "ct-foreach": {"required": ["binding"], "optional": []},
    "unsafe": {"required": [], "optional": []},
    "extern": {"required": ["abi", "name", "signature"], "optional": ["symbol"]},
    "record-construct": {"required": ["type"], "optional": []},
    "variant-construct": {"required": ["type", "case"], "optional": []},
    "return": {"required": [], "optional": []}
  },
  "validation": "For each event, attributes must contain every required key and no key outside required plus optional for that kind."
}
