    {
      "id": "call-needs-only-the-callee-contract",
      "note": "f calls g: f is typed against g's signature; g's body never reaches f.",
      "symbols": {
        "f": {
          "signature": "explicit",
          "requires": [
            {
              "kind": "calls",
              "target": "g"
            }
          ]
        },
        "g": {
          "signature": "explicit",
          "requires": []
        }
      },
      "demands": [
        {
          "symbol": "f",
          "state": "FunctionCertified"
        },
        {
          "symbol": "g",
          "state": "FunctionCertified"
        }
      ],
      "expected": {
        "diagnostics": [],
        "edges": [
          [
            "f",
            "g",
            "contract"
          ]
        ],
        "states": {
          "f": "FunctionCertified",
          "g": "FunctionCertified"
        }
      }
    },
