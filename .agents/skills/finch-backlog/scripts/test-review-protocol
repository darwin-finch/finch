#!/bin/sh
# Advisory checks for Finch's issue/readiness/review documentation.
# This catches missing or harmful prose. It never grants authority, readiness, or approval.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEFAULT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd)
case $# in
    0) ROOT=$DEFAULT_ROOT ;;
    1) ROOT=$1 ;;
    *) printf 'ERROR: usage: %s [repository-root]\n' "$0" >&2; exit 2 ;;
esac

SKILL="$ROOT/.agents/skills/finch-backlog/SKILL.md"
REFS="$ROOT/.agents/skills/finch-backlog/references"
READINESS="$REFS/issue-readiness.md"
REVIEW="$REFS/review-protocol.md"
CONTRACT="$REFS/solution-contract.md"
PACKET="$REFS/task-packet.md"
CLAIMS="$REFS/work-claims.md"
WORKFLOW="$ROOT/.github/workflows/docs.yml"
MANIFEST="$ROOT/scripts/ci_workflow_manifest.json"
checks=0
failures=0

pass() { checks=$((checks + 1)); printf 'ok %s - %s\n' "$checks" "$1"; }
fail() { checks=$((checks + 1)); failures=$((failures + 1)); printf 'not ok %s - %s\n' "$checks" "$1" >&2; }
require_file() { if test -f "$2"; then pass "$1"; else fail "$1: missing $2"; fi; }
require_text() {
    label=$1 needle=$2
    shift 2
    for file do
        if test -f "$file" && grep -F -q -- "$needle" "$file"; then pass "$label"; return; fi
    done
    fail "$label: missing [$needle]"
}
forbid_regex() {
    label=$1 pattern=$2
    shift 2
    for file do
        if test -f "$file" && grep -E -i -q -- "$pattern" "$file"; then fail "$label: harmful rule matched in $file"; return; fi
    done
    pass "$label"
}
reject_fixture() {
    label=$1 pattern=$2 text=$3
    if printf '%s\n' "$text" | grep -E -i -q -- "$pattern"; then pass "$label"; else fail "$label: harmful fixture was accepted"; fi
}

for file in "$SKILL" "$READINESS" "$REVIEW" "$CONTRACT" "$PACKET" "$CLAIMS" "$WORKFLOW" "$MANIFEST"; do
    require_file "required process file exists" "$file"
done

DOCS="$SKILL $READINESS $REVIEW $CONTRACT $PACKET $CLAIMS"
require_text "process is proportional to shipping risk" "Every process step must demonstrably reduce defect risk or improve shipping confidence at a cost proportional to the change" $DOCS
require_text "tooling is advisory" "Tooling is advisory mechanical lint, never an authority engine" $DOCS
require_text "readiness is lightweight" "lightweight readiness check" "$SKILL" "$READINESS"
require_text "small changes use compact contracts" "compact solution contract" "$SKILL" "$CONTRACT"
require_text "reviewers find and help repair" "find-and-help partner" "$SKILL" "$REVIEW"
require_text "finding axes remain independent" "independent axes" "$SKILL" "$REVIEW"
require_text "same-contract findings stay in repair" "same-contract" "$SKILL" "$REVIEW"
require_text "splits require genuine separation" "genuinely separable" "$SKILL" "$REVIEW"
require_text "review uses risk-derived perspectives" "Review the current candidate with risk-derived perspectives" "$SKILL"
require_text "material repairs receive review" "review again after any material repair" "$SKILL"
require_text "review stops at first blocker-free complete round" "first complete round with zero confirmed in-scope blockers" "$SKILL" "$REVIEW"
require_text "extra confidence rounds are excluded" "do not add confidence rounds" "$REVIEW"
require_text "optional items remain follow-ups" "Speculative or optional items are nonblocking follow-ups" "$SKILL" "$REVIEW"
require_text "defective prerequisites stay separate" "separate prerequisite change" "$SKILL" "$REVIEW"
require_text "repeated defects change strategy" "change strategy or narrow the change" "$SKILL" "$REVIEW"
require_text "ordinary trunk flow is direct" "focused patch, relevant affected/integration tests" "$SKILL" "$REVIEW"
require_text "ordinary changes squash merge" "squash merge" "$SKILL" "$REVIEW"
require_text "current main is checked for mergeability" "current main for conflicts and mergeability" "$SKILL" "$REVIEW"
require_text "identity-only rebases are not ritualized" "do not require ritual rebases or review restarts" "$SKILL"
require_text "main regressions fix forward" "fix it forward" "$SKILL" "$REVIEW"
require_text "completion is current-main and visible" "current-main merge and user-visible evidence" "$SKILL" "$READINESS"
require_text "unspecified state is explicit" "UNSPECIFIED" "$READINESS"
require_text "external block state is explicit" "BLOCKED_EXTERNAL" "$READINESS"
require_text "infeasible state is explicit" "INFEASIBLE" "$READINESS"
require_text "declined state is explicit" "DECLINED" "$READINESS"

forbid_regex "count cannot auto-cancel work" '(auto|automatic(ally)?)[- ]*(cancel|close|waive).*(count|severity)|(count|severity).*(auto|automatic(ally)?)[- ]*(cancel|close|waive)' $DOCS
forbid_regex "severity cannot resolve findings" 'severity[^.]*\b(resolves|discharges|waives)\b[^.]*finding' $DOCS
forbid_regex "three-round review churn is absent" '(three|3)[- ]+(review )?rounds|third[- ]round cancellation' $DOCS
forbid_regex "exact-tip ritual terminology is absent" 'exact-tip|exact tip' $DOCS
forbid_regex "review has no universal one-pass cap" 'exactly one (reviewer|review pass)|only one (reviewer|review pass)' $DOCS
forbid_regex "scripts cannot grant READY" '(script|linter|tool)[^.]*(grants|authorizes|declares)[^.]*(READY)' $DOCS
forbid_regex "scripts cannot grant ownership or merge" '(script|linter|tool)[^.]*(grants|authorizes)[^.]*(ownership|merge)' $DOCS
reject_fixture "automatic count cancellation fixture is rejected" '(auto|automatic(ally)?)[- ]*(cancel|close|waive).*(count|severity)|(count|severity).*(auto|automatic(ally)?)[- ]*(cancel|close|waive)' "Automatically cancel review when finding count is high."
reject_fixture "fixed three-round churn fixture is rejected" '(three|3)[- ]+(review )?rounds|third[- ]round cancellation' "Require three review rounds for every patch."
reject_fixture "tool authority fixture is rejected" '(script|linter|tool)[^.]*(grants|authorizes|declares)[^.]*(READY)' "The linter grants READY status."

require_text "v1 claim marker is preserved" "<!-- finch-work-claim:v1" "$CLAIMS"
for field in "event: claim" "claim-id:" "worker:" "github-actor:" "branch:" "worktree:" "base:" "scope:" "timestamp:"; do
    require_text "v1 claim field is preserved: $field" "$field" "$CLAIMS"
done
for field in "event: <release|complete|supersede>" "replacement-claim:" "authority-comment:"; do
    require_text "v1 terminal field is preserved: $field" "$field" "$CLAIMS"
done
require_text "claim conflicts remain procedural" "procedural conflict check" "$CLAIMS"

invocations=$(grep -F -c -- 'run: .agents/skills/finch-backlog/scripts/test-review-protocol "$GITHUB_WORKSPACE"' "$WORKFLOW" || true)
if test "$invocations" = 1; then pass "Documentation runs the advisory linter once"; else fail "Documentation linter invocation expected=1 actual=$invocations"; fi

for owned_path in \
    .agents/skills/finch-backlog/SKILL.md \
    .agents/skills/finch-backlog/references/review-protocol.md \
    .agents/skills/finch-backlog/references/solution-contract.md \
    .agents/skills/finch-backlog/references/issue-readiness.md \
    .agents/skills/finch-backlog/references/task-packet.md \
    .agents/skills/finch-backlog/references/work-claims.md \
    .agents/skills/finch-backlog/scripts/test-review-protocol \
    .github/workflows/docs.yml \
    scripts/ci_workflow_manifest.json
do
    occurrences=$(grep -F -c -- "\"$owned_path\"" "$WORKFLOW" || true)
    if test "$occurrences" = 2; then pass "Documentation watches $owned_path on pull and push"; else fail "Documentation path occurrences expected=2 actual=$occurrences path=$owned_path"; fi
done

if test "$failures" -ne 0; then
    printf 'FAILED: %s of %s advisory documentation checks failed\n' "$failures" "$checks" >&2
    exit 1
fi
printf 'PASS: %s advisory documentation checks; no authority decisions made\n' "$checks"
