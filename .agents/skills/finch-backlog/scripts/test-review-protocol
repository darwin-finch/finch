raw_claim, claim_error = wp.admit_claim(raw_claim, 406)
check(not claim_error and raw_claim["active"], "documented claim block did not enter typed claim state")

def evidence_raw(kind, fields, url, comment_id, created_at, issue=406):
    lines = ["<!-- finch-workflow-evidence:v1", f"packet-id: {url}", f"issue: {issue}", f"kind: {kind}"]
    lines.extend(f"{key.replace('_','-')}: {str(value).lower() if isinstance(value, bool) else value}" for key, value in fields.items())
    lines.extend([f"timestamp: {created_at}", "-->"])
    return parsed_block("\n".join(lines), url, comment_id, "alice", created_at, issue=issue)

ready_evidence = evidence_raw("approved-contract", {}, "ready-evidence", 20, "2026-01-04T00:00:00Z")
progress_evidence = evidence_raw("active-claim", {}, "progress-evidence", 21, "2026-01-05T00:00:00Z")
merge_evidence = evidence_raw("merge-ready", {"gate_evidence":True, "artifact_evidence":True},
                              "merge-evidence", 22, "2026-01-06T00:00:00Z")
complete_fields = {name:True for name in ("merged_current_main", "all_successors_resolved", "issue_closed",
    "claim_terminal", "artifact_identity", "user_visible_proof", "cleanup_safe", "frontier_recomputed")}
complete_evidence = evidence_raw("complete", complete_fields, "complete-evidence", 23, "2026-01-07T00:00:00Z")

def readiness_raw(event_id, prior_id, prior_state, new_state, evidence, comment_id, created_at,
                  claim_url="claim-url", issue=406, identity_overrides=None):
    identity_overrides = identity_overrides or {}
    event_contract = identity_overrides.get("contract_id", "contract")
    event_claim = identity_overrides.get("claim_id", "claim")
    event_ledger = identity_overrides.get("ledger_id", "ledger")
    event_round = identity_overrides.get("round_id", "round")
    event_tip = identity_overrides.get("exact_tip", tip_sha)
    return parsed_block(f"""<!-- finch-issue-readiness:v1
event-id: {event_id}
issue: {issue}
prior-state: {prior_state or 'none'}
prior-event-id: {prior_id or 'none'}
new-state: {new_state}
actor: coordinator-worker
owner: alice
evidence-url: {evidence['url']}
evidence-kind: {evidence['kind']}
evidence-digest: {evidence['body_digest']}
contract-id: {event_contract}
contract-url: contract-url
contract-digest: {raw_contract['body_digest']}
contract-revision: 11
implementation-base: {base_sha}
plan-reviewer: reviewer-worker
approval-url: approval-url
claim-id: {event_claim}
claim-url: {claim_url}
ledger-id: {event_ledger}
round-id: {event_round}
exact-tip: {event_tip}
integration-base: {base_sha}
next-action: continue
authority-comment: none
timestamp: {created_at}
-->""", f"{event_id}-url", comment_id, "alice", created_at, issue=issue)

ready_event = readiness_raw("ready", None, None, "READY", ready_evidence, 30, "2026-01-08T00:00:00Z")
progress_event = readiness_raw("progress", "ready", "READY", "IN_PROGRESS", progress_evidence, 31, "2026-01-09T00:00:00Z")

round_raw = f"""<!-- finch-review-round:v1
