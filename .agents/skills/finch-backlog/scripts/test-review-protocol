#!/bin/sh
# Compact policy/contradiction linter for Finch issue #406 / PR #542.
# This script is not ownership, authentication, readiness, merge, or completion authority.
# It checks repository text and disposable examples; accountable people verify real evidence.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEFAULT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd)
SELF="$SCRIPT_DIR/test-review-protocol"

# Usage: test-review-protocol [repository-root]
# An explicit positional root is authoritative. With no argument, the documented
# FINCH_PROTOCOL_ROOT override is used, otherwise the script's repository is used.
case $# in
    0) ROOT=${FINCH_PROTOCOL_ROOT:-$DEFAULT_ROOT} ;;
    1) ROOT=$1 ;;
    *)
        printf 'ERROR: usage: %s [repository-root]; got %s arguments\n' "$0" "$#" >&2
        exit 2
        ;;
esac

if test -d "$ROOT"; then
    ROOT=$(CDPATH= cd -- "$ROOT" && pwd)
fi

if test ! -f "$ROOT/.agents/skills/finch-backlog/SKILL.md"; then
    printf 'ERROR: repository root missing required policy file: %s\n' \
        "$ROOT/.agents/skills/finch-backlog/SKILL.md" >&2
    exit 2
fi

SKILL="$ROOT/.agents/skills/finch-backlog/SKILL.md"
REFS="$ROOT/.agents/skills/finch-backlog/references"
REVIEW="$REFS/review-protocol.md"
CONTRACT="$REFS/solution-contract.md"
READINESS="$REFS/issue-readiness.md"
PACKET="$REFS/task-packet.md"
CLAIMS="$REFS/work-claims.md"
WORKFLOW="$ROOT/.github/workflows/docs.yml"
REDUCER="$ROOT/.agents/skills/finch-backlog/scripts/workflow_protocol.py"
TMP=${TMPDIR:-/tmp}/finch-review-protocol.$$
trap 'rm -rf "$TMP"' EXIT HUP INT TERM
mkdir -p "$TMP"

checks=0
failures=0

# Round-one ledger proof map (the immutable PR comment remains authoritative):
# C542-COR-001 -> append-only finding fixtures below.
# C542-COR-002 -> new-debt and post-pass convergence fixtures.
# C542-COR-003 -> SUPERSEDED parent closure fixtures.
# C542-COMPAT-001 -> malformed-attempt recovery and fresh-reuse fixtures.
# F406-PF-001 -> canonical v1 blocks and immutable-observation fixtures.
# F542-TQ-001 -> complete P542/R3 records and affirmative-authority negatives.
# F542-TQ-002 -> isolated recursive successor graph negatives.
# F542-TQ-003 -> one-omission production-admission negatives.
# F542-TQ-004 -> one-predicate convergence negatives.
# F542-TQ-005 -> severity/count classification matrix.
# F542-TQ-006 -> authority cardinality/value fixtures.
# F542-TQ-007 -> ordered-completion diagnostics.
# F542-TQ-008 -> independent issue-543 state fixtures.

pass() {
    checks=$((checks + 1))
    printf 'ok %s - %s\n' "$checks" "$1"
}

fail() {
    checks=$((checks + 1))
    failures=$((failures + 1))
    printf 'not ok %s - %s\n' "$checks" "$1" >&2
}

require_file() {
    label=$1
    path=$2
    if test -f "$path"; then
        pass "$label"
    else
        fail "$label: required file missing: $path"
    fi
}

require_text() {
    label=$1
    needle=$2
    shift 2
    found=false
    for path in "$@"; do
        if test -f "$path" && grep -F -q -- "$needle" "$path"; then
            found=true
            break
        fi
    done
    if "$found"; then
        pass "$label"
    else
        fail "$label: missing required text [$needle] in $*"
    fi
}

forbid_text() {
    label=$1
    needle=$2
    shift 2
    hits="$TMP/hits"
    : >"$hits"
    for path in "$@"; do
        if test -f "$path"; then
            grep -F -n -- "$needle" "$path" >>"$hits" || true
        fi
    done
    if test -s "$hits"; then
        fail "$label: forbidden authority claim [$needle] found: $(tr '\n' ';' <"$hits")"
    else
        pass "$label"
    fi
}

forbid_regex() {
    label=$1
    pattern=$2
    shift 2
    hits="$TMP/regex-hits"
    : >"$hits"
    for path in "$@"; do
        if test -f "$path"; then
            grep -E -i -n -- "$pattern" "$path" >>"$hits" || true
        fi
    done
    if test -s "$hits"; then
        fail "$label: contradictory authority text matched [$pattern]: $(tr '\n' ';' <"$hits")"
    else
        pass "$label"
    fi
}

expect_reject() {
    label=$1
    diagnostic=$2
    shift 2
    err="$TMP/reject.$checks"
    if "$@" 2>"$err"; then
        fail "$label: invalid fixture was accepted"
    elif grep -F -q -- "$diagnostic" "$err"; then
        pass "$label: $(tr '\n' ';' <"$err")"
    else
        fail "$label: expected diagnostic [$diagnostic], got [$(tr '\n' ';' <"$err")]"
    fi
}

# Prove that the positional repository-root argument is not silently ignored. The
# guard prevents recursion while the child checks a deliberately empty root.
if test "${FINCH_PROTOCOL_ROOT_SELFTEST:-run}" = run; then
    wrong_root="$TMP/explicit-wrong-root"
    mkdir -p "$wrong_root"
    wrong_root=$(CDPATH= cd -- "$wrong_root" && pwd)
    if FINCH_PROTOCOL_ROOT_SELFTEST=skip "$SELF" "$wrong_root" >"$TMP/root-argument.out" 2>&1; then
        fail "explicit repository-root argument was ignored; empty root unexpectedly passed"
    elif grep -F -q \
        "repository root missing required policy file: $wrong_root/.agents/skills/finch-backlog/SKILL.md" \
        "$TMP/root-argument.out"; then
        pass "explicit repository-root argument is honored and a wrong root fails actionably"
    else
        fail "wrong-root diagnostic did not name the supplied root: $(tr '\n' ';' <"$TMP/root-argument.out")"
    fi
fi

DOCS="$SKILL $REVIEW $CONTRACT $READINESS $PACKET $CLAIMS"
for path in $DOCS; do
    require_file "policy file exists" "$path"
done

if test "$failures" -ne 0; then
    printf 'FAILED: %s required policy file checks failed for supplied root %s\n' \
        "$failures" "$ROOT" >&2
    exit 1
fi

if test ! -e "$REDUCER"; then
    pass "obsolete workflow_protocol.py is deleted"
else
    fail "obsolete workflow_protocol.py still exists at $REDUCER"
fi

# P542-01 through P542-17 must occur once each, in order, in the contract.
ids="$TMP/p542.ids"
sed -n 's/^- `\(P542-[0-9][0-9]\)`:.*$/\1/p' "$CONTRACT" >"$ids"
expected="$TMP/p542.expected"
n=1
: >"$expected"
while test "$n" -le 17; do
    printf 'P542-%02d\n' "$n" >>"$expected"
    n=$((n + 1))
done
if cmp -s "$expected" "$ids"; then
    pass "P542-01 through P542-17 are complete, unique, and ordered"
else
    fail "P542 mapping mismatch; expected $(tr '\n' ' ' <"$expected") got $(tr '\n' ' ' <"$ids")"
fi

# Compare the normative gates as complete records. Presence-only checks would accept a
# contradictory suffix that reverses the rule while retaining the expected substring.
p542_records="$TMP/p542.records"
grep -E '^- `P542-[0-9][0-9]`:' "$CONTRACT" >"$p542_records" || true
p542_canonical="$TMP/p542.canonical"
printf '%s\n' \
'- `P542-01`: issue readiness, candidate correction, and finding attributes are distinct concepts.' \
'- `P542-02`: procedural READY requires an immutable solution contract and fresh independent approval before any production branch, worktree, claim, mutation, or implementation. The coordinator records the checklist decision; no status script grants authority.' \
'- `P542-03`: reviewers are find-and-help partners; every confirmed finding includes a stable ID, concrete failure, smallest credible correction vector, deterministic proof, affected invariant, and contract-fit assessment.' \
'- `P542-04`: confidence, severity, locality, obligation, and lifecycle axes remain independent; immutable finding creation and successor dispositions preserve append-only axis history.' \
'- `P542-05`: severity and finding count prioritize work but never cancel, close, waive, resolve, reject, or automatically split it.' \
'- `P542-06`: confirmed same-contract blockers and required regression debt stay in bounded repair; only causally separable concerns become owned independent follow-ups.' \
'- `P542-07`: replacement and split records do not discharge obligations. Every original acceptance gate keeps exactly one current owner and proof path until its leaf is merged and proven. This is an accounting discipline checked by reviewers/coordinator, not a reducer-derived fact.' \
'- `P542-08`: when the same stable blocker survives two competent repair attempts, end the implementation epoch, run one bounded independent diagnosis/prototype, and change strategy, representation, contract, assignment, or executable split. Agent failure never proves infeasibility.' \
'- `P542-09`: review converges only when the transitive same-contract blocker/regression ledger is zero, exactly one fresh independent clean exact-tip pass finds no new confirmed same-contract blocker or required regression debt, and the post-pass ledger recheck remains zero. Do not keep reviewing that frozen blocker-free tip.' \
'- `P542-10`: task packets explicitly name edit, prototype, external action, push, merge, issue closure, terminal-event, and cleanup authority.' \
'- `P542-11`: outcome completion requires current-main merge, every accepted gate, ticket closure, current artifact/user-visible proof, valid claim terminal, safe cleanup, and frontier recomputation.' \
'- `P542-12`: a narrowed PR slice may merge while a broader parent remains open for concretely owned successors; PR integration and outcome completion are distinct.' \
'- `P542-13`: `finch-work-claim:v1` remains the sole mutation-ownership authority. There is no deferred cutover.' \
'- `P542-14`: obvious isolated fixes use compact contracts and one fresh plan reviewer; additional perspectives are derived only from actual diff risk.' \
'- `P542-15`: reviewer/discovery prototypes use an isolated disposable worktree/copy at the frozen tip and never mutate the implementation worktree, push, read credentials, perform undeclared external effects, merge/cherry-pick, or retain production commits.' \
'- `P542-16`: a required unavailable reviewer is recorded `UNAVAILABLE` with reason and gets at most one bounded fresh-context fallback; failure leaves the gate unresolved unless the repository owner explicitly accepts the named risk.' \
'- `P542-17`: pre-cutover wording is removed. Any scope expansion requires a revised immutable approved contract, a complete repository-wide v1 collision check, and an issuer-authorized whole-claim replacement covering the new scope before edits, followed by another collision check.' >"$p542_canonical"
if cmp -s "$p542_canonical" "$p542_records"; then
    pass "all P542 normative records exactly match the reviewed canonical contract"
else
    fail "P542 canonical records changed; expected $(tr '\n' '|' <"$p542_canonical") got $(tr '\n' '|' <"$p542_records")"
fi

require_text "P542-01 keeps concepts distinct" "issue readiness, candidate correction, and finding attributes are distinct concepts" "$CONTRACT"
require_text "P542-02 rejects pre-READY production work" "before any production branch, worktree, claim, mutation, or implementation" "$CONTRACT"
require_text "P542-03 makes reviewers find-and-help partners" "reviewers are find-and-help partners" "$CONTRACT"
require_text "P542-04 preserves five independent axes" "confidence, severity, locality, obligation, and lifecycle axes remain independent" "$CONTRACT"
require_text "P542-05 makes count/severity non-dispositive" "never cancel, close, waive, resolve, reject, or automatically split" "$CONTRACT"
require_text "P542-06 keeps same-contract repair bounded" "confirmed same-contract blockers and required regression debt stay in bounded repair" "$CONTRACT"
require_text "P542-07 keeps successor obligations open" "replacement and split records do not discharge obligations" "$CONTRACT"
require_text "P542-08 changes strategy after two attempts" "survives two competent repair attempts" "$CONTRACT"
require_text "P542-09 defines finite convergence" "exactly one fresh independent clean exact-tip pass" "$CONTRACT"
require_text "P542-10 enumerates task authority" "edit, prototype, external action, push, merge, issue closure, terminal-event, and cleanup authority" "$CONTRACT"
require_text "P542-11 requires accounted current-main completion" "current-main merge, every accepted gate, ticket closure" "$CONTRACT"
require_text "P542-12 separates slice integration from outcome" "PR integration and outcome completion are distinct" "$CONTRACT"
require_text "P542-13 retains v1 ownership authority" 'finch-work-claim:v1` remains the sole mutation-ownership authority' "$CONTRACT"
require_text "P542-14 keeps simple contracts proportional" "obvious isolated fixes use compact contracts and one fresh plan reviewer" "$CONTRACT"
require_text "P542-15 isolates disposable prototypes" "isolated disposable worktree/copy at the frozen tip" "$CONTRACT"
require_text "P542-16 bounds unavailable-reviewer fallback" "at most one bounded fresh-context fallback" "$CONTRACT"
require_text "P542-17 requires whole-claim replacement" "issuer-authorized whole-claim replacement covering the new scope" "$CONTRACT"

# False-authority mechanisms from the frozen implementation must not survive.
forbid_text "no canonical reducer authority" "canonical reducer" $DOCS
forbid_text "no machine admission verdict" "approval is admitted only" $DOCS
forbid_text "no caller prepared-proof authority" "prepared_proof_authorizes" $DOCS
forbid_text "no workflow evidence schema" "finch-workflow-evidence:v1" $DOCS
forbid_text "no readiness event schema" "finch-issue-readiness:v1" $DOCS
forbid_text "no proxy authority mechanism" "A proxy must have" $DOCS
forbid_text "no legacy bootstrap mechanism" "### Legacy bootstrap" $DOCS
forbid_text "no atomic handoff mechanism" "atomic handoff activation" $DOCS
forbid_text "no machine-derived completion" "reducer owns" $DOCS
forbid_text "no count cancellation rule" "strictly better on both counts" $DOCS
forbid_text "no fixed-round cancellation" "round N of at most" $DOCS
require_text "linter disclaims ownership authority" "not ownership, authentication" "$0"
require_text "procedure rejects tool-granted READY" 'no script, label, reducer, or status report grants `READY`' "$SKILL"
require_text "v1 claim block retains base field" "base: <full commit SHA>" "$CLAIMS"
require_text "claims remain sole authority" "sole authoritative cross-tool" "$CLAIMS"
require_text "transfer is serialized, not atomic" "do not claim atomic transfer" "$CLAIMS"
require_text "claim evidence names SHA-256" "SHA-256 of the exact raw body" "$CLAIMS"
require_text "REST edit predicate is exact" 'REST `updatedAt == createdAt`' "$CLAIMS"
require_text "GraphQL edit predicate is exact" 'GraphQL `lastEditedAt == null`' "$CLAIMS"

# The two v1 HTML comment blocks remain byte-compatible and field ordered.
awk -v out="$TMP" '
  /<!-- finch-work-claim:v1/ { block++; capture=1 }
  capture { print > (out "/claim-block." block) }
  capture && /^-->$/ { capture=0 }
' "$CLAIMS"
printf '%s\n' \
'<!-- finch-work-claim:v1' \
'event: claim' \
'claim-id: <globally unique stable id>' \
'worker: <tool/person and stable session or agent identity>' \
'github-actor: <responsible @user or none>' \
'branch: <remote branch>' \
'worktree: <absolute path or remote environment id>' \
'base: <full commit SHA>' \
'scope: <single-line bounded scope>' \
'timestamp: <UTC RFC 3339>' \
'-->' >"$TMP/claim-block.expected"
printf '%s\n' \
'<!-- finch-work-claim:v1' \
'event: <release|complete|supersede>' \
'claim-id: <the original claim id>' \
'worker: <the exact worker value from the original claim>' \
'timestamp: <UTC RFC 3339>' \
'replacement-claim: <claim id or none>' \
'authority-comment: <none or immutable prior GitHub comment URL>' \
'-->' >"$TMP/terminal-block.expected"
if cmp -s "$TMP/claim-block.expected" "$TMP/claim-block.1"; then
    pass "v1 claim template fields and wrappers remain byte-compatible and ordered"
else
    fail "v1 claim template mismatch; expected [$(tr '\n' ';' <"$TMP/claim-block.expected")] actual [$(tr '\n' ';' <"$TMP/claim-block.1")]"
fi
if cmp -s "$TMP/terminal-block.expected" "$TMP/claim-block.2"; then
    pass "v1 terminal template fields and wrappers remain byte-compatible and ordered"
else
    fail "v1 terminal template mismatch; expected [$(tr '\n' ';' <"$TMP/terminal-block.expected")] actual [$(tr '\n' ';' <"$TMP/claim-block.2")]"
fi

claim_block_ok() {
    expected_block=$1
    actual_block=$2
    if cmp -s "$expected_block" "$actual_block"; then
        return 0
    fi
    printf 'claim block mismatch expected=[%s] actual=[%s]\n' \
        "$(tr '\n' ';' <"$expected_block")" "$(tr '\n' ';' <"$actual_block")" >&2
    return 1
}
sed '1s/<!-- finch-work-claim:v1/<!-- finch-work-claim:v2/' "$TMP/claim-block.expected" >"$TMP/claim-block.bad-wrapper"
expect_reject "changed claim wrapper is rejected" "claim block mismatch" claim_block_ok "$TMP/claim-block.expected" "$TMP/claim-block.bad-wrapper"
sed 's/^base:/based:/' "$TMP/claim-block.expected" >"$TMP/claim-block.bad-name"
expect_reject "changed claim field name is rejected" "claim block mismatch" claim_block_ok "$TMP/claim-block.expected" "$TMP/claim-block.bad-name"
grep -v '^scope:' "$TMP/claim-block.expected" >"$TMP/claim-block.omitted"
expect_reject "omitted claim field is rejected" "claim block mismatch" claim_block_ok "$TMP/claim-block.expected" "$TMP/claim-block.omitted"
awk '{ print; if ($0 ~ /^worker:/) print }' "$TMP/claim-block.expected" >"$TMP/claim-block.duplicate"
expect_reject "duplicate claim field is rejected" "claim block mismatch" claim_block_ok "$TMP/claim-block.expected" "$TMP/claim-block.duplicate"
sed 's/^replacement-claim:/replacement_claim:/' "$TMP/terminal-block.expected" >"$TMP/terminal-block.bad-name"
expect_reject "changed terminal field name is rejected" "claim block mismatch" claim_block_ok "$TMP/terminal-block.expected" "$TMP/terminal-block.bad-name"

immutability_evidence_ok() {
    algorithm=$1 digest=$2 rest_created=$3 rest_updated=$4 graphql_edited=$5
    if test "$algorithm" != SHA-256; then
        printf 'body digest algorithm expected=SHA-256 actual=%s\n' "$algorithm" >&2; return 1
    fi
    if test -z "$digest"; then
        printf 'body SHA-256 digest must be nonempty\n' >&2; return 1
    fi
    if test "$rest_updated" != "$rest_created"; then
        printf 'REST immutability expected updatedAt==createdAt actual=%s!=%s\n' "$rest_updated" "$rest_created" >&2; return 1
    fi
    if test "$graphql_edited" != null; then
        printf 'GraphQL immutability expected lastEditedAt=null actual=%s\n' "$graphql_edited" >&2; return 1
    fi
}
if immutability_evidence_ok SHA-256 abc 2026-09-10T00:00:00Z 2026-09-10T00:00:00Z null; then
    pass "SHA-256 plus REST and GraphQL predicates prove an unedited observation"
else
    fail "valid immutable observation was rejected"
fi
expect_reject "non-SHA-256 body digest is rejected" "algorithm expected=SHA-256" immutability_evidence_ok SHA-1 abc t t null
expect_reject "empty body digest is rejected" "digest must be nonempty" immutability_evidence_ok SHA-256 '' t t null
expect_reject "REST-edited event is rejected" "updatedAt==createdAt" immutability_evidence_ok SHA-256 abc t later null
expect_reject "GraphQL-edited event is rejected" "lastEditedAt=null" immutability_evidence_ok SHA-256 abc t t later

# Malformed comments never gain terminal semantics. Recovery only proves cessation and preserves
# evidence; a fresh ready/branch/worktree/claim/scan sequence owns any later reuse.
malformed_resolved() {
    author=$1 attestation=$2 comment_url=$3 comment_id=$4 digest=$5 worker=$6 pr=$7 session=$8 preservation=$9 requested_state=${10}
    if test "$author" != original-author; then printf 'cessation author expected=original-author actual=%s\n' "$author" >&2; return 1; fi
    if test "$attestation" != UNEDITED; then printf 'cessation attestation expected=UNEDITED actual=%s\n' "$attestation" >&2; return 1; fi
    case "$comment_id" in ''|0|*[!0-9]*) printf 'cessation comment ID expected=positive-decimal actual=%s\n' "$comment_id" >&2; return 1 ;; esac
    if ! printf '%s\n' "$comment_url" | grep -E -q '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$'; then
        printf 'cessation URL expected=canonical-github-issue-comment actual=%s\n' "$comment_url" >&2; return 1
    fi
    url_id=${comment_url##*#issuecomment-}
    if test "$url_id" != "$comment_id"; then printf 'cessation URL/ID mismatch expected=%s actual=%s\n' "$comment_id" "$url_id" >&2; return 1; fi
    digest_hex=${digest#sha256:}
    if test "$digest_hex" = "$digest" || test "${#digest_hex}" -ne 64 || printf '%s' "$digest_hex" | grep -q '[^0-9a-f]'; then
        printf 'cessation body digest expected=sha256:64-lowercase-hex actual=%s\n' "$digest" >&2; return 1
    fi
    if test "$worker" != stopped || test "$pr" != nonmutating || test "$session" != stopped; then
        printf 'liveness unresolved worker=%s pr=%s session=%s\n' "$worker" "$pr" "$session" >&2; return 1
    fi
    if test "$preservation" != preserved; then printf 'valuable work preservation expected=preserved actual=%s\n' "$preservation" >&2; return 1; fi
    if test "$requested_state" != RESOLVED_MALFORMED_NO_OWNER; then
        printf 'malformed attempt diagnostic state expected=RESOLVED_MALFORMED_NO_OWNER actual=%s\n' "$requested_state" >&2; return 1
    fi
}
malformed_digest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
malformed_url=https://github.com/darwin-finch/finch/issues/406#issuecomment-42
if malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER; then
    pass "original-author cessation, liveness and preservation resolve malformed attempt without ownership"
else
    fail "valid malformed-attempt cessation evidence rejected"
fi
expect_reject "wrong malformed-comment author cannot attest cessation" "author expected=original-author" malformed_resolved other UNEDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "edited cessation attestation is rejected" "attestation expected=UNEDITED" malformed_resolved original-author EDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "nonnumeric malformed-comment ID is rejected" "ID expected=positive-decimal" malformed_resolved original-author UNEDITED "$malformed_url" nope "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "non-comment recovery URL is rejected" "URL expected=canonical-github-issue-comment" malformed_resolved original-author UNEDITED https://github.com/darwin-finch/finch/issues/406 42 "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "recovery URL fragment must agree with comment ID" "URL/ID mismatch" malformed_resolved original-author UNEDITED https://github.com/darwin-finch/finch/issues/406#issuecomment-43 42 "$malformed_digest" stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "nonhex recovery digest is rejected" "digest expected=sha256:64-lowercase-hex" malformed_resolved original-author UNEDITED "$malformed_url" 42 sha256:gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "wrong-width recovery digest is rejected" "digest expected=sha256:64-lowercase-hex" malformed_resolved original-author UNEDITED "$malformed_url" 42 sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa stopped nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "live worker keeps malformed attempt blocking" "liveness unresolved" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" running nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "unknown worker keeps malformed attempt blocking" "liveness unresolved" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" unknown nonmutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "mutating PR keeps malformed attempt blocking" "liveness unresolved" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" stopped mutating stopped preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "live session keeps malformed attempt blocking" "liveness unresolved" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating live preserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "unpreserved unique work keeps malformed attempt blocking" "preservation expected=preserved" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating stopped unpreserved RESOLVED_MALFORMED_NO_OWNER
expect_reject "guessed v1 terminal cannot resolve malformed comment" "diagnostic state expected=RESOLVED_MALFORMED_NO_OWNER" malformed_resolved original-author UNEDITED "$malformed_url" 42 "$malformed_digest" stopped nonmutating stopped preserved complete

malformed_reuse_allowed() {
    test "$1" = RESOLVED_MALFORMED_NO_OWNER && test "$2" = READY && test "$3" = new-branch &&
        test "$4" = new-worktree && test "$5" = valid-v1 && test "$6" = complete-clear && test "$7" = complete-clear
}
if malformed_reuse_allowed RESOLVED_MALFORMED_NO_OWNER READY new-branch new-worktree valid-v1 complete-clear complete-clear; then
    pass "malformed-scope reuse requires fresh READY, branch, worktree, valid claim and two scans"
else
    fail "valid fresh ownership sequence after malformed recovery was rejected"
fi
reuse_must_be_allowed() {
    malformed_reuse_allowed "$@" || { printf 'fresh malformed-scope reuse prerequisites rejected: %s\n' "$*" >&2; return 1; }
}
expect_reject "missing fresh valid claim prevents malformed-scope reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER READY new-branch new-worktree missing complete-clear complete-clear
expect_reject "unresolved malformed attempt prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed BLOCKING READY new-branch new-worktree valid-v1 complete-clear complete-clear
expect_reject "missing fresh READY decision prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER DRAFT new-branch new-worktree valid-v1 complete-clear complete-clear
expect_reject "reusing the old branch prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER READY old-branch new-worktree valid-v1 complete-clear complete-clear
expect_reject "reusing the old worktree prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER READY new-branch old-worktree valid-v1 complete-clear complete-clear
expect_reject "missing pre-claim collision scan prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER READY new-branch new-worktree valid-v1 missing complete-clear
expect_reject "missing post-claim collision scan prevents reuse" "reuse prerequisites rejected" reuse_must_be_allowed RESOLVED_MALFORMED_NO_OWNER READY new-branch new-worktree valid-v1 complete-clear missing
require_text "claim immutability names SHA-256" "SHA-256 of the exact raw body" "$CLAIMS"
require_text "REST immutability predicate is explicit" 'REST `updatedAt == createdAt`' "$CLAIMS"
require_text "GraphQL immutability predicate is explicit" 'GraphQL `lastEditedAt == null`' "$CLAIMS"
require_text "malformed attempt never becomes a claim" "A malformed comment never becomes a claim" "$CLAIMS"
require_text "malformed recovery is diagnostic only" '`RESOLVED_MALFORMED_NO_OWNER` is diagnostic only' "$CLAIMS"

# Whole-claim replacement is serialized; the reference in the old terminal never activates the
# reserved replacement identity and no mutation is permitted during the no-owner interval.
replacement_sequence_ok() {
    reserved=$1 first=$2 terminal_uuid=$3 old_scan=$4 gap_mutation=$5 second=$6 new_uuid=$7 new_verified=$8 post_scan=$9
    if test "$reserved" = none || test -z "$reserved"; then printf 'replacement UUID must be reserved before events actual=%s\n' "$reserved" >&2; return 1; fi
    if test "$first" != old-supersede; then printf 'replacement first event expected=old-supersede actual=%s\n' "$first" >&2; return 1; fi
    if test "$terminal_uuid" != "$reserved"; then printf 'terminal replacement UUID mismatch expected=%s actual=%s\n' "$reserved" "$terminal_uuid" >&2; return 1; fi
    if test "$old_scan" != old-inactive; then printf 'pre-claim scan expected=old-inactive actual=%s\n' "$old_scan" >&2; return 1; fi
    if test "$gap_mutation" != none; then printf 'no-owner interval mutation expected=none actual=%s\n' "$gap_mutation" >&2; return 1; fi
    if test "$second" != ordinary-claim; then printf 'replacement second event expected=ordinary-claim actual=%s\n' "$second" >&2; return 1; fi
    if test "$new_uuid" != "$reserved"; then printf 'new claim UUID mismatch expected=%s actual=%s\n' "$reserved" "$new_uuid" >&2; return 1; fi
    if test "$new_verified" != verified; then printf 'ordinary replacement claim verification expected=verified actual=%s\n' "$new_verified" >&2; return 1; fi
    if test "$post_scan" != complete-clear; then printf 'post-claim collision scan expected=complete-clear actual=%s\n' "$post_scan" >&2; return 1; fi
}
replacement_uuid=11111111-1111-4111-8111-111111111111
if replacement_sequence_ok "$replacement_uuid" old-supersede "$replacement_uuid" old-inactive none ordinary-claim "$replacement_uuid" verified complete-clear; then
    pass "whole-claim replacement uses old-terminal, scan, ordinary claim, verification, scan"
else
    fail "valid serialized whole-claim replacement was rejected"
fi
expect_reject "new-claim-first replacement is a collision" "first event expected=old-supersede" replacement_sequence_ok "$replacement_uuid" ordinary-claim "$replacement_uuid" old-inactive none old-supersede "$replacement_uuid" verified complete-clear
expect_reject "terminal replacement reference does not activate claim" "ordinary replacement claim verification expected=verified" replacement_sequence_ok "$replacement_uuid" old-supersede "$replacement_uuid" old-inactive none ordinary-claim "$replacement_uuid" referenced-only complete-clear
expect_reject "replacement UUID mismatch is rejected" "terminal replacement UUID mismatch" replacement_sequence_ok "$replacement_uuid" old-supersede 22222222-2222-4222-8222-222222222222 old-inactive none ordinary-claim "$replacement_uuid" verified complete-clear
expect_reject "mutation in no-owner interval is rejected" "no-owner interval mutation expected=none" replacement_sequence_ok "$replacement_uuid" old-supersede "$replacement_uuid" old-inactive edit ordinary-claim "$replacement_uuid" verified complete-clear
expect_reject "missing old-inactive scan is rejected" "pre-claim scan expected=old-inactive" replacement_sequence_ok "$replacement_uuid" old-supersede "$replacement_uuid" missing none ordinary-claim "$replacement_uuid" verified complete-clear
expect_reject "missing post-claim scan is rejected" "post-claim collision scan expected=complete-clear" replacement_sequence_ok "$replacement_uuid" old-supersede "$replacement_uuid" old-inactive none ordinary-claim "$replacement_uuid" verified missing
require_text "claim policy reserves replacement UUID first" "reserve one unused lowercase replacement UUID" "$CLAIMS"
require_text "claim policy forbids no-owner mutation" "during this no-owner interval, perform no production mutation" "$CLAIMS"
require_text "claim policy says terminal reference is nonactivating" "replacement reference never activates" "$CLAIMS"

# F406-R3-001 through F406-R3-007 require explicit deletion/replacement dispositions.
fids="$TMP/findings.ids"
sed -n 's/^- `\(F406-R3-00[1-7]\)`:.*$/\1/p' "$REVIEW" >"$fids"
if test "$(wc -l <"$fids" | tr -d ' ')" = 7 && test "$(sort -u "$fids" | wc -l | tr -d ' ')" = 7; then
    pass "F406-R3-001 through F406-R3-007 each have one disposition"
else
    fail "round-three dispositions incomplete or duplicated: $(tr '\n' ' ' <"$fids")"
fi
require_text "R3-001 removes machine admission" "remove machine admission of contract approvals" "$REVIEW"
require_text "R3-002 removes caller booleans" "remove caller booleans and prepared-proof inputs" "$REVIEW"
require_text "R3-003 retains issuer/worker checks" "retain v1 issuer, worker, and immutability" "$REVIEW"
require_text "R3-004 uses serialized handoff" "use serialized no-overlap transfer" "$REVIEW"
require_text "R3-005 prevents successor discharge" "successors discharge" "$REVIEW"
require_text "R3-006 removes evidence-derived convergence" "remove evidence-derived convergence" "$REVIEW"
require_text "R3-007 removes proxy/bootstrap/cutover" "remove proxy, legacy-bootstrap, and cutover mechanisms" "$REVIEW"

r3_records="$TMP/r3.records"
awk '
  /^- `F406-R3-00[1-7]`:/ { if (record != "") print record; record=$0; next }
  record != "" && /^  / { sub(/^  */, " "); record=record $0; next }
  record != "" { print record; record="" }
  END { if (record != "") print record }
' "$REVIEW" >"$r3_records"
r3_canonical="$TMP/r3.canonical"
printf '%s\n' \
'- `F406-R3-001`: remove machine admission of contract approvals; retain literal immutable contract identity and independent procedural verification.' \
'- `F406-R3-002`: remove caller booleans and prepared-proof inputs that purported to authorize readiness or supersession; use the reviewed readiness checklist.' \
'- `F406-R3-003`: remove terminal pairing automation; retain v1 issuer, worker, and immutability verification in the existing claim procedure.' \
'- `F406-R3-004`: remove purported atomic handoff; use serialized no-overlap transfer.' \
'- `F406-R3-005`: do not let wrong, edited, duplicate, or merely linked successors discharge gates; require exhaustive ownership and proof through current-main leaves.' \
'- `F406-R3-006`: remove evidence-derived convergence; use recorded exact-tip review and tests.' \
'- `F406-R3-007`: remove proxy, legacy-bootstrap, and cutover mechanisms that trusted invented identities. Any future authenticated audit service is separate approved product work.' >"$r3_canonical"
if cmp -s "$r3_canonical" "$r3_records"; then
    pass "F406-R3 dispositions are complete canonical records without contradictory suffixes"
else
    fail "F406-R3 canonical mismatch; expected [$(tr '\n' ';' <"$r3_canonical")] actual [$(tr '\n' ';' <"$r3_records")]"
fi
forbid_regex "no affirmative script ownership grant" '^[[:space:]-]*(The )?(script|linter|reducer) (grants?|authori[sz]es) (READY|ownership|merge)' $DOCS
forbid_regex "no affirmative machine approval admission" 'machine approval (is )?admitted|machine-approved contracts? (are )?admitted' $DOCS

# Finding history is one append-only chain. Creation rows have 11 fields; dispositions have 18:
# kind, own URL/ID/digest, predecessor URL/ID/digest, stable ID, origin tip, reviewed tip, five
# axes, changed-axis declaration, proof tip, and proof identity.
finding_history_ok() {
    awk -F '|' '
      function problem(s) { print s > "/dev/stderr"; bad=1 }
      function digest_ok(s) { return length(s)==64 && s !~ /[^0-9a-f]/ }
      function url_ok(s,id) { return id ~ /^[1-9][0-9]*$/ && s == "https://github.com/darwin-finch/finch/pull/542#issuecomment-" id }
      $1 == "CREATE" {
        if (NF != 11) { problem("creation field count expected=11 actual=" NF " line=" NR); next }
        if (creation++) problem("finding creation cardinality expected=1 actual>1")
        if (!url_ok($2,$3)) problem("creation comment URL/ID expected=canonical-matching actual=" $2 "/" $3)
        if (!digest_ok($4)) problem("creation digest expected=64-lowercase-hex actual=" $4)
        if (length($6) != 40 || $6 ~ /[^0-9a-f]/) problem("origin-failing-tip expected=40-lowercase-hex actual=" $6)
        url[$3]=$2; digest[$3]=$4; fid[$3]=$5; origin[$3]=$6
        confidence[$3]=$7; severity[$3]=$8; locality[$3]=$9; obligation[$3]=$10; state[$3]=$11
      }
      $1 == "DISPOSE" {
        if (NF != 18) { problem("disposition field count expected=18 actual=" NF " line=" NR); next }
        if (!url_ok($2,$4)) problem("disposition comment URL/ID expected=canonical-matching actual=" $2 "/" $4)
        if (!digest_ok($3)) problem("disposition digest expected=64-lowercase-hex actual=" $3)
        if (!($6 in url)) { problem("immediate predecessor ID missing actual=" $6 " line=" NR); next }
        successor[$6]++
        if (successor[$6] != 1) problem("direct successor cardinality expected=1 actual=" successor[$6] " predecessor=" $6)
        if ($5 != url[$6] || $7 != digest[$6]) problem("predecessor URL/ID/digest mismatch predecessor=" $6 " expected=" url[$6] "/" digest[$6] " actual=" $5 "/" $7)
        if ($8 != fid[$6]) problem("stable finding ID mismatch expected=" fid[$6] " actual=" $8)
        if ($9 != origin[$6]) problem("origin-failing-tip mismatch expected=" origin[$6] " actual=" $9)
        if (length($9) != 40 || length($10) != 40 || $9 ~ /[^0-9a-f]/ || $10 ~ /[^0-9a-f]/) problem("tip identity expected=40-lowercase-hex origin=" $9 " reviewed=" $10)
        if ($10 == $9 && $15 == "RESOLVED") problem("resolved code finding requires distinct disposition-reviewed-tip origin=" $9 " reviewed=" $10)
        split($16, change, ":"); split(change[2], values, "->")
        changed=change[1]
        for (i=11;i<=15;i++) {
          old=(i==11?confidence[$6]:(i==12?severity[$6]:(i==13?locality[$6]:(i==14?obligation[$6]:state[$6]))))
          if ($i != old && changed != i) problem("axis changed without disposition axis=" i " expected=" old " actual=" $i)
          if (changed == i && (values[1] != old || values[2] != $i)) problem("axis disposition mismatch descriptor=" $16)
        }
        if ($17 != $10) problem("proof tip mismatch expected disposition-reviewed-tip=" $10 " actual=" $17)
        if ($18 == "") problem("disposition proof identity is empty")
        url[$4]=$2; digest[$4]=$3; fid[$4]=$8; origin[$4]=$9
        confidence[$4]=$11; severity[$4]=$12; locality[$4]=$13; obligation[$4]=$14; state[$4]=$15
      }
      $1 != "CREATE" && $1 != "DISPOSE" { problem("finding record kind invalid actual=" $1 " line=" NR) }
      END { if (creation != 1) problem("finding creation cardinality expected=1 actual=" creation); exit bad }
    ' "$1"
}
origin_tip=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
repair_tip=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
next_tip=cccccccccccccccccccccccccccccccccccccccc
origin_url=https://github.com/darwin-finch/finch/pull/542#issuecomment-10
repair_url=https://github.com/darwin-finch/finch/pull/542#issuecomment-11
origin_digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
repair_digest=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
printf '%s\n' \
 "CREATE|$origin_url|10|$origin_digest|F-1|$origin_tip|CONFIRMED|HIGH|SAME_CONTRACT|BLOCKER|OPEN" \
 "DISPOSE|$repair_url|$repair_digest|11|$origin_url|10|$origin_digest|F-1|$origin_tip|$repair_tip|CONFIRMED|HIGH|SAME_CONTRACT|BLOCKER|RESOLVED|15:OPEN->RESOLVED|$repair_tip|test-at-repair-tip" >"$TMP/finding.good"
if finding_history_ok "$TMP/finding.good" 2>"$TMP/finding.good.err"; then
    pass "whole finding history preserves one predecessor/successor chain and separate origin/repair tips"
else
    fail "valid append-only finding history rejected: $(tr '\n' ';' <"$TMP/finding.good.err")"
fi
sed '2s/|F-1|/|F-2|/' "$TMP/finding.good" >"$TMP/finding.bad-id"
expect_reject "changed finding identity is rejected" "stable finding ID mismatch" finding_history_ok "$TMP/finding.bad-id"
sed '2s/#issuecomment-10|10|/#issuecomment-99|10|/' "$TMP/finding.good" >"$TMP/finding.bad-url"
expect_reject "mismatched predecessor URL is rejected" "predecessor URL/ID/digest mismatch" finding_history_ok "$TMP/finding.bad-url"
sed "2s/|10|$origin_digest/|99|$origin_digest/" "$TMP/finding.good" >"$TMP/finding.bad-predecessor-id"
expect_reject "mismatched predecessor ID is rejected" "immediate predecessor ID missing" finding_history_ok "$TMP/finding.bad-predecessor-id"
sed "2s/$origin_digest|F-1/$repair_digest|F-1/" "$TMP/finding.good" >"$TMP/finding.bad-digest"
expect_reject "mismatched predecessor digest is rejected" "predecessor URL/ID/digest mismatch" finding_history_ok "$TMP/finding.bad-digest"
sed '1s#https://github.com/darwin-finch/finch/pull/542#https://example.test/not-a-comment#; 2s#https://github.com/darwin-finch/finch/pull/542#https://example.test/not-a-comment#' "$TMP/finding.good" >"$TMP/finding.noncanonical-url"
expect_reject "noncanonical finding URL is rejected even when predecessor matches" "comment URL/ID expected=canonical-matching" finding_history_ok "$TMP/finding.noncanonical-url"
sed "s/$origin_digest/gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg/g" "$TMP/finding.good" >"$TMP/finding.nonhex-digest"
expect_reject "nonhex finding digest is rejected even when predecessor matches" "digest expected=64-lowercase-hex" finding_history_ok "$TMP/finding.nonhex-digest"
sed "2s/$origin_tip|$repair_tip/$next_tip|$repair_tip/" "$TMP/finding.good" >"$TMP/finding.bad-origin"
expect_reject "changed origin-failing tip is rejected" "origin-failing-tip mismatch" finding_history_ok "$TMP/finding.bad-origin"
sed "2s/$repair_tip/$origin_tip/g" "$TMP/finding.good" >"$TMP/finding.same-tip"
expect_reject "resolution at the unchanged failing tip is rejected" "requires distinct disposition-reviewed-tip" finding_history_ok "$TMP/finding.same-tip"
sed "2s/|$repair_tip|test-at-repair-tip/|$next_tip|test-at-repair-tip/" "$TMP/finding.good" >"$TMP/finding.bad-proof-tip"
expect_reject "proof must bind the disposition-reviewed tip" "proof tip mismatch" finding_history_ok "$TMP/finding.bad-proof-tip"
sed '2s/|HIGH|/|LOW|/' "$TMP/finding.good" >"$TMP/finding.hidden-axis"
expect_reject "unrecorded axis reclassification is rejected" "axis changed without disposition" finding_history_ok "$TMP/finding.hidden-axis"
{ sed -n '1,2p' "$TMP/finding.good"; sed -n '2p' "$TMP/finding.good" | sed 's/issuecomment-11/issuecomment-12/; s/|11|/|12|/'; } >"$TMP/finding.sibling"
expect_reject "conflicting sibling dispositions remain unresolved" "direct successor cardinality expected=1 actual=2" finding_history_ok "$TMP/finding.sibling"
sed -n '2p' "$TMP/finding.good" >"$TMP/finding.no-create"
expect_reject "missing finding creation is rejected" "immediate predecessor ID missing" finding_history_ok "$TMP/finding.no-create"

# Classification must be independent of severity and total finding count.
blocking() {
    confidence=$1 severity=$2 locality=$3 obligation=$4 state=$5 count=$6
    : "$severity" "$count"
    test "$confidence" = CONFIRMED && test "$locality" = SAME_CONTRACT &&
        { test "$obligation" = BLOCKER || test "$obligation" = REGRESSION_DEBT; } &&
        test "$state" = OPEN
}
for severity in CRITICAL HIGH MEDIUM LOW; do
    for count in 1 2 17; do
        if blocking CONFIRMED "$severity" SAME_CONTRACT BLOCKER OPEN "$count" &&
           blocking CONFIRMED "$severity" SAME_CONTRACT REGRESSION_DEBT OPEN "$count" &&
           ! blocking PLAUSIBLE "$severity" SAME_CONTRACT BLOCKER OPEN "$count" &&
           ! blocking CONFIRMED "$severity" INDEPENDENT BLOCKER OPEN "$count" &&
           ! blocking CONFIRMED "$severity" SAME_CONTRACT NONBLOCKING OPEN "$count" &&
           ! blocking CONFIRMED "$severity" SAME_CONTRACT BLOCKER RESOLVED "$count"; then
            pass "blocking axes remain independent at severity=$severity count=$count"
        else
            fail "blocking axes coupled to severity/count or ignored another axis: severity=$severity count=$count"
        fi
    done
done

# A separately defined expected inventory must exactly match the recursive observed graph.
successor_graph_ok() {
    expected=$1 actual=$2
    awk -F '|' '
      NR == FNR {
        if (NF != 8) { print "expected successor field count expected=8 actual=" NF " line=" NR > "/dev/stderr"; bad=1; next }
        if (expected[$2] != "") { print "expected successor duplicate node=" $2 > "/dev/stderr"; bad=1 }
        expected[$2]=$0; expected_gate[$1]++; next
      }
      NF != 8 { print "successor row field count expected=8 actual=" NF " line=" NR > "/dev/stderr"; bad=1; next }
      $1 == "" || $2 == "" || $3 == "" || $4 == "" || $5 == "" || $6 == "" || $7 == "" || $8 == "" {
        print "missing successor identity field at line " NR ": " $0 > "/dev/stderr"; bad=1
      }
      seen[$2]++ { print "duplicate successor node identity=" $2 > "/dev/stderr"; bad=1 }
      !($2 in expected) { print "extra successor identity node=" $2 " gate=" $1 > "/dev/stderr"; bad=1 }
      ($2 in expected) && $0 != expected[$2] { print "successor inventory identity mismatch node=" $2 " expected=" expected[$2] " actual=" $0 > "/dev/stderr"; bad=1 }
      { actual_gate[$1]++ }
      $8 != "UNEDITED" { print "edited successor identity node=" $2 " state=" $8 > "/dev/stderr"; bad=1 }
      $3 == "ROOT" { roots[$1]++; rootnode[$1]=$2 }
      $3 != "ROOT" { parent[$2]=$3; children[$3]++ }
      { gate[$2]=$1; kind[$2]=$7; proof[$2]=$6; owner[$2]=$4; claim[$2]=$5 }
      END {
        for (n in expected) if (!(n in seen)) { print "missing expected successor node=" n " record=" expected[n] > "/dev/stderr"; bad=1 }
        for (g in expected_gate) if (actual_gate[g] != expected_gate[g]) { print "gate inventory cardinality mismatch gate=" g " expected=" expected_gate[g] " actual=" actual_gate[g] > "/dev/stderr"; bad=1 }
        for (g in actual_gate) if (!(g in expected_gate)) { print "extra successor gate=" g > "/dev/stderr"; bad=1 }
        for (g in roots) if (roots[g] != 1) { print "gate root count expected=1 actual=" roots[g] " gate=" g > "/dev/stderr"; bad=1 }
        for (n in gate) {
          if (parent[n] != "" && !(parent[n] in gate)) { print "missing successor parent=" parent[n] " child=" n > "/dev/stderr"; bad=1 }
          else if (parent[n] != "" && gate[parent[n]] != gate[n]) { print "successor cross-gate parent child=" n " parent=" parent[n] > "/dev/stderr"; bad=1 }
          if (kind[n] == "REPLACED" && children[n] == 0) { print "replacement has no successor node=" n > "/dev/stderr"; bad=1 }
          if (kind[n] == "LEAF" && proof[n] != "MERGED_CURRENT_MAIN") { print "unproven successor leaf node=" n " proof=" proof[n] > "/dev/stderr"; bad=1 }
          if (kind[n] != "LEAF" && kind[n] != "REPLACED") { print "unknown successor state node=" n " state=" kind[n] > "/dev/stderr"; bad=1 }
          token=n
          p=n
          while (p != "ROOT") {
            if (walk[p] == token) { print "successor cycle at node=" p > "/dev/stderr"; bad=1; break }
            walk[p]=token
            p=parent[p]
            if (p == "") break
          }
        }
        exit bad
      }
    ' "$expected" "$actual"
}
printf '%s\n' \
 'gate-a|root-a|ROOT|worker-a|claim-a|-|REPLACED|UNEDITED' \
 'gate-a|child-a|root-a|worker-b|claim-b|-|REPLACED|UNEDITED' \
 'gate-a|grandchild-a|child-a|worker-d|claim-d|MERGED_CURRENT_MAIN|LEAF|UNEDITED' \
 'gate-b|root-b|ROOT|worker-c|claim-c|MERGED_CURRENT_MAIN|LEAF|UNEDITED' >"$TMP/successors.expected"
cp "$TMP/successors.expected" "$TMP/successors.good"
if successor_graph_ok "$TMP/successors.expected" "$TMP/successors.good" 2>"$TMP/successors.good.err"; then
    pass "actual successor graph exactly matches expected gate/owner/claim/proof inventory"
else
    fail "valid recursive successor graph rejected: $(tr '\n' ';' <"$TMP/successors.good.err")"
fi
grep -v '^gate-b|' "$TMP/successors.good" >"$TMP/successors.missing"
expect_reject "omitted inherited gate is rejected" "missing expected successor node=root-b" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.missing"
{ cat "$TMP/successors.good"; printf '%s\n' 'gate-c|root-c|ROOT|worker-x|claim-x|MERGED_CURRENT_MAIN|LEAF|UNEDITED'; } >"$TMP/successors.extra"
expect_reject "extra inherited gate is rejected" "extra successor identity node=root-c gate=gate-c" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.extra"
sed 's/worker-b/wrong-owner/' "$TMP/successors.good" >"$TMP/successors.wrong"
expect_reject "wrong successor owner is rejected" "successor inventory identity mismatch node=child-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.wrong"
sed 's/claim-b/wrong-claim/' "$TMP/successors.good" >"$TMP/successors.wrong-claim"
expect_reject "wrong successor claim is rejected" "successor inventory identity mismatch node=child-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.wrong-claim"
awk '{ print; if ($0 ~ /child-a\|root-a/) print }' "$TMP/successors.good" >"$TMP/successors.duplicate"
expect_reject "duplicate successor identity is rejected" "duplicate successor node identity" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.duplicate"
sed 's/child-a|root-a/child-a|missing-a/' "$TMP/successors.good" >"$TMP/successors.parent"
expect_reject "missing successor parent is rejected" "successor inventory identity mismatch node=child-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.parent"
sed 's/child-a|root-a/child-a|child-a/' "$TMP/successors.good" >"$TMP/successors.cycle"
expect_reject "successor cycle is rejected" "successor inventory identity mismatch node=child-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.cycle"
sed 's/grandchild-a|child-a/grandchild-a|root-b/' "$TMP/successors.good" >"$TMP/successors.cross-gate"
expect_reject "cross-gate successor is rejected" "successor inventory identity mismatch node=grandchild-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.cross-gate"
awk -F '|' 'BEGIN { OFS="|" } { if ($2 == "grandchild-a") $8="EDITED"; print }' "$TMP/successors.good" >"$TMP/successors.edited"
expect_reject "edited successor identity is rejected" "successor inventory identity mismatch node=grandchild-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.edited"
awk -F '|' 'BEGIN { OFS="|" } { if ($2 == "grandchild-a") $6="LINKED_ONLY"; print }' "$TMP/successors.good" >"$TMP/successors.unproven"
expect_reject "unproven successor leaf remains open" "successor inventory identity mismatch node=grandchild-a" successor_graph_ok "$TMP/successors.expected" "$TMP/successors.unproven"

parent_closable() {
    test "$1" = SUPERSEDED && test "$2" = exhaustive-transfer && test "$3" = ALL_LEAVES_MERGED_CURRENT_MAIN
}
parent_must_be_closable() {
    parent_closable "$@" || {
        printf 'parent lacks current-main successor proof: state=%s transfer=%s leaves=%s\n' "$1" "$2" "$3" >&2
        return 1
    }
}
expect_reject "SUPERSEDED transfer alone keeps parent open" "parent lacks current-main successor proof" parent_must_be_closable SUPERSEDED exhaustive-transfer TRANSFERRED_ONLY
if parent_closable SUPERSEDED exhaustive-transfer ALL_LEAVES_MERGED_CURRENT_MAIN; then
    pass "SUPERSEDED parent closes only after all inherited leaves are current-main proven"
else
    fail "fully proven SUPERSEDED parent was not closable"
fi

# Finite convergence isolates every predicate and rechecks required debt after the fresh pass.
convergence() {
    ledger_before=$1 clean_passes=$2 new_blockers=$3 new_debt=$4 ledger_after=$5
    if test "$ledger_before" -ne 0; then
        printf 'pre-pass transitive ledger expected=0 actual=%s\n' "$ledger_before" >&2
        return 1
    fi
    if test "$clean_passes" -ne 1; then
        printf 'fresh clean pass count expected=1 actual=%s\n' "$clean_passes" >&2
        return 1
    fi
    if test "$new_blockers" -ne 0; then
        printf 'new confirmed same-contract blockers expected=0 actual=%s\n' "$new_blockers" >&2
        return 1
    fi
    if test "$new_debt" -ne 0; then
        printf 'new required regression debt expected=0 actual=%s\n' "$new_debt" >&2
        return 1
    fi
    if test "$ledger_after" -ne 0; then
        printf 'post-pass transitive ledger expected=0 actual=%s\n' "$ledger_after" >&2
        return 1
    fi
}
if convergence 0 1 0 0 0 2>"$TMP/converged.err"; then
    pass "zero ledger, exactly one clean pass, no new obligations, and zero recheck converges"
else
    fail "valid convergence rejected: $(tr '\n' ';' <"$TMP/converged.err")"
fi
expect_reject "nonzero pre-pass ledger rejects convergence" "pre-pass transitive ledger" convergence 1 1 0 0 0
expect_reject "zero clean passes reject convergence" "clean pass count" convergence 0 0 0 0 0
expect_reject "multiple clean passes reject convergence" "clean pass count" convergence 0 2 0 0 0
expect_reject "new blocker reopens repair" "new confirmed same-contract blockers" convergence 0 1 1 0 1
expect_reject "new required debt reopens repair" "new required regression debt" convergence 0 1 0 1 1
expect_reject "nonzero post-pass ledger rejects convergence" "post-pass transitive ledger" convergence 0 1 0 0 1

# Attempt accounting is independent of convergence and keyed by stable finding ID plus epoch.
attempt_ledger_ok() {
    awk -F '|' '
      NF != 6 { print "attempt row field count expected=6 actual=" NF " line=" NR > "/dev/stderr"; bad=1; next }
      seen[$1,$2,$3]++ { print "duplicate attempt identity finding=" $1 " epoch=" $2 " attempt=" $3 > "/dev/stderr"; bad=1 }
      $4 != "COMPETENT" && $4 != "INCOMPETENT" { print "attempt competence invalid finding=" $1 " actual=" $4 > "/dev/stderr"; bad=1 }
      $5 != "SURVIVED" && $5 != "RESOLVED" { print "attempt result invalid finding=" $1 " actual=" $5 > "/dev/stderr"; bad=1 }
      $6 == "" { print "attempt tip missing finding=" $1 " epoch=" $2 " attempt=" $3 > "/dev/stderr"; bad=1 }
      $4 == "COMPETENT" && $5 == "SURVIVED" { survived[$1,$2]++ }
      $5 == "RESOLVED" { resolved[$1]=1 }
      END {
        for (key in survived) if (survived[key] >= 2) {
          split(key, parts, SUBSEP); finding=parts[1]; epoch=parts[2]
          if (!resolved[finding] && !diagnosed[finding,epoch]) {
            print "strategy epoch must end after two competent SURVIVED attempts finding=" finding " epoch=" epoch " survived=" survived[key] > "/dev/stderr"; bad=1
          }
        }
        exit bad
      }
      $1 == "DIAGNOSIS" { diagnosed[$2,$3]=1 }
    ' "$1"
}
printf '%s\n' 'F-1|epoch-1|1|COMPETENT|SURVIVED|tip-a' 'F-1|epoch-1|2|COMPETENT|RESOLVED|tip-b' >"$TMP/attempt.resolved-second"
if attempt_ledger_ok "$TMP/attempt.resolved-second"; then pass "resolved second attempt does not force a strategy change"; else fail "resolved second attempt was miscounted"; fi
printf '%s\n' 'F-1|epoch-1|1|COMPETENT|SURVIVED|tip-a' 'F-2|epoch-1|2|COMPETENT|SURVIVED|tip-b' >"$TMP/attempt.distinct"
if attempt_ledger_ok "$TMP/attempt.distinct"; then pass "attempts for distinct stable finding IDs do not combine"; else fail "cross-ID attempts were combined"; fi
printf '%s\n' 'F-1|epoch-1|1|INCOMPETENT|SURVIVED|tip-a' 'F-1|epoch-1|2|COMPETENT|SURVIVED|tip-b' >"$TMP/attempt.incompetent"
if attempt_ledger_ok "$TMP/attempt.incompetent"; then pass "incompetent attempt does not count toward epoch trigger"; else fail "incompetent attempt was counted"; fi
printf '%s\n' 'F-1|epoch-1|1|COMPETENT|SURVIVED|tip-a' 'F-1|epoch-1|2|COMPETENT|SURVIVED|tip-b' >"$TMP/attempt.survived"
expect_reject "two competent surviving attempts end the strategy epoch" "strategy epoch must end" attempt_ledger_ok "$TMP/attempt.survived"
printf '%s\n' 'F-1|epoch-1|1|COMPETENT|SURVIVED|tip-a' 'F-1|epoch-1|2|COMPETENT|SURVIVED|tip-b' 'DIAGNOSIS|F-1|epoch-1|COMPETENT|RESOLVED|independent-proof' 'F-1|epoch-2|1|COMPETENT|SURVIVED|tip-c' >"$TMP/attempt.new-epoch"
if attempt_ledger_ok "$TMP/attempt.new-epoch"; then pass "diagnosis permits a new strategy epoch after two surviving attempts"; else fail "valid new strategy epoch was rejected"; fi

# Production admission: each prerequisite has its own one-fault negative.
production_allowed() {
    test "$1" = READY && test "$2" = yes && test "$3" = dedicated-branch &&
        test "$4" = dedicated-worktree && test "$5" = valid-v1 && test "$6" = complete &&
        test "$7" = clear && test "$8" = complete-clear
}
production_must_be_allowed() {
    production_allowed "$@" || {
        printf 'production prerequisite rejected: readiness=%s edit=%s branch=%s worktree=%s claim=%s retrieval=%s collision=%s post_claim=%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" >&2
        return 1
    }
}
if production_allowed READY yes dedicated-branch dedicated-worktree valid-v1 complete clear complete-clear; then
    pass "complete production-admission checklist admits work procedurally"
else
    fail "complete production-admission checklist was rejected"
fi
expect_reject "non-READY issue rejects production" "production prerequisite rejected" production_must_be_allowed NEEDS_SPECIFICATION yes dedicated-branch dedicated-worktree valid-v1 complete clear complete-clear
expect_reject "missing edit authority rejects production" "production prerequisite rejected" production_must_be_allowed READY no dedicated-branch dedicated-worktree valid-v1 complete clear complete-clear
expect_reject "missing dedicated branch rejects production" "production prerequisite rejected" production_must_be_allowed READY yes shared-branch dedicated-worktree valid-v1 complete clear complete-clear
expect_reject "missing dedicated worktree rejects production" "production prerequisite rejected" production_must_be_allowed READY yes dedicated-branch shared-worktree valid-v1 complete clear complete-clear
expect_reject "invalid claim rejects production" "production prerequisite rejected" production_must_be_allowed READY yes dedicated-branch dedicated-worktree malformed complete clear complete-clear
expect_reject "incomplete retrieval rejects production" "production prerequisite rejected" production_must_be_allowed READY yes dedicated-branch dedicated-worktree valid-v1 partial clear complete-clear
expect_reject "collision rejects production" "production prerequisite rejected" production_must_be_allowed READY yes dedicated-branch dedicated-worktree valid-v1 complete overlap complete-clear
expect_reject "missing post-claim collision check rejects production" "production prerequisite rejected" production_must_be_allowed READY yes dedicated-branch dedicated-worktree valid-v1 complete clear missing

# Bind the compact state fixture to the single operative state-invariant table.
state_policy="$TMP/state-policy"
awk -F '|' '
  /^### State invariants/ { inside=1; next }
  /^### Transition matrix/ { inside=0 }
  inside && /^\| `/ {
    for (i=2;i<=7;i++) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i); gsub(/`/, "", $i) }
    print $2 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7
  }
' "$READINESS" >"$state_policy"
state_signature=$(cksum <"$state_policy")
if test "$state_signature" = "1331928798 5838"; then
    pass "operative state table exactly matches the reviewed revision-20 fixture"
else
    fail "operative state table signature mismatch expected=[1331928798 5838] actual=[$state_signature]"
fi

state_record_ok() {
    record_state=$1 record_owner=$2 record_entry=$3 record_next=$4 record_exit=$5 record_issue=$6
    case "$record_state" in
        DRAFT) expected_owner='ROLE(proposer)'; expected_issue=Open ;;
        NEEDS_SPECIFICATION|READY|IN_PROGRESS|REPAIR_IN_PROGRESS|READY_TO_MERGE) expected_issue=Open
            case "$record_state" in NEEDS_SPECIFICATION|READY) expected_owner='ROLE(contract_owner)' ;; IN_PROGRESS|REPAIR_IN_PROGRESS) expected_owner='ROLE(claim_owner)' ;; *) expected_owner='ROLE(coordinator)' ;; esac ;;
        COMPLETION_IN_PROGRESS) expected_owner='ROLE(coordinator)'; expected_issue=CURSOR_DEPENDENT ;;
        BLOCKED_EXTERNAL) expected_owner='ROLE(coordinator)'; expected_issue=SOURCE_CURSOR_DEPENDENT ;;
        INFEASIBLE) expected_owner='ROLE(contract_owner)'; expected_issue=Open ;;
        DECLINED|SUPERSEDED) expected_owner='ROLE(contract_owner)'; expected_issue=OWNER_CONDITIONAL ;;
        COMPLETE) expected_owner='ROLE(coordinator)'; expected_issue=Closed ;;
        *) printf 'state name expected=known revision-20 state actual=%s\n' "$record_state" >&2; return 1 ;;
    esac
    if test "$record_owner" != "$expected_owner"; then printf 'state=%s owner expected=%s actual=%s\n' "$record_state" "$expected_owner" "$record_owner" >&2; return 1; fi
    for item in "entry:$record_entry" "next-action:$record_next" "exit-condition:$record_exit"; do
        field=${item%%:*}; value=${item#*:}
        if test -z "$value" || test "$value" = CONTRADICTORY; then printf 'state=%s field=%s expected=nonempty-consistent actual=%s\n' "$record_state" "$field" "$value" >&2; return 1; fi
    done
    if test "$record_issue" != "$expected_issue"; then printf 'state=%s issue-condition expected=%s actual=%s\n' "$record_state" "$expected_issue" "$record_issue" >&2; return 1; fi
}
for state in DRAFT NEEDS_SPECIFICATION READY IN_PROGRESS REPAIR_IN_PROGRESS READY_TO_MERGE COMPLETION_IN_PROGRESS BLOCKED_EXTERNAL INFEASIBLE DECLINED SUPERSEDED COMPLETE; do
    case "$state" in DRAFT) owner='ROLE(proposer)'; issue=Open ;; NEEDS_SPECIFICATION|READY|INFEASIBLE|DECLINED|SUPERSEDED) owner='ROLE(contract_owner)'; case "$state" in DECLINED|SUPERSEDED) issue=OWNER_CONDITIONAL ;; *) issue=Open ;; esac ;; IN_PROGRESS|REPAIR_IN_PROGRESS) owner='ROLE(claim_owner)'; issue=Open ;; COMPLETION_IN_PROGRESS) owner='ROLE(coordinator)'; issue=CURSOR_DEPENDENT ;; BLOCKED_EXTERNAL) owner='ROLE(coordinator)'; issue=SOURCE_CURSOR_DEPENDENT ;; COMPLETE) owner='ROLE(coordinator)'; issue=Closed ;; *) owner='ROLE(coordinator)'; issue=Open ;; esac
    if state_record_ok "$state" "$owner" evidence next-action exit-evidence "$issue"; then pass "state row $state accepts all six invariant fields"; else fail "valid state row rejected state=$state"; fi
    expect_reject "state row $state rejects missing state identity" "state name expected=known" state_record_ok '' "$owner" evidence next-action exit-evidence "$issue"
    expect_reject "state row $state rejects contradictory state identity" "state name expected=known" state_record_ok CONTRADICTORY "$owner" evidence next-action exit-evidence "$issue"
    expect_reject "state row $state rejects missing owner" "state=$state owner expected=" state_record_ok "$state" '' evidence next-action exit-evidence "$issue"
    expect_reject "state row $state rejects contradictory owner" "state=$state owner expected=" state_record_ok "$state" CONTRADICTORY evidence next-action exit-evidence "$issue"
    expect_reject "state row $state rejects missing entry evidence" "field=entry" state_record_ok "$state" "$owner" '' next-action exit-evidence "$issue"
    expect_reject "state row $state rejects contradictory entry evidence" "field=entry" state_record_ok "$state" "$owner" CONTRADICTORY next-action exit-evidence "$issue"
    expect_reject "state row $state rejects missing next action" "field=next-action" state_record_ok "$state" "$owner" evidence '' exit-evidence "$issue"
    expect_reject "state row $state rejects contradictory next action" "field=next-action" state_record_ok "$state" "$owner" evidence CONTRADICTORY exit-evidence "$issue"
    expect_reject "state row $state rejects missing exit condition" "field=exit-condition" state_record_ok "$state" "$owner" evidence next-action '' "$issue"
    expect_reject "state row $state rejects contradictory exit condition" "field=exit-condition" state_record_ok "$state" "$owner" evidence next-action CONTRADICTORY "$issue"
    expect_reject "state row $state rejects missing issue condition" "issue-condition expected=$issue" state_record_ok "$state" "$owner" evidence next-action exit-evidence ''
    expect_reject "state row $state rejects wrong issue condition" "issue-condition expected=$issue" state_record_ok "$state" "$owner" evidence next-action exit-evidence CONTRADICTORY
done

# Every transition row is exercised independently. Its line ordinal is the stable fixture variant,
# because multiple rows intentionally share from/to pairs but carry different evidence variants.
transition_policy="$TMP/transition-policy"
awk -F '|' '
  /^### Transition matrix/ { inside=1; next }
  /^For blocked resumption/ { inside=0 }
  inside && /^\| `/ {
    for (i=2;i<=5;i++) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i); gsub(/`/, "", $i) }
    print $2 "|" $3 "|" $4 "|" $5
  }
' "$READINESS" >"$transition_policy"
transition_signature=$(cksum <"$transition_policy")
if test "$transition_signature" = "3857731269 7281" && test "$(wc -l <"$transition_policy" | tr -d ' ')" = 55; then
    pass "operative transition table exactly matches all 55 reviewed revision-20 edge variants"
else
    fail "operative transition table mismatch expected signature/count=[3857731269 7281/55] actual=[$transition_signature/$(wc -l <"$transition_policy" | tr -d ' ')]"
fi
transition_record_ok() {
    variant=$1 from=$2 actor_expression=$3 to=$4 evidence=$5
    expected=$(sed -n "${variant}p" "$transition_policy")
    actual="$from|$actor_expression|$to|$evidence"
    if test -z "$expected"; then printf 'transition variant expected=1..55 actual=%s\n' "$variant" >&2; return 1; fi
    if test "$actual" != "$expected"; then printf 'transition variant=%s expected=[%s] actual=[%s]\n' "$variant" "$expected" "$actual" >&2; return 1; fi
}
variant=0
while IFS='|' read -r from actor_expression to evidence; do
    variant=$((variant + 1))
    if transition_record_ok "$variant" "$from" "$actor_expression" "$to" "$evidence"; then pass "transition variant $variant accepts exact edge/actor/evidence $from->$to"; else fail "valid transition rejected variant=$variant $from->$to"; fi
    expect_reject "transition variant $variant rejects wrong actor expression" "transition variant=$variant" transition_record_ok "$variant" "$from" 'ROLE(unnamed_actor)' "$to" "$evidence"
    expect_reject "transition variant $variant rejects missing evidence" "transition variant=$variant" transition_record_ok "$variant" "$from" "$actor_expression" "$to" ''
done <"$transition_policy"
expect_reject "unlisted DRAFT to IN_PROGRESS edge is rejected" "transition variant expected=1..55" transition_record_ok 56 DRAFT 'ROLE(proposer)' IN_PROGRESS evidence
expect_reject "unlisted NEEDS_SPECIFICATION to IN_PROGRESS edge is rejected" "transition variant expected=1..55" transition_record_ok 56 NEEDS_SPECIFICATION 'ROLE(contract_owner)' IN_PROGRESS evidence
expect_reject "unlisted DRAFT to COMPLETE edge is rejected" "transition variant expected=1..55" transition_record_ok 56 DRAFT 'ROLE(proposer)' COMPLETE evidence
expect_reject "direct READY_TO_MERGE to COMPLETE edge is rejected" "transition variant expected=1..55" transition_record_ok 56 READY_TO_MERGE 'ROLE(coordinator)' COMPLETE evidence
expect_reject "outgoing COMPLETE edge is rejected" "transition variant expected=1..55" transition_record_ok 56 COMPLETE 'ROLE(coordinator)' DRAFT evidence
expect_reject "BLOCKED_EXTERNAL to COMPLETE edge is rejected" "transition variant expected=1..55" transition_record_ok 56 BLOCKED_EXTERNAL 'ROLE(coordinator)' COMPLETE evidence

lifecycle_path_ok() {
    path_kind=$1 actual_path=$2
    case "$path_kind" in
      ordinary) expected_path='DRAFT READY IN_PROGRESS REPAIR_IN_PROGRESS READY_TO_MERGE COMPLETION_IN_PROGRESS COMPLETE' ;;
      discovery) expected_path='DRAFT NEEDS_SPECIFICATION READY' ;;
      declined-reopen-draft) expected_path='DECLINED DRAFT' ;;
      declined-respecify) expected_path='DECLINED NEEDS_SPECIFICATION' ;;
      infeasible-respecify) expected_path='INFEASIBLE NEEDS_SPECIFICATION' ;;
      superseded-respecify) expected_path='SUPERSEDED NEEDS_SPECIFICATION' ;;
      *) printf 'lifecycle path kind expected=known actual=%s\n' "$path_kind" >&2; return 1 ;;
    esac
    test "$actual_path" = "$expected_path" || { printf 'lifecycle path kind=%s expected=[%s] actual=[%s]\n' "$path_kind" "$expected_path" "$actual_path" >&2; return 1; }
}
for lifecycle_fixture in 'ordinary|DRAFT READY IN_PROGRESS REPAIR_IN_PROGRESS READY_TO_MERGE COMPLETION_IN_PROGRESS COMPLETE' 'discovery|DRAFT NEEDS_SPECIFICATION READY' 'declined-reopen-draft|DECLINED DRAFT' 'declined-respecify|DECLINED NEEDS_SPECIFICATION' 'infeasible-respecify|INFEASIBLE NEEDS_SPECIFICATION' 'superseded-respecify|SUPERSEDED NEEDS_SPECIFICATION'; do
    path_kind=${lifecycle_fixture%%|*}; actual_path=${lifecycle_fixture#*|}
    if lifecycle_path_ok "$path_kind" "$actual_path"; then pass "target-specific lifecycle path $path_kind is accepted"; else fail "valid lifecycle path rejected kind=$path_kind"; fi
done
expect_reject "ordinary lifecycle cannot bypass completion accounting" "lifecycle path kind=ordinary" lifecycle_path_ok ordinary 'DRAFT READY IN_PROGRESS READY_TO_MERGE COMPLETE'

actor_evidence_ok() {
    expression=$1 shape=$2 actor1=$3 actor2=$4 evidence1=$5 evidence2=$6 decision_link=$7 decision_maker=$8
    case "$expression" in
      'ROLE(coordinator)'|'ROLE(claim_owner)') expected_role=${expression#ROLE(}; expected_role=${expected_role%)}; test "$shape" = single && test "$actor1" = "$expected_role" && test "$actor2" = none || { printf 'ROLE actor expected=single %s actual=%s/%s/%s\n' "$expected_role" "$shape" "$actor1" "$actor2" >&2; return 1; } ;;
      'ANY_OF(proposer,coordinator)') test "$shape" = single && { test "$actor1" = proposer || test "$actor1" = coordinator; } || { printf 'ANY_OF actor expected=proposer-or-coordinator actual=%s/%s\n' "$shape" "$actor1" >&2; return 1; } ;;
      'ANY_OF(implementation_reviewer,coordinator)') test "$shape" = single && { test "$actor1" = implementation_reviewer || test "$actor1" = coordinator; } || { printf 'ANY_OF actor expected=implementation_reviewer-or-coordinator actual=%s/%s\n' "$shape" "$actor1" >&2; return 1; } ;;
      'ALL_OF(contract_owner,fresh_plan_reviewer)') test "$shape" = all && test "$actor1" = contract_owner && test "$actor2" = fresh_plan_reviewer && test "$actor1" != "$actor2" && test "$evidence1" != "$evidence2" || { printf 'ALL_OF expected=distinct principals/evidence actual=%s/%s/%s/%s/%s\n' "$shape" "$actor1" "$actor2" "$evidence1" "$evidence2" >&2; return 1; } ;;
      'ALL_OF(implementation_reviewer,coordinator)') test "$shape" = all && test "$actor1" = implementation_reviewer && test "$actor2" = coordinator && test "$actor1" != "$actor2" && test "$evidence1" != "$evidence2" || { printf 'ALL_OF implementation expected=distinct principals/evidence actual=%s/%s/%s/%s/%s\n' "$shape" "$actor1" "$actor2" "$evidence1" "$evidence2" >&2; return 1; } ;;
      'DECISION_BY(contract_owner); RECORDED_BY(coordinator)')
        if test "$shape" = direct; then test "$actor1" = contract_owner && test "$decision_maker" = contract_owner || { printf 'DECISION_BY direct expected=contract_owner actual=%s/%s\n' "$actor1" "$decision_maker" >&2; return 1; }
        elif test "$shape" = recorded; then test "$actor1" = coordinator && test "$decision_link" = verified-owner-link && test "$decision_maker" = contract_owner || { printf 'RECORDED_BY expected=coordinator+verified-owner-link actual=%s/%s/%s\n' "$actor1" "$decision_link" "$decision_maker" >&2; return 1; }
        else printf 'decision record shape expected=direct-or-recorded actual=%s\n' "$shape" >&2; return 1; fi ;;
      *) printf 'actor expression expected=normative grammar actual=%s\n' "$expression" >&2; return 1 ;;
    esac
}
if actor_evidence_ok 'ROLE(coordinator)' single coordinator none ev1 none none none; then pass "ROLE accepts its sole named actor"; else fail "valid ROLE rejected"; fi
expect_reject "ROLE rejects an unnamed actor" "ROLE actor expected=" actor_evidence_ok 'ROLE(coordinator)' single claimant none ev1 none none none
if actor_evidence_ok 'ROLE(claim_owner)' single claim_owner none ev1 none none none; then pass "ROLE accepts claim_owner on repair transitions"; else fail "valid claim_owner ROLE rejected"; fi
if actor_evidence_ok 'ANY_OF(proposer,coordinator)' single proposer none ev1 none none none && actor_evidence_ok 'ANY_OF(proposer,coordinator)' single coordinator none ev1 none none none; then pass "ANY_OF accepts each named actor separately"; else fail "valid ANY_OF actor rejected"; fi
expect_reject "ANY_OF rejects unnamed actor" "ANY_OF actor expected=" actor_evidence_ok 'ANY_OF(proposer,coordinator)' single reviewer none ev1 none none none
if actor_evidence_ok 'ANY_OF(implementation_reviewer,coordinator)' single implementation_reviewer none ev1 none none none && actor_evidence_ok 'ANY_OF(implementation_reviewer,coordinator)' single coordinator none ev1 none none none; then pass "merge fallback ANY_OF accepts reviewer and coordinator separately"; else fail "valid merge fallback ANY_OF rejected"; fi
expect_reject "merge fallback ANY_OF rejects claimant" "ANY_OF actor expected=implementation_reviewer-or-coordinator" actor_evidence_ok 'ANY_OF(implementation_reviewer,coordinator)' single claim_owner none ev1 none none none
if actor_evidence_ok 'ALL_OF(contract_owner,fresh_plan_reviewer)' all contract_owner fresh_plan_reviewer owner-proof reviewer-proof none none; then pass "ALL_OF accepts distinct principals with distinct evidence"; else fail "valid ALL_OF rejected"; fi
expect_reject "ALL_OF rejects one-role omission" "ALL_OF expected=" actor_evidence_ok 'ALL_OF(contract_owner,fresh_plan_reviewer)' all contract_owner none owner-proof none none none
expect_reject "ALL_OF rejects principal alias" "ALL_OF expected=" actor_evidence_ok 'ALL_OF(contract_owner,fresh_plan_reviewer)' all contract_owner contract_owner owner-proof reviewer-proof none none
expect_reject "ALL_OF rejects reused evidence" "ALL_OF expected=" actor_evidence_ok 'ALL_OF(contract_owner,fresh_plan_reviewer)' all contract_owner fresh_plan_reviewer same-proof same-proof none none
if actor_evidence_ok 'ALL_OF(implementation_reviewer,coordinator)' all implementation_reviewer coordinator reviewer-proof coordinator-proof none none; then pass "merge ALL_OF accepts independent reviewer and coordinator evidence"; else fail "valid merge ALL_OF rejected"; fi
expect_reject "merge ALL_OF rejects reviewer omission" "ALL_OF implementation expected=" actor_evidence_ok 'ALL_OF(implementation_reviewer,coordinator)' all none coordinator none coordinator-proof none none
expect_reject "merge ALL_OF rejects principal alias" "ALL_OF implementation expected=" actor_evidence_ok 'ALL_OF(implementation_reviewer,coordinator)' all coordinator coordinator reviewer-proof coordinator-proof none none
expect_reject "merge ALL_OF rejects reused evidence" "ALL_OF implementation expected=" actor_evidence_ok 'ALL_OF(implementation_reviewer,coordinator)' all implementation_reviewer coordinator same-proof same-proof none none
if actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' direct contract_owner none owner-proof none none contract_owner && actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' recorded coordinator none record-proof none verified-owner-link contract_owner; then pass "DECISION_BY/RECORDED_BY accepts direct owner or verified mechanical record"; else fail "valid decision record rejected"; fi
expect_reject "decision grammar rejects recorder-only judgment" "RECORDED_BY expected=" actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' recorded coordinator none proof none absent coordinator
expect_reject "decision grammar rejects absent owner link" "RECORDED_BY expected=" actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' recorded coordinator none proof none absent contract_owner
expect_reject "decision grammar rejects wrong decision maker" "DECISION_BY direct expected=" actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' direct reviewer none proof none none reviewer
for disposition in INFEASIBLE DECLINED SUPERSEDED; do
    for unauthorized_actor in coordinator claim_owner implementation_reviewer; do
        expect_reject "$unauthorized_actor cannot assign $disposition" "DECISION_BY direct expected=" actor_evidence_ok 'DECISION_BY(contract_owner); RECORDED_BY(coordinator)' direct "$unauthorized_actor" none proof none none "$unauthorized_actor"
    done
done

# Blocked resumption uses named variants and fully revalidates the destination or deterministic fallback.
blocked_resume_ok() {
    variant=$1 stored=$2 destination=$3 condition=$4 invariants=$5 claim=$6 contract=$7 owner_decision=$8 cursor=$9
    test "$condition" = satisfied || { printf 'blocked variant=%s condition expected=satisfied actual=%s\n' "$variant" "$condition" >&2; return 1; }
    case "$variant" in
      BE-R-NS) expected=NEEDS_SPECIFICATION; needed=fresh ;;
      BE-R-RDY) expected=READY; needed=fresh ;;
      BE-R-IP) expected=IN_PROGRESS; needed=fresh-active ;;
      BE-R-RIP) expected=REPAIR_IN_PROGRESS; needed=fresh-active ;;
      BE-R-RTM) expected=READY_TO_MERGE; needed=fresh ;;
      BE-R-CIP) expected=COMPLETION_IN_PROGRESS; needed=fresh-cursor ;;
      BE-F-RDY) case "$stored" in IN_PROGRESS|REPAIR_IN_PROGRESS|READY_TO_MERGE) ;; *) printf 'fallback BE-F-RDY stored implementation destination invalid actual=%s\n' "$stored" >&2; return 1 ;; esac; expected=READY; needed=terminal-current ;;
      BE-F-RIP) case "$stored" in IN_PROGRESS|REPAIR_IN_PROGRESS|READY_TO_MERGE) ;; *) printf 'fallback BE-F-RIP stored implementation destination invalid actual=%s\n' "$stored" >&2; return 1 ;; esac; expected=REPAIR_IN_PROGRESS; needed=stale-active ;;
      BE-F-NS) expected=NEEDS_SPECIFICATION; needed=invalid-owner ;;
      *) printf 'blocked variant expected=known actual=%s\n' "$variant" >&2; return 1 ;;
    esac
    case "$variant" in BE-R-*) test "$stored" = "$expected" || { printf 'blocked variant=%s stored destination expected=%s actual=%s\n' "$variant" "$expected" "$stored" >&2; return 1; } ;; esac
    test "$destination" = "$expected" || { printf 'blocked variant=%s destination expected=%s actual=%s\n' "$variant" "$expected" "$destination" >&2; return 1; }
    case "$needed" in fresh) test "$invariants" = fresh || { printf 'blocked variant=%s destination invariants expected=fresh actual=%s\n' "$variant" "$invariants" >&2; return 1; } ;; fresh-active) test "$invariants" = fresh && test "$claim" = active || { printf 'blocked variant=%s implementation invariants expected=fresh/active actual=%s/%s\n' "$variant" "$invariants" "$claim" >&2; return 1; } ;; fresh-cursor) test "$invariants" = fresh && test "$cursor" != none || { printf 'blocked variant=%s completion prefix/cursor expected=fresh/nonempty actual=%s/%s\n' "$variant" "$invariants" "$cursor" >&2; return 1; } ;; terminal-current) test "$claim" = terminal && test "$contract" = current || { printf 'blocked variant=%s fallback evidence expected=terminal/current actual=%s/%s\n' "$variant" "$claim" "$contract" >&2; return 1; } ;; stale-active) test "$claim" = active && test "$invariants" = stale || { printf 'blocked variant=%s fallback evidence expected=active/stale actual=%s/%s\n' "$variant" "$claim" "$invariants" >&2; return 1; } ;; invalid-owner) test "$contract" = invalid && test "$owner_decision" = verified || { printf 'blocked variant=%s respecification expected=invalid/verified-owner actual=%s/%s\n' "$variant" "$contract" "$owner_decision" >&2; return 1; } ;; esac
}
for record in 'BE-R-NS|NEEDS_SPECIFICATION|NEEDS_SPECIFICATION|fresh|none|current|none' 'BE-R-RDY|READY|READY|fresh|none|current|none' 'BE-R-IP|IN_PROGRESS|IN_PROGRESS|fresh|active|current|none' 'BE-R-RIP|REPAIR_IN_PROGRESS|REPAIR_IN_PROGRESS|fresh|active|current|none' 'BE-R-RTM|READY_TO_MERGE|READY_TO_MERGE|fresh|active|current|none' 'BE-R-CIP|COMPLETION_IN_PROGRESS|COMPLETION_IN_PROGRESS|fresh|terminal|current|5'; do
    old_ifs=$IFS; IFS='|'; set -- $record; IFS=$old_ifs
    if blocked_resume_ok "$1" "$2" "$3" satisfied "$4" "$5" "$6" none "$7"; then pass "$1 direct resume accepts freshly revalidated destination"; else fail "$1 valid direct resume rejected"; fi
    expect_reject "$1 rejects one lost destination invariant" "expected=" blocked_resume_ok "$1" "$2" "$3" satisfied stale "$5" "$6" none "$7"
done
if blocked_resume_ok BE-F-RDY IN_PROGRESS READY satisfied stale terminal current none none; then pass "BE-F-RDY safely falls back after terminalized claim"; else fail "valid BE-F-RDY rejected"; fi
expect_reject "BE-F-RDY rejects an active claim" "fallback evidence expected=terminal/current" blocked_resume_ok BE-F-RDY IN_PROGRESS READY satisfied stale active current none none
if blocked_resume_ok BE-F-RIP READY_TO_MERGE REPAIR_IN_PROGRESS satisfied stale active current none none; then pass "BE-F-RIP safely falls back for stale candidate under active claim"; else fail "valid BE-F-RIP rejected"; fi
expect_reject "BE-F-RIP rejects terminalized claim" "fallback evidence expected=active/stale" blocked_resume_ok BE-F-RIP READY_TO_MERGE REPAIR_IN_PROGRESS satisfied stale terminal current none none
if blocked_resume_ok BE-F-NS READY NEEDS_SPECIFICATION satisfied stale terminal invalid verified none; then pass "BE-F-NS accepts owner-directed invalid-contract respecification"; else fail "valid BE-F-NS rejected"; fi
expect_reject "BE-F-NS rejects recorder-only invalidation" "respecification expected=invalid/verified-owner" blocked_resume_ok BE-F-NS READY NEEDS_SPECIFICATION satisfied stale terminal invalid recorder-only none
expect_reject "blocked resume rejects absent stored destination" "stored destination expected=READY actual=" blocked_resume_ok BE-R-RDY '' READY satisfied fresh none current none none
expect_reject "blocked resume rejects mismatched stored destination" "stored destination expected=READY actual=IN_PROGRESS" blocked_resume_ok BE-R-RDY IN_PROGRESS READY satisfied fresh none current none none
expect_reject "terminalized claim cannot resume to implementation" "implementation invariants expected=fresh/active" blocked_resume_ok BE-R-IP IN_PROGRESS IN_PROGRESS satisfied fresh terminal current none none
expect_reject "stale evidence cannot resume directly to merge readiness" "destination invariants expected=fresh" blocked_resume_ok BE-R-RTM READY_TO_MERGE READY_TO_MERGE satisfied stale active current none none
merge_ready_block_storage_ok() {
    claim=$1 stored=$2
    case "$claim" in active) expected=READY_TO_MERGE ;; terminal) expected=READY ;; *) printf 'merge-ready block claim expected=active-or-terminal actual=%s\n' "$claim" >&2; return 1 ;; esac
    test "$stored" = "$expected" || { printf 'merge-ready block stored destination expected=%s actual=%s claim=%s\n' "$expected" "$stored" "$claim" >&2; return 1; }
}
if merge_ready_block_storage_ok active READY_TO_MERGE; then pass "READY_TO_MERGE external wait preserves active claim destination"; else fail "valid active-claim merge wait rejected"; fi
if merge_ready_block_storage_ok terminal READY; then pass "READY_TO_MERGE external wait stores READY after claim terminal"; else fail "valid terminal-claim merge wait rejected"; fi
expect_reject "READY_TO_MERGE wait rejects unsafe storage choice" "stored destination expected=READY actual=READY_TO_MERGE" merge_ready_block_storage_ok terminal READY_TO_MERGE

# Task-packet authority records occur exactly once and contain an explicit decision plus bounds.
authority_fields_ok() {
    awk '
      BEGIN {
        split("Edit authority|Disposable prototype authority|External-action/message authority|Push authority|Merge authority|Issue-close authority|Claim-terminal authority|Cleanup authority", fields, "|")
      }
      /^- (Edit authority|Disposable prototype authority|External-action\/message authority|Push authority|Merge authority|Issue-close authority|Claim-terminal authority|Cleanup authority):/ {
        line=$0; sub(/^- /, "", line); split(line, pair, ": "); name=pair[1]; seen[name]++
        value=substr(line, length(name)+3)
        if (value !~ /^<(YES \| NO)> — <[^>]+>$/ && value !~ /^(YES|NO) — .+$/) {
          print "authority value requires explicit YES/NO and nonempty bounds field=" name " actual=" value > "/dev/stderr"; bad=1
        }
      }
      END {
        for (i=1;i<=8;i++) if (seen[fields[i]] != 1) {
          print "authority field cardinality expected=1 actual=" seen[fields[i]] " field=" fields[i] > "/dev/stderr"; bad=1
        }
        exit bad
      }
    ' "$1"
}
if authority_fields_ok "$PACKET" 2>"$TMP/authority.packet.err"; then
    pass "task packet names each authority exactly once with decision and bounds"
else
    fail "task packet authority schema invalid: $(tr '\n' ';' <"$TMP/authority.packet.err")"
fi
printf '%s\n' '- Edit authority: YES — user-goal; edit; file-a; after-valid-claim' '- Disposable prototype authority: NO — no grant' '- External-action/message authority: NO — no grant' '- Push authority: YES — user-goal; push; branch-a; after-tests' '- Merge authority: NO — no grant' '- Issue-close authority: NO — no grant' '- Claim-terminal authority: NO — no grant' '- Cleanup authority: NO — no grant' >"$TMP/authority.good"
if authority_fields_ok "$TMP/authority.good"; then pass "valid concrete task authority fixture passes"; else fail "valid concrete task authority fixture rejected"; fi
sed 's/Edit authority: YES — user-goal; edit; file-a; after-valid-claim/Edit authority:/' "$TMP/authority.good" >"$TMP/authority.empty"
expect_reject "empty authority value is rejected" "authority value requires explicit YES/NO" authority_fields_ok "$TMP/authority.empty"
grep -v 'Merge authority:' "$TMP/authority.good" >"$TMP/authority.missing"
expect_reject "missing authority field is rejected" "authority field cardinality" authority_fields_ok "$TMP/authority.missing"
{ sed -n '1p' "$TMP/authority.good"; sed -n '1,8p' "$TMP/authority.good"; } >"$TMP/authority.duplicate"
expect_reject "duplicate authority field is rejected" "authority field cardinality" authority_fields_ok "$TMP/authority.duplicate"

authority_grant_ok() {
    source=$1 granted_action=$2 requested_action=$3 source_bound=$4 delegated_bound=$5 prerequisites=$6
    case "$source" in controlling-user-instruction|immutable-owner-grant) ;; *) printf 'authority source expected=controlling-grant actual=%s\n' "$source" >&2; return 1 ;; esac
    if test "$granted_action" != "$requested_action"; then printf 'authority action mismatch granted=%s requested=%s\n' "$granted_action" "$requested_action" >&2; return 1; fi
    if test "$source_bound" != "$delegated_bound"; then printf 'authority bounds exceed source expected=%s actual=%s\n' "$source_bound" "$delegated_bound" >&2; return 1; fi
    if test -z "$prerequisites" || test "$prerequisites" = missing; then printf 'authority prerequisites expected=nonempty actual=%s\n' "$prerequisites" >&2; return 1; fi
}
if authority_grant_ok controlling-user-instruction push push branch-a branch-a tests-pass; then pass "bounded controlling instruction delegates matching authority"; else fail "valid authority provenance rejected"; fi
expect_reject "absent authority source is rejected" "source expected=controlling-grant" authority_grant_ok missing push push branch-a branch-a tests-pass
expect_reject "self-referential packet source is rejected" "source expected=controlling-grant" authority_grant_ok task-packet push push branch-a branch-a tests-pass
expect_reject "role does not grant packet authority" "source expected=controlling-grant" authority_grant_ok coordinator-role push push branch-a branch-a tests-pass
expect_reject "readiness does not grant packet authority" "source expected=controlling-grant" authority_grant_ok READY push push branch-a branch-a tests-pass
expect_reject "review does not grant packet authority" "source expected=controlling-grant" authority_grant_ok clean-review push push branch-a branch-a tests-pass
expect_reject "CI does not grant packet authority" "source expected=controlling-grant" authority_grant_ok green-CI push push branch-a branch-a tests-pass
expect_reject "wrong-action authority source is rejected" "authority action mismatch" authority_grant_ok controlling-user-instruction edit merge file-a file-a tests-pass
expect_reject "overbroad delegated target is rejected" "authority bounds exceed source" authority_grant_ok controlling-user-instruction push push branch-a all-branches tests-pass
expect_reject "missing authority prerequisites are rejected" "prerequisites expected=nonempty" authority_grant_ok controlling-user-instruction push push branch-a branch-a missing
require_text "task packets require authority grantor provenance" 'Every `YES` must identify an immutable or controlling grantor/source' "$PACKET"
require_text "task packets make ambiguous authority NO" 'Ambiguity is recorded `NO`' "$PACKET"

# Completion records preserve the successful prefix cursor across the existing eight events.
# Row fields are step|event|identity|status|claim|worktree|issue|evidence.
completion_history_ok() {
    file=$1 expected_cursor=$2 expected_state=$3
    awk -F '|' -v expected_cursor="$expected_cursor" -v expected_state="$expected_state" '
      BEGIN { events[1]="merge-current-main"; events[2]="tree-tests-ci"; events[3]="claim-terminal"; events[4]="safe-cleanup"; events[5]="issue-closure"; events[6]="post-closure-frontier"; events[7]="retrospective"; events[8]="immutable-digest" }
      NF != 8 { print "completion row field count expected=8 actual=" NF " line=" NR > "/dev/stderr"; bad=1; next }
      $4 == "FAILED" { if ($1 != cursor+1) { print "failed attempt step expected=" cursor+1 " actual=" $1 > "/dev/stderr"; bad=1 }; failed[$1]++; next }
      $4 != "SUCCESS" { print "completion status expected=SUCCESS-or-FAILED actual=" $4 " step=" $1 > "/dev/stderr"; bad=1; next }
      {
        expected_step=cursor+1
        if ($1 != expected_step) { print "completion step expected=" expected_step " actual=" $1 " line=" NR > "/dev/stderr"; bad=1; next }
        if ($2 != events[$1]) { print "completion event expected=" events[$1] " actual=" $2 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($3 != "id-" $1) { print "completion identity expected=id-" $1 " actual=" $3 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 < 3 && $5 != "active") { print "completion claim expected=active before step3 actual=" $5 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 >= 3 && $5 != "terminal") { print "completion claim expected=terminal from step3 actual=" $5 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 < 4 && $6 != "preserved") { print "completion worktree expected=preserved before step4 actual=" $6 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 >= 4 && $6 != "removed") { print "completion worktree expected=removed from step4 actual=" $6 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 < 5 && $7 != "open") { print "completion issue expected=open before step5 actual=" $7 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 >= 5 && $7 != "closed") { print "completion issue expected=closed from step5 actual=" $7 " step=" $1 > "/dev/stderr"; bad=1 }
        if ($1 == 6 && $8 != "scan-recorded") { print "completion step6 evidence expected=scan-recorded actual=" $8 > "/dev/stderr"; bad=1 }
        if ($1 == 7 && $8 != "retrospective-recorded") { print "completion step7 evidence expected=retrospective-recorded actual=" $8 > "/dev/stderr"; bad=1 }
        if ($1 == 8 && $8 != "verified-immutable-sha256") { print "completion step8 evidence expected=verified-immutable-sha256 actual=" $8 > "/dev/stderr"; bad=1 }
        cursor=$1
      }
      END {
        if (cursor != expected_cursor) { print "completion cursor expected=" expected_cursor " actual=" cursor > "/dev/stderr"; bad=1 }
        if (expected_state == "COMPLETION_IN_PROGRESS" && (cursor < 2 || cursor > 7)) { print "completion state/cursor disagreement state=" expected_state " cursor=" cursor > "/dev/stderr"; bad=1 }
        if (expected_state == "COMPLETE" && cursor != 8) { print "completion state/cursor disagreement state=" expected_state " cursor=" cursor > "/dev/stderr"; bad=1 }
        exit bad
      }
    ' "$file"
}
printf '%s\n' \
 '1|merge-current-main|id-1|SUCCESS|active|preserved|open|merge-proof' \
 '2|tree-tests-ci|id-2|SUCCESS|active|preserved|open|tree-proof' \
 '3|claim-terminal|id-3|SUCCESS|terminal|preserved|open|terminal-proof' \
 '4|safe-cleanup|id-4|SUCCESS|terminal|removed|open|cleanup-proof' \
 '5|issue-closure|id-5|SUCCESS|terminal|removed|closed|closure-proof' \
 '6|post-closure-frontier|id-6|SUCCESS|terminal|removed|closed|scan-recorded' \
 '7|retrospective|id-7|SUCCESS|terminal|removed|closed|retrospective-recorded' \
 '8|immutable-digest|id-8|SUCCESS|terminal|removed|closed|verified-immutable-sha256' >"$TMP/complete"
cursor=2
while test "$cursor" -le 7; do
    sed -n "1,${cursor}p" "$TMP/complete" >"$TMP/complete-prefix"
    if completion_history_ok "$TMP/complete-prefix" "$cursor" COMPLETION_IN_PROGRESS; then pass "completion cursor $cursor accepts exact successful prefix"; else fail "valid completion prefix rejected cursor=$cursor"; fi
    cursor=$((cursor + 1))
done
if completion_history_ok "$TMP/complete" 8 COMPLETE; then pass "step 8 alone transitions cursor 7 to COMPLETE"; else fail "valid complete history rejected"; fi
sed -n '1p' "$TMP/complete" >"$TMP/complete-entry-short"
expect_reject "completion accounting entry requires steps 1 and 2" "completion cursor expected=2 actual=1" completion_history_ok "$TMP/complete-entry-short" 2 COMPLETION_IN_PROGRESS
{ sed -n '1p' "$TMP/complete"; sed -n '3p' "$TMP/complete"; } >"$TMP/complete-skipped"
expect_reject "skipped successful step is rejected" "completion step expected=2 actual=3" completion_history_ok "$TMP/complete-skipped" 3 COMPLETION_IN_PROGRESS
{ sed -n '1,2p' "$TMP/complete"; sed -n '2p' "$TMP/complete"; } >"$TMP/complete-duplicate"
expect_reject "duplicated successful step is rejected" "completion step expected=3 actual=2" completion_history_ok "$TMP/complete-duplicate" 2 COMPLETION_IN_PROGRESS
{ sed -n '2p' "$TMP/complete"; sed -n '1p' "$TMP/complete"; } >"$TMP/complete-reordered"
expect_reject "reordered successful steps are rejected" "completion step expected=1 actual=2" completion_history_ok "$TMP/complete-reordered" 2 COMPLETION_IN_PROGRESS
sed '2s/id-2/wrong-id/' "$TMP/complete" | sed -n '1,2p' >"$TMP/complete-wrong-id"
expect_reject "wrong-identity successful step is rejected" "completion identity expected=id-2 actual=wrong-id" completion_history_ok "$TMP/complete-wrong-id" 2 COMPLETION_IN_PROGRESS
sed -n '1,2p' "$TMP/complete" >"$TMP/complete-cursor-two"
expect_reject "cursor/state disagreement is rejected" "completion cursor expected=3 actual=2" completion_history_ok "$TMP/complete-cursor-two" 3 COMPLETION_IN_PROGRESS
sed '2s/|active|/|terminal|/' "$TMP/complete" | sed -n '1,2p' >"$TMP/complete-early-terminal"
expect_reject "claim terminal before step 3 is rejected" "claim expected=active before step3" completion_history_ok "$TMP/complete-early-terminal" 2 COMPLETION_IN_PROGRESS
sed '3s/|terminal|/|active|/' "$TMP/complete" | sed -n '1,3p' >"$TMP/complete-late-active"
expect_reject "active claim after step 3 is rejected" "claim expected=terminal from step3" completion_history_ok "$TMP/complete-late-active" 3 COMPLETION_IN_PROGRESS
sed '3s/|preserved|/|removed|/' "$TMP/complete" | sed -n '1,3p' >"$TMP/complete-early-cleanup"
expect_reject "cleanup before step 4 is rejected" "worktree expected=preserved before step4" completion_history_ok "$TMP/complete-early-cleanup" 3 COMPLETION_IN_PROGRESS
sed '4s/|removed|/|preserved|/' "$TMP/complete" | sed -n '1,4p' >"$TMP/complete-missing-cleanup"
expect_reject "step 4 without removed worktree is rejected" "worktree expected=removed from step4" completion_history_ok "$TMP/complete-missing-cleanup" 4 COMPLETION_IN_PROGRESS
sed '4s/|open|/|closed|/' "$TMP/complete" | sed -n '1,4p' >"$TMP/complete-early-close"
expect_reject "closure before step 5 is rejected" "issue expected=open before step5" completion_history_ok "$TMP/complete-early-close" 4 COMPLETION_IN_PROGRESS
sed '5s/|closed|/|open|/' "$TMP/complete" | sed -n '1,5p' >"$TMP/complete-open-after-close"
expect_reject "open issue after step 5 is rejected" "issue expected=closed from step5" completion_history_ok "$TMP/complete-open-after-close" 5 COMPLETION_IN_PROGRESS
sed '6s/scan-recorded/missing/' "$TMP/complete" | sed -n '1,6p' >"$TMP/complete-no-scan"
expect_reject "missing post-closure scan at step 6 is rejected" "step6 evidence expected=scan-recorded" completion_history_ok "$TMP/complete-no-scan" 6 COMPLETION_IN_PROGRESS
sed '7s/retrospective-recorded/missing/' "$TMP/complete" | sed -n '1,7p' >"$TMP/complete-no-retrospective"
expect_reject "missing retrospective at step 7 is rejected" "step7 evidence expected=retrospective-recorded" completion_history_ok "$TMP/complete-no-retrospective" 7 COMPLETION_IN_PROGRESS
sed '8s/verified-immutable-sha256/missing/' "$TMP/complete" >"$TMP/complete-no-digest"
expect_reject "completion without verified immutable digest is rejected" "step8 evidence expected=verified-immutable-sha256" completion_history_ok "$TMP/complete-no-digest" 8 COMPLETE
step=1
while test "$step" -le 8; do
    awk -F '|' -v step="$step" '$1 != step' "$TMP/complete" >"$TMP/complete-step-missing"
    expect_reject "completion step $step omission is rejected" "completion" completion_history_ok "$TMP/complete-step-missing" 8 COMPLETE
    awk -F '|' -v step="$step" '{ print; if ($1 == step) print }' "$TMP/complete" >"$TMP/complete-step-duplicate"
    expect_reject "completion step $step duplication is rejected" "completion step expected=" completion_history_ok "$TMP/complete-step-duplicate" 8 COMPLETE
    awk -F '|' -v step="$step" 'BEGIN { OFS="|" } { if ($1 == step) $3="wrong-id"; print }' "$TMP/complete" >"$TMP/complete-step-wrong-id"
    expect_reject "completion step $step wrong identity is rejected" "completion identity expected=id-$step actual=wrong-id" completion_history_ok "$TMP/complete-step-wrong-id" 8 COMPLETE
    step=$((step + 1))
done
step=1
while test "$step" -le 7; do
    awk -v step="$step" 'NR == step { held=$0; next } NR == step+1 { print; print held; next } { print }' "$TMP/complete" >"$TMP/complete-step-reordered"
    expect_reject "completion steps $step/$((step + 1)) reordering is rejected" "completion step expected=$step actual=$((step + 1))" completion_history_ok "$TMP/complete-step-reordered" 8 COMPLETE
    step=$((step + 1))
done
{ sed -n '1,2p' "$TMP/complete"; printf '%s\n' '3|claim-terminal|attempt-bad|FAILED|active|preserved|open|wrong-author'; sed -n '3p' "$TMP/complete"; } >"$TMP/complete-retry"
if completion_history_ok "$TMP/complete-retry" 3 COMPLETION_IN_PROGRESS; then pass "failed accounting attempt remains visible without advancing before corrected retry"; else fail "valid same-step accounting retry rejected"; fi

completion_wait_resume_ok() {
    cursor=$1 before_issue=$2 after_issue=$3 before_claim=$4 after_claim=$5 before_worktree=$6 after_worktree=$7
    test "$before_issue" = "$after_issue" && test "$before_claim" = "$after_claim" && test "$before_worktree" = "$after_worktree" || { printf 'completion wait rewrote history cursor=%s issue=%s/%s claim=%s/%s worktree=%s/%s\n' "$cursor" "$before_issue" "$after_issue" "$before_claim" "$after_claim" "$before_worktree" "$after_worktree" >&2; return 1; }
}
if completion_wait_resume_ok 2 open open active active preserved preserved; then pass "external wait/resume preserves open completion cursor history"; else fail "open-cursor wait/resume rejected"; fi
if completion_wait_resume_ok 6 closed closed terminal terminal removed removed; then pass "external wait/resume preserves closed completion cursor history"; else fail "closed-cursor wait/resume rejected"; fi
expect_reject "completion wait cannot rewrite open cursor history" "completion wait rewrote history" completion_wait_resume_ok 2 open closed active active preserved preserved
completion_block_destination_ok() { test "$2" = COMPLETION_IN_PROGRESS || { printf 'completion blocked exit expected=COMPLETION_IN_PROGRESS actual=%s cursor=%s\n' "$2" "$1" >&2; return 1; }; }
for cursor in 2 3 4 5 6 7; do expect_reject "completion cursor $cursor cannot be declined after external wait" "completion blocked exit expected=COMPLETION_IN_PROGRESS" completion_block_destination_ok "$cursor" DECLINED; done

require_text "policy orders merge/current-main first" '1. Merge PR #542 into then-current `main`' "$SKILL" "$READINESS"
require_text "policy orders claim terminal before cleanup" "3. Publish and verify the issuer-authorized" "$SKILL"
require_text "policy orders cleanup before closure" "4. Remove only the clean, pushed, fully integrated" "$SKILL"
require_text "policy orders closure before frontier" "6. Recompute repository-wide claims and the ready frontier after closure" "$SKILL"
require_text "policy orders retrospective after frontier" "7. Publish the immutable retrospective/completion comment" "$SKILL"
require_text "policy requires final retrieval and digest" "8. Retrieve it, verify it is unedited" "$SKILL"
require_text "issue 543 lifecycle is never consulted" "Issue #543 is independent: its lifecycle state is never" "$SKILL" "$READINESS"

# Completion consumes only #542/#406 evidence; issue #543 lifecycle is not an input.
outcome_complete() {
    test "$1" = integrated-and-accounted && test "$2" = complete
}
for issue543_state in open closed declined blocked complete other-independent; do
    if outcome_complete integrated-and-accounted complete "$issue543_state"; then
        pass "PR542/issue406 result is invariant when independent issue #543 is $issue543_state"
    else
        fail "issue #543 lifecycle leaked into completion input state=$issue543_state"
    fi
done
independence_ok() {
    relationship=$1
    test "$relationship" = no-gate-successor-proof-path || {
        printf 'issue543 relationship expected=no-gate-successor-proof-path actual=%s\n' "$relationship" >&2
        return 1
    }
}
if independence_ok no-gate-successor-proof-path; then pass "issue #543 relationship check permits only complete independence"; else fail "valid issue #543 independence rejected"; fi
expect_reject "issue #543 dependency edge is rejected" "relationship expected=no-gate-successor-proof-path" independence_ok acceptance-gate

# The standard Documentation workflow must invoke this exact script and trigger for every owning
# policy path on both pull requests and main pushes.
workflow_protocol_gate_ok() {
    workflow_file=$1
    awk '
      /^  pull_request:/ { mode="pull"; next }
      /^  push:/ { mode="push"; next }
      /^permissions:/ { mode="" }
      mode != "" && /^      - "/ { line=$0; sub(/^      - "/, "", line); sub(/"$/, "", line); seen[mode,line]++ }
      $0 == "      - run: .agents/skills/finch-backlog/scripts/test-review-protocol \"$GITHUB_WORKSPACE\"" { invocation++ }
      END {
        split(".agents/skills/finch-backlog/SKILL.md .agents/skills/finch-backlog/references/review-protocol.md .agents/skills/finch-backlog/references/solution-contract.md .agents/skills/finch-backlog/references/issue-readiness.md .agents/skills/finch-backlog/references/task-packet.md .agents/skills/finch-backlog/references/work-claims.md .agents/skills/finch-backlog/scripts/test-review-protocol", paths, " ")
        for (i=1;i<=7;i++) for (j=1;j<=2;j++) { mode_name=(j==1?"pull":"push"); if (seen[mode_name,paths[i]] != 1) { print "Documentation trigger cardinality expected=1 actual=" seen[mode_name,paths[i]] " event=" mode_name " path=" paths[i] > "/dev/stderr"; bad=1 } }
        if (invocation != 1) { print "Documentation focused invocation cardinality expected=1 actual=" invocation > "/dev/stderr"; bad=1 }
        exit bad
      }
    ' "$workflow_file"
}
if workflow_protocol_gate_ok "$WORKFLOW" 2>"$TMP/workflow.good.err"; then pass "Documentation workflow automatically runs focused policy gate for all owning paths"; else fail "valid Documentation workflow gate rejected: $(tr '\n' ';' <"$TMP/workflow.good.err")"; fi
for owned_path in .agents/skills/finch-backlog/SKILL.md .agents/skills/finch-backlog/references/review-protocol.md .agents/skills/finch-backlog/references/solution-contract.md .agents/skills/finch-backlog/references/issue-readiness.md .agents/skills/finch-backlog/references/task-packet.md .agents/skills/finch-backlog/references/work-claims.md .agents/skills/finch-backlog/scripts/test-review-protocol; do
    awk -v target="      - \"$owned_path\"" 'BEGIN { removed=0 } $0 == target && !removed { removed=1; next } { print }' "$WORKFLOW" >"$TMP/workflow-missing-pull"
    expect_reject "Documentation pull trigger omission is rejected path=$owned_path" "event=pull path=$owned_path" workflow_protocol_gate_ok "$TMP/workflow-missing-pull"
    awk -v target="      - \"$owned_path\"" '{ if ($0 == target) occurrences++; if ($0 == target && occurrences == 2) next; print }' "$WORKFLOW" >"$TMP/workflow-missing-push"
    expect_reject "Documentation push trigger omission is rejected path=$owned_path" "event=push path=$owned_path" workflow_protocol_gate_ok "$TMP/workflow-missing-push"
done
grep -v 'test-review-protocol "\$GITHUB_WORKSPACE"' "$WORKFLOW" >"$TMP/workflow-missing-invocation"
expect_reject "Documentation focused invocation omission is rejected" "focused invocation cardinality expected=1 actual=" workflow_protocol_gate_ok "$TMP/workflow-missing-invocation"

# Pure fixtures stay bound to their single operative policy sections. Removing the section heading
# or contradicting its rule makes the focused gate fail even though helper code is unchanged.
policy_section_ok() {
    section_file=$1 section_heading=$2 section_anchor=$3
    awk -v heading="$section_heading" -v anchor="$section_anchor" '
      $0 == heading { sections++; inside=1; next }
      inside && /^## / { inside=0 }
      inside && index($0, anchor) { anchors++ }
      index($0, "CONTRADICTORY-POLICY-MUTATION") { contradiction=1 }
      END {
        if (sections != 1) { print "operative section cardinality expected=1 actual=" sections " heading=" heading > "/dev/stderr"; bad=1 }
        if (anchors < 1) { print "operative section anchor missing heading=" heading " anchor=" anchor > "/dev/stderr"; bad=1 }
        if (contradiction) { print "operative section contradiction heading=" heading " anchor=" anchor > "/dev/stderr"; bad=1 }
        exit bad
      }
    ' "$section_file"
}
printf '%s\n' \
 "$READINESS|## Procedural READY checklist|No script or synthetic fixture may turn" \
 "$READINESS|## Production admission checklist|A readiness record is never a claim." \
 "$REVIEW|## Record and verify findings|Each predecessor has at most one direct successor." \
 "$READINESS|## Repair and successor checklist|separately defined expected inventory" \
 "$READINESS|## Lifecycle|may then close while remaining" \
 "$CLAIMS|### Resolve a corroborated malformed attempt|canonical" \
 "$REVIEW|## Repair and converge finitely|append-only ledger keyed by stable finding ID" \
 "$REVIEW|## Repair and converge finitely|finite convergence rule is exact" \
 "$CLAIMS|## Scope expansion and conservative handoff|reserve one unused lowercase replacement UUID" >"$TMP/policy-sections"
section_number=0
while IFS='|' read -r policy_file heading anchor; do
    section_number=$((section_number + 1))
    if policy_section_ok "$policy_file" "$heading" "$anchor"; then pass "operative policy section $section_number is bound to its fixture"; else fail "operative policy section rejected heading=$heading anchor=$anchor"; fi
    awk -v heading="$heading" '$0 != heading' "$policy_file" >"$TMP/policy-section-deleted"
    expect_reject "operative policy section $section_number deletion is rejected" "operative section cardinality expected=1 actual=" policy_section_ok "$TMP/policy-section-deleted" "$heading" "$anchor"
    cp "$policy_file" "$TMP/policy-section-contradicted"
    printf '%s\n' "CONTRADICTORY-POLICY-MUTATION: $anchor" >>"$TMP/policy-section-contradicted"
    expect_reject "operative policy section $section_number contradiction is rejected" "operative section contradiction" policy_section_ok "$TMP/policy-section-contradicted" "$heading" "$anchor"
done <"$TMP/policy-sections"

policy_authority_ok() {
    if grep -E -i -q 'passing (the )?(script|linter).*(is sufficient|authori[sz]es|grants).*(READY|ownership|merge)' "$1"; then
        printf 'semantic linter-authority contradiction found file=%s\n' "$1" >&2
        return 1
    fi
}
if policy_authority_ok "$READINESS"; then pass "operative readiness policy contains no semantic linter-authority grant"; else fail "current readiness policy grants linter authority"; fi
cp "$READINESS" "$TMP/readiness-authority-contradiction"
printf '%s\n' 'Passing the linter is sufficient to record READY.' >>"$TMP/readiness-authority-contradiction"
expect_reject "semantic linter-authority mutation is rejected" "semantic linter-authority contradiction" policy_authority_ok "$TMP/readiness-authority-contradiction"

if test "$failures" -ne 0; then
    printf 'FAILED: %s of %s policy checks failed for root %s\n' "$failures" "$checks" "$ROOT" >&2
    exit 1
fi
printf 'PASS: %s policy checks; linter supplies no ownership/authentication/merge authority\n' "$checks"
