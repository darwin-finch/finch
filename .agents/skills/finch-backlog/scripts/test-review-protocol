raw_round = parsed_block(round_raw, "round-url", 32, "alice", "2026-01-10T00:00:00Z", pull_request=542)
prior_round_raw = (round_raw.replace("event-id: review-event", "event-id: prior-review-event")
    .replace("round-id: round", "round-id: prior-round")
    .replace("round-number: 3", "round-number: 2")
    .replace("status: CONVERGED", "status: VERIFICATION")
    .replace("verdict: SAFE_TO_MERGE", "verdict: none")
    .replace("fresh-clean-pass: true", "fresh-clean-pass: false")
    .replace("prior-zero-ledger-round-id: prior-round", "prior-zero-ledger-round-id: none"))
prior_raw_round = parsed_block(prior_round_raw, "prior-round-url", 31, "alice", "2026-01-09T12:00:00Z", pull_request=542)
expected_review = {"issue":406, "pull_request":542, "claim_id":"claim", "contract_id":"contract",
                   "ledger_id":"ledger", "exact_tip":tip_sha}
review_result = wp.reduce_review_history([prior_raw_round, raw_round], [], expected_review)
check(review_result.safe_to_merge, f"raw zero-ledger clean round did not converge: {review_result.diagnostics}")

context = dict(raw_authority, issue=406, owner="alice", roles_by_actor={"alice":["contract_owner", "coordinator", "claim_worker"]},
    contract_id="contract", contract_digest=raw_contract["body_digest"], contract_revision=11,
    implementation_base=base_sha, claim_id="claim", ledger_id="ledger", round_id="round",
    exact_tip=tip_sha, integration_base=base_sha,
    contracts_by_url={"contract-url":raw_contract}, approvals_by_url={"approval-url":raw_approval},
    claims_by_url={"claim-url":raw_claim}, evidence_by_url={e["url"]:e for e in
    (ready_evidence, progress_evidence, merge_evidence, complete_evidence)}, review_reduction=review_result)
merge_event = readiness_raw("merge", "progress", "IN_PROGRESS", "READY_TO_MERGE", merge_evidence, 33, "2026-01-11T00:00:00Z")
complete_event = readiness_raw("complete", "merge", "READY_TO_MERGE", "COMPLETE", complete_evidence, 34, "2026-01-12T00:00:00Z")
raw_readiness = wp.reduce_readiness([ready_event, progress_event, merge_event, complete_event], context)
check(raw_readiness.state == "COMPLETE", f"documented raw readiness history did not complete: {raw_readiness.diagnostics}")

# Cross-issue and every one-axis COMPLETE mutant remain at READY_TO_MERGE.
foreign_evidence = evidence_raw("complete", complete_fields, "foreign-complete", 40, "2026-01-13T00:00:00Z", issue=999)
foreign_complete = readiness_raw("foreign", "merge", "READY_TO_MERGE", "COMPLETE", foreign_evidence, 41,
                                 "2026-01-14T00:00:00Z", issue=999)
foreign_context = dict(context, evidence_by_url=dict(context["evidence_by_url"], **{"foreign-complete":foreign_evidence}))
foreign_result = wp.reduce_readiness([ready_event, progress_event, merge_event, foreign_complete], foreign_context)
check(foreign_result.state == "READY_TO_MERGE", "cross-issue COMPLETE event was admitted")
for offset, (identity_key, wrong_value) in enumerate((("contract_id","other"), ("claim_id","other"),
        ("ledger_id","other"), ("round_id","other"), ("exact_tip","c"*40)), 42):
    wrong = readiness_raw(f"wrong-{identity_key}", "merge", "READY_TO_MERGE", "COMPLETE", complete_evidence,
                          offset, f"2026-01-{offset-27:02d}T00:00:00Z",
                          identity_overrides={identity_key:wrong_value})
    result = wp.reduce_readiness([ready_event, progress_event, merge_event, wrong], context)
    check(result.state == "READY_TO_MERGE", f"mismatched raw {identity_key} reached COMPLETE")
for offset, missing in enumerate(complete_fields, 50):
    fields = dict(complete_fields); fields[missing] = False
    evidence = evidence_raw("complete", fields, f"complete-{missing}", offset, f"2026-02-{offset-49:02d}T00:00:00Z")
    event = readiness_raw(f"complete-{missing}", "merge", "READY_TO_MERGE", "COMPLETE", evidence,
                          offset + 20, f"2026-03-{offset-49:02d}T00:00:00Z")
    mutant_context = dict(context, evidence_by_url=dict(context["evidence_by_url"], **{evidence["url"]:evidence}))
    result = wp.reduce_readiness([ready_event, progress_event, merge_event, event], mutant_context)
    check(result.state == "READY_TO_MERGE", f"raw COMPLETE admitted without {missing}")

# Raw terminal streams produce PAIRING_REQUIRED until an exact later readiness pair exists.
