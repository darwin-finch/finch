open_finding = parsed_block(open_finding_raw, "finding-url", 111, "bob", "2026-07-02T00:00:00Z", pull_request=542)
round_with_open = dict(raw_round, finding_event_ids=["open-finding-event"])
open_review = wp.reduce_review_history([prior_raw_round, round_with_open], [open_finding], expected_review)
check(not open_review.safe_to_merge, "CONVERGED raw round with open blocker reached SAFE_TO_MERGE")
foreign_finding = dict(open_finding, issue=999)
foreign_review = wp.reduce_review_history([prior_raw_round, round_with_open], [foreign_finding], expected_review)
check(not foreign_review.safe_to_merge and foreign_review.diagnostics, "foreign raw finding entered converged ledger")

# Raw proxy/terminal/legacy evidence is closed, actor-bound, and boolean-typed.
bad_event_terminal = dict(raw_terminal, event="complete", disposition="return-ready")
bad_event_terminal = wp.prepare_terminal_event(bad_event_terminal, raw_claim, release_evidence)
check(not wp.terminal_event_valid(bad_event_terminal), "raw event/disposition mismatch authorized terminal")
false_success = evidence_raw("slice-complete", {"reached_ready_to_merge":True, "merge_proof":False},
                             "false-success", 120, "2026-08-01T00:00:00Z")
slice_terminal = dict(raw_terminal, event="complete", disposition="slice-complete",
                      evidence_digest=false_success["body_digest"], evidence_url="false-success")
slice_terminal = wp.prepare_terminal_event(slice_terminal, raw_claim, false_success)
check(not wp.terminal_event_valid(slice_terminal), "string false merge proof authorized slice completion")
false_supersession = evidence_raw("outcome-superseded", {"atomic_transfer":True, "replacement_packet":False},
                                  "false-supersession", 124, "2026-08-01T06:00:00Z")
supersede_terminal = dict(raw_terminal, event="supersede", disposition="outcome-superseded",
    evidence_digest=false_supersession["body_digest"], evidence_url="false-supersession")
supersede_terminal = wp.prepare_terminal_event(supersede_terminal, raw_claim, false_supersession)
check(not wp.terminal_event_valid(supersede_terminal), "unproven raw whole-outcome supersession authorized terminal")
delegation = {"created_at":"2026-01-01T00:00:00Z", "claim_id":"claim", "operation":"release",
              "substitute_actor":"mallory", "disposition":"return-ready"}
proxy_terminal = dict(raw_terminal, author="proxy")
proxy_terminal = wp.prepare_terminal_event(proxy_terminal, raw_claim, release_evidence, delegation)
check(not wp.terminal_event_valid(proxy_terminal), "delegation naming another substitute authorized proxy")
scope_raw = """<!-- finch-work-claim:v1
event: scope-revise
claim-id: claim
worker: claim-worker
prior-scope: workflow
new-scope: workflow-narrow
contract-id: contract
contract-url: contract-url
contract-revision: 11
approval-url: approval-url
timestamp: 2026-08-01T12:00:00Z
authority-comment: delegation-url
-->"""
raw_scope = parsed_block(scope_raw, "scope-url", 123, "proxy", "2026-08-01T12:00:00Z")
delegation_raw = """<!-- finch-workflow-authority:v1
claim-id: claim
operation: scope-revise
substitute-actor: proxy
new-scope: workflow-narrow
contract-revision: 11
timestamp: 2026-08-01T00:00:00Z
-->"""
raw_delegation = parsed_block(delegation_raw, "delegation-url", 122, "alice", "2026-08-01T00:00:00Z")
prepared_scope = wp.prepare_scope_revision(raw_scope, raw_claim, raw_contract, raw_approval,
                                           raw_authority, raw_delegation, True)
check(wp.scope_revision_allowed(prepared_scope), "raw exact scope proxy delegation was rejected")
wrong_delegate = dict(raw_delegation, substitute_actor="mallory")
check(not wp.scope_revision_allowed(wp.prepare_scope_revision(raw_scope, raw_claim, raw_contract,
      raw_approval, raw_authority, wrong_delegate, True)), "raw delegation naming another scope proxy was accepted")
legacy_fields = {"cutover_identity":"cutover", "cutover_created_at":"2026-01-02T00:00:00Z",
    "claim_created_at":"2026-01-01T00:00:00Z", "claim_predates_cutover":True, "preserved_claim":"claim",
    "preserved_pr":"pr", "preserved_branch":"branch", "preserved_worktree":"worktree", "preserved_tip":"tip",
    "preserved_base":"base", "approved_contract":"contract", "collision_recheck":True, "exact_tip_review":True}
legacy_evidence = evidence_raw("legacy-bootstrap", legacy_fields, "legacy-evidence", 121, "2026-08-02T00:00:00Z")
check(wp.legacy_bootstrap_valid(legacy_evidence), "complete raw legacy bootstrap evidence was rejected")
false_legacy = evidence_raw("legacy-bootstrap", dict(legacy_fields, claim_predates_cutover=False),
                            "false-legacy", 122, "2026-08-03T00:00:00Z")
check(not wp.legacy_bootstrap_valid(false_legacy), "string false pre-cutover evidence authorized legacy bootstrap")
late_legacy = evidence_raw("legacy-bootstrap", dict(legacy_fields, claim_created_at="2026-01-03T00:00:00Z"),
                           "late-legacy", 125, "2026-08-04T00:00:00Z")
check(not wp.legacy_bootstrap_valid(late_legacy), "post-cutover claim timestamp authorized legacy bootstrap")

# The original explicit contradictory-policy mutant must be rejected.
mutant = "production may begin before READY; CRITICAL automatically cancels; SPLIT-TO immediately resolves; COMPLETE does not require user-visible proof"
check(set(wp.policy_contradictions(mutant)) == {"pre-ready production", "severity cancellation", "immediate successor discharge", "proofless completion"},
      "explicit contradictory workflow mutant was not rejected")

