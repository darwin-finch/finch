#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: with-cargo-slot <command> [args...]" >&2
}

verify_only=0
if [[ "${1:-}" == --verify-held ]]; then
    verify_only=1
    shift
fi
if [[ $# -eq 0 && "$verify_only" -eq 0 ]]; then
    usage
    exit 64
fi

if ! git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    echo "with-cargo-slot: run from a Finch Git worktree" >&2
    exit 69
fi
if ! git_common_dir="$(cd "$git_common_dir" 2>/dev/null && pwd -P)"; then
    echo "with-cargo-slot: could not canonicalize the Git common directory" >&2
    exit 69
fi

lock_path="$git_common_dir/finch-cargo-slot.lock"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"

# Shell startup files are not reliably loaded by local agents. Choose one
# deterministic mutable target for every linked worktree unless the caller
# explicitly selected one. CI already owns its workspace/cache target layout,
# so leave an unset target untouched there instead of bypassing restored build
# artifacts. The Git common directory is already the local lock domain, so
# hashing its canonical identity also keeps unrelated clones from racing on
# the same target artifacts by default.
if [[ "${CARGO_TARGET_DIR+x}" != x && -z "${CI:-}" ]]; then
    if [[ -n "${XDG_CACHE_HOME:-}" && "$XDG_CACHE_HOME" == /* ]]; then
        cargo_cache_root="$XDG_CACHE_HOME"
    else
        if [[ -z "${HOME:-}" || "$HOME" != /* ]]; then
            echo "with-cargo-slot: HOME must be an absolute path when XDG_CACHE_HOME is unset or relative" >&2
            exit 69
        fi
        cargo_cache_root="$HOME/.cache"
    fi
    if ! target_namespace="$(perl -MDigest::SHA=sha256_hex -e \
        'print sha256_hex($ARGV[0])' "$git_common_dir")"; then
        echo "with-cargo-slot: could not derive the Cargo target namespace" >&2
        exit 69
    fi
    CARGO_TARGET_DIR="$cargo_cache_root/cargo-target/$target_namespace"
    if ! mkdir -p -- "$CARGO_TARGET_DIR"; then
        echo "with-cargo-slot: could not create Cargo target directory: path=$CARGO_TARGET_DIR" >&2
        exit 69
    fi
    export CARGO_TARGET_DIR
fi

lock_marker="${FINCH_CARGO_SLOT_HELD:-}"

slot_marker_is_live() {
    local owner_pid="${FINCH_CARGO_SLOT_OWNER_PID:-}"
    local proof_fd="${FINCH_CARGO_SLOT_PROOF_FD:-}"
    local ancestor="$$"
    [[ "$owner_pid" =~ ^[1-9][0-9]*$ && "$proof_fd" == 107 ]] || return 1
    while [[ "$ancestor" -gt 1 && "$ancestor" != "$owner_pid" ]]; do
        ancestor="$(/bin/ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d '[:space:]')" || return 1
        [[ "$ancestor" =~ ^[1-9][0-9]*$ ]] || return 1
    done
    [[ "$ancestor" == "$owner_pid" ]] || return 1
    perl -MFcntl=:mode -e '
        my @metadata = stat(STDIN);
        exit 1 unless @metadata && S_ISREG($metadata[2]);
        exit 1 unless $metadata[3] == 0 && $metadata[4] == $< && ($metadata[2] & 0777) == 0400;
    ' <&107 || return 1
    # Perl is already a repository prerequisite for validating the proof
    # descriptor above. Its flock wrapper gives Linux and macOS one kernel
    # locking contract without assuming that a hosted macOS image includes
    # the optional `lockf` command.
    perl -MFcntl=:flock -e '
        open my $lock, ">>", $ARGV[0] or exit 2;
        exit(flock($lock, LOCK_EX | LOCK_NB) ? 1 : 0);
    ' "$lock_path"
}

# The marker and private inherited descriptor are set by the command that the
# kernel lock starts, never by the caller waiting to acquire it. Re-entry also
# proves the recorded owner is still an ancestor and the exact lock is live;
# an environment marker alone cannot bypass acquisition. This is coordination
# state only; Brain-test authority still comes solely from the Rust
# supervisor's sealed proof and owned process group.
if [[ -n "$lock_marker" ]]; then
    if [[ "$lock_marker" != "$git_common_dir" ]]; then
        echo "with-cargo-slot: inherited slot marker names a different Git common directory: expected=$git_common_dir actual=$lock_marker" >&2
        exit 69
    fi
    if slot_marker_is_live; then
        [[ "$verify_only" -eq 0 ]] || exit 0
        exec "$@"
    fi
fi
[[ "$verify_only" -eq 0 ]] || exit 1
unset FINCH_CARGO_SLOT_HELD FINCH_CARGO_SLOT_OWNER_PID FINCH_CARGO_SLOT_PROOF_FD

timeout_seconds="${FINCH_CARGO_SLOT_TIMEOUT_SECONDS:-900}"
if [[ ! "$timeout_seconds" =~ ^[0-9]+$ ]]; then
    echo "with-cargo-slot: FINCH_CARGO_SLOT_TIMEOUT_SECONDS must be a non-negative integer" >&2
    exit 64
fi

locked_exec='
    proof_path="$(umask 077; mktemp "$1/finch-cargo-slot-proof.XXXXXX")" || exit 69
    printf "%s\n" "$1" >"$proof_path" || exit 69
    chmod 0400 "$proof_path" || exit 69
    exec 107<"$proof_path" || exit 69
    rm -f -- "$proof_path" || exit 69
    export FINCH_CARGO_SLOT_HELD="$1"
    export FINCH_CARGO_SLOT_OWNER_PID="$PPID"
    export FINCH_CARGO_SLOT_PROOF_FD=107
    shift
    exec "$@"
'

case "$(uname -s)" in
    Darwin|Linux) ;;
    *)
        echo "with-cargo-slot: unsupported platform $(uname -s); refusing an unlocked build" >&2
        exit 69
        ;;
esac

# Acquire nonblocking in a bounded loop, then retain the lock in a supervising
# parent. The command child closes the lock descriptor before exec so a
# compiler cache or other daemon cannot keep the slot after Cargo exits.
exec perl -MFcntl=:flock -MTime::HiRes=time,sleep -MPOSIX=SIG_BLOCK,SIG_SETMASK,SIG_UNBLOCK,SIGHUP,SIGINT,SIGQUIT,SIGTERM -e '
    use strict;
    use warnings;
    my ($timeout, $path, @command) = @ARGV;
    open my $lock, ">>", $path
        or die "with-cargo-slot: could not open lock $path: $!\n";
    my $deadline = time() + $timeout;
    while (!flock($lock, LOCK_EX | LOCK_NB)) {
        die "with-cargo-slot: could not acquire lock $path: $!\n"
            unless $!{EWOULDBLOCK} || $!{EAGAIN};
        exit 75 if time() >= $deadline;
        sleep 0.05;
    }
    my $child = 0;
    my @pending;
    my $blocked = POSIX::SigSet->new(SIGHUP, SIGINT, SIGQUIT, SIGTERM);
    my $previous = POSIX::SigSet->new();
    POSIX::sigprocmask(SIG_BLOCK, $blocked, $previous)
        or die "with-cargo-slot: could not block signals before fork: $!\n";
    for my $signal (qw(HUP INT QUIT TERM)) {
        $SIG{$signal} = sub {
            if ($child > 0) {
                kill $signal, $child;
            } else {
                push @pending, $signal;
            }
        };
    }
    my $pid = fork();
    die "with-cargo-slot: could not fork command: $!\n" unless defined $pid;
    if ($pid == 0) {
        close $lock;
        $SIG{$_} = "DEFAULT" for qw(HUP INT QUIT TERM);
        POSIX::sigprocmask(SIG_SETMASK, $previous)
            or die "with-cargo-slot: could not restore child signal mask: $!\n";
        # The proxy promises to handle these signals even when its caller had
        # one blocked. Restoring the caller mask and then removing only the
        # handled set preserves every unrelated inherited mask bit.
        POSIX::sigprocmask(SIG_UNBLOCK, $blocked)
            or die "with-cargo-slot: could not unblock child proxy signals: $!\n";
        exec {$command[0]} @command
            or die "with-cargo-slot: could not execute $command[0]: $!\n";
    }
    $child = $pid;
    POSIX::sigprocmask(SIG_SETMASK, $previous)
        or die "with-cargo-slot: could not restore parent signal mask: $!\n";
    POSIX::sigprocmask(SIG_UNBLOCK, $blocked)
        or die "with-cargo-slot: could not unblock parent proxy signals: $!\n";
    kill $_, $child for @pending;
    my $waited;
    do {
        $waited = waitpid($child, 0);
    } while ($waited < 0 && $!{EINTR});
    die "with-cargo-slot: could not reap command $child: $!\n" if $waited < 0;
    my $status = $?;
    if ($status & 127) {
        my $signal = $status & 127;
        my %signal_name = (1 => "HUP", 2 => "INT", 3 => "QUIT", 15 => "TERM");
        $SIG{$signal_name{$signal}} = "DEFAULT" if exists $signal_name{$signal};
        kill $signal, $$;
        exit 128 + $signal;
    }
    exit($status >> 8);
' "$timeout_seconds" "$lock_path" \
    /bin/bash -c "$locked_exec" finch-cargo-slot "$git_common_dir" "$@"
