#!/usr/bin/env bash
# Regressions for the cargo build semaphore in with-cargo-slot.
#
# Run: .agents/skills/finch-backlog/scripts/test-with-cargo-slot
# Needs no cargo, no rustc, and no network; every "build" here is a sleep.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
under_test="${FINCH_CARGO_SLOT_UNDER_TEST:-$script_dir/with-cargo-slot}"
failures=0
this_repo="$(cd "$script_dir/../../../.." && pwd)"

fail() {
    echo "FAIL: $*" >&2
    failures=$(( failures + 1 ))
}

new_repo() {
    local dir
    dir="$(mktemp -d "${TMPDIR:-/tmp}/cargo-slot-test.XXXXXX")"
    git -C "$dir" init --quiet
    echo "$dir"
}

# A "build": announce presence, hold the slot, sample how many builds are live,
# release. The peak sample is the observed concurrency, measured rather than
# inferred from the lock implementation.
holder='d="$1"; : > "$d/live/$2"; sleep 2; ls "$d/live" | wc -l | tr -d " " >> "$d/observed"; rm -f "$d/live/$2"'

peak_concurrency() {
    local slots="$1" workers="$2" repo obs i
    repo="$(new_repo)"
    mkdir -p "$repo/live"
    : > "$repo/observed"
    for (( i = 1; i <= workers; i++ )); do
        (
            cd "$repo" || exit 1
            FINCH_CARGO_SLOTS="$slots" FINCH_CARGO_SLOT_TIMEOUT_SECONDS=90 \
                "$under_test" /bin/sh -c "$holder" holder "$repo" "$i"
        ) >/dev/null 2>&1 &
    done
    wait
    obs="$(sort -rn "$repo/observed" 2>/dev/null | head -1)"
    rm -rf "$repo"
    echo "${obs:-0}"
}

echo "test_semaphore_admits_exactly_the_configured_slot_count"
observed="$(peak_concurrency 2 5)"
if [[ "$observed" != "2" ]]; then
    fail "invariant: FINCH_CARGO_SLOTS=N must admit exactly N concurrent builds, no more and no fewer;" \
         "5 workers against 2 slots reached a peak of $observed concurrent." \
         "A peak of 1 means the wrapper is still a mutex and agents are serialized behind one rustc;" \
         "a peak above 2 means the memory budget is unenforced."
fi

echo "test_single_slot_still_serializes"
observed="$(peak_concurrency 1 4)"
if [[ "$observed" != "1" ]]; then
    fail "invariant: FINCH_CARGO_SLOTS=1 must reproduce the historical mutex exactly;" \
         "4 workers against 1 slot reached a peak of $observed concurrent."
fi

echo "test_command_exit_status_is_reported_not_mistaken_for_a_busy_slot"
# 75 is lockf's EX_TEMPFAIL. A command that chooses 75 itself must be reported as
# a finished failing build, never retried in the next slot as though the lock had
# been unavailable.
repo="$(new_repo)"
attempts="$repo/attempts"
: > "$attempts"
(
    cd "$repo" || exit 1
    FINCH_CARGO_SLOTS=3 FINCH_CARGO_SLOT_TIMEOUT_SECONDS=10 \
        "$under_test" /bin/sh -c 'echo x >> "$1"; exit 75' marker "$attempts"
) >/dev/null 2>&1
status=$?
ran="$(wc -l < "$attempts" | tr -d ' ')"
if [[ "$status" != "75" || "$ran" != "1" ]]; then
    fail "invariant: a command's own exit status must survive the wrapper and must not be read as a busy slot;" \
         "a command exiting 75 was run $ran time(s) and the wrapper returned $status." \
         "Expected exactly 1 run and status 75; more than one run means EX_TEMPFAIL and a real build failure are conflated."
fi
rm -rf "$repo"

echo "test_rustc_budget_is_held_constant_across_slot_counts"
repo="$(new_repo)"
for pair in "1 2" "2 1" "4 1"; do
    set -- $pair
    got="$( cd "$repo" && FINCH_CARGO_SLOTS="$1" "$under_test" /bin/sh -c 'echo "$CARGO_BUILD_JOBS"' j 2>/dev/null )"
    if [[ "$got" != "$2" ]]; then
        fail "invariant: slots x CARGO_BUILD_JOBS is the memory budget, so raising the slot count must lower jobs;" \
             "FINCH_CARGO_SLOTS=$1 produced CARGO_BUILD_JOBS=$got, expected $2." \
             "One rustc peaks near 3 GB on the finch crate, so a product above 2 swaps a 16 GB host."
    fi
done
got="$( cd "$repo" && FINCH_CARGO_SLOTS=2 CARGO_BUILD_JOBS=7 "$under_test" /bin/sh -c 'echo "$CARGO_BUILD_JOBS"' j 2>/dev/null )"
if [[ "$got" != "7" ]]; then
    fail "invariant: an explicit CARGO_BUILD_JOBS from the caller must win over the derived default; got '$got', expected 7."
fi
rm -rf "$repo"

echo "test_slot_one_interlocks_with_the_previous_single_lock_version"
# During a rollout, an agent still running the pre-semaphore script must contend
# with this one. Slot 1 therefore has to keep the historical lock path.
repo="$(new_repo)"
previous="$repo/with-cargo-slot.previous"
if git -C "$this_repo" show "main:.agents/skills/finch-backlog/scripts/with-cargo-slot" > "$previous" 2>/dev/null; then
    chmod +x "$previous"
    mkdir -p "$repo/live"
    : > "$repo/observed"
    ( cd "$repo" && FINCH_CARGO_SLOT_TIMEOUT_SECONDS=90 "$previous" /bin/sh -c "$holder" h "$repo" old ) >/dev/null 2>&1 &
    sleep 0.4
    ( cd "$repo" && FINCH_CARGO_SLOTS=1 FINCH_CARGO_SLOT_TIMEOUT_SECONDS=90 "$under_test" /bin/sh -c "$holder" h "$repo" new ) >/dev/null 2>&1 &
    wait
    observed="$(sort -rn "$repo/observed" | head -1)"
    if [[ "$observed" != "1" ]]; then
        fail "invariant: slot 1 must use the historical lock path so a process running the previous single-lock" \
             "version of this script still contends with this one; peak concurrency across versions was $observed, expected 1."
    fi
else
    echo "  skipped: main:.agents/skills/finch-backlog/scripts/with-cargo-slot is not readable from $this_repo"
fi
rm -rf "$repo"

echo "test_every_slot_busy_fails_closed_rather_than_building_unlocked"
repo="$(new_repo)"
mkdir -p "$repo/live"
: > "$repo/observed"
( cd "$repo" && FINCH_CARGO_SLOTS=1 FINCH_CARGO_SLOT_TIMEOUT_SECONDS=90 "$under_test" /bin/sh -c 'sleep 4' h ) >/dev/null 2>&1 &
sleep 0.5
out="$( cd "$repo" && FINCH_CARGO_SLOTS=1 FINCH_CARGO_SLOT_TIMEOUT_SECONDS=0 "$under_test" /bin/sh -c 'echo RAN_UNLOCKED' h 2>&1 )"
status=$?
wait
if [[ "$status" == "0" || "$out" == *RAN_UNLOCKED* ]]; then
    fail "invariant: when no slot frees before the timeout the wrapper must refuse, never run the build unlocked;" \
         "exit=$status output='$out'."
fi
rm -rf "$repo"

echo "test_invalid_slot_count_is_refused"
repo="$(new_repo)"
out="$( cd "$repo" && FINCH_CARGO_SLOTS=0 "$under_test" /bin/sh -c 'echo RAN' h 2>&1 )"
status=$?
if [[ "$status" != "64" || "$out" == *RAN* ]]; then
    fail "invariant: an unusable FINCH_CARGO_SLOTS must be refused with a usage error, not defaulted;" \
         "FINCH_CARGO_SLOTS=0 gave exit=$status output='$out', expected exit 64 and no run."
fi
rm -rf "$repo"

echo
if [[ "$failures" -eq 0 ]]; then
    echo "with-cargo-slot: all tests passed"
    exit 0
fi
echo "with-cargo-slot: $failures test(s) failed"
exit 1
