# Shammah specific
# Don't commit local models or training data
.claude-proxy/
*.mlpackage
*.mlmodelc
training-data/
*.jsonl

# But DO commit example configs
!examples/*.json

# Logs
*.log
debug.log
shammah_errors.log

# Repository hygiene: known local diagnostics and transient files
/debug_filter
/test_filter
/metal_error.txt
*.bak
*.orig
*.rej
*.dmp
*.dump
core
core.[0-9]*
*.profraw
*.profdata
*.gcda
*.gcno
