# Finch compact-wire ProgramSubmission grammar v1
# Generated from production Lisp/Co-Forth reader lexicons by finch_language::render_wire_gbnf.
# Complete-response recognizer only. Not a proof of types, capabilities, or host-effect safety.
# Markdown fences and empty submissions are rejected. Provider-native tool calls are a separate channel.
# Do not edit this file by hand. Update the generator and regenerate vocabulary/language/wire.gbnf.

root ::= lead ( lisp-program | forth-program ) lead
lead ::= unicode-ws*
unicode-ws ::= [\t\n\x0b\x0c\r                  　]
lisp-program ::= lisp-list lisp-gap* ( lisp-form lisp-gap* )*
lisp-gap ::= unicode-ws | lisp-line-comment | lisp-block-comment
lisp-line-comment ::= ";" [^\n]*
lisp-block-comment ::= "#|" lisp-block-body "|#"
lisp-block-body ::= ( [^|] | "|" [^#] )*
lisp-form ::= lisp-splice | lisp-unquote | lisp-quote | lisp-quasiquote | lisp-list | lisp-string | lisp-math | lisp-compact | lisp-brace | lisp-array | lisp-atom
lisp-splice ::= ",@" lisp-gap* lisp-form
lisp-unquote ::= "," lisp-gap* lisp-form
lisp-quote ::= "'" lisp-gap* lisp-form
lisp-quasiquote ::= "`" lisp-gap* lisp-form
lisp-list ::= "(" lisp-gap* ( lisp-form lisp-gap* )* ")"
lisp-string ::= "\"" lisp-str-char* "\""
lisp-str-char ::=  "\\" . | [^"\\] 
lisp-math ::= "$" math-ws* math-bit ( math-ws* math-bit )* math-ws* "$"
math-ws ::= unicode-ws
math-bit ::= [+\-*/^()] | math-num | math-ident
math-num ::= [0-9]+ ( "." [0-9]* )?
math-ident ::= [a-zA-Z_] [a-zA-Z0-9_]*
lisp-compact ::= "record{" compact-body "}" | "variant{" compact-body "}"
compact-body ::= compact-chunk*
compact-chunk ::= compact-plain | "{" compact-body "}"
compact-plain ::= [^ \t\n\r\x0b\x0c"{}]+
lisp-brace ::= json-object | lisp-record
lisp-record ::= "{" lisp-gap* ( ":" lisp-atom lisp-gap+ lisp-form lisp-gap* )* "}"
lisp-array ::= json-array
lisp-atom ::= lisp-atom-start lisp-atom-piece*
lisp-atom-start ::= [^\t\n\x0b\x0c\r                  　(){}"';`,<>$]
lisp-atom-piece ::= lisp-plain | lisp-angles
lisp-plain ::= [^\t\n\x0b\x0c\r                  　(){}"';`,<>]
lisp-angles ::= "<" lisp-angle-body ">"
lisp-angle-body ::= ( lisp-plain | "," | lisp-angles )*
json-ws ::= unicode-ws
json-object ::= "{" json-ws* json-object-body
json-object-body ::= "}" | json-member ( json-ws* "," json-ws* json-member )* json-ws* "}"
json-member ::= json-string json-ws* ":" json-ws* json-value
json-array ::= "[" json-ws* json-array-body
json-array-body ::= "]" | json-value ( json-ws* "," json-ws* json-value )* json-ws* "]"
json-value ::= json-object | json-array | json-string | json-number | "true" | "false" | "null"
json-string ::=  "\"" json-str-char* "\"" 
json-str-char ::=  json-escape | json-unescaped 
json-escape ::=  "\\" ( ["\\/bfnrt] | "u" json-hex json-hex json-hex json-hex ) 
json-hex ::= [0-9a-fA-F]
json-unescaped ::= [^"\\\x00-\x1f]
json-number ::=  "-"? json-int json-frac? json-exp? 
json-int ::=  "0" | [1-9] [0-9]* 
json-frac ::=  "." [0-9]+ 
json-exp ::=  [eE] ( "+" | "-" )? [0-9]+ 
ascii-ws ::= [ \t\n\r\x0b\x0c]
forth-ws ::= ascii-ws
forth-comment ::= "\\" [^\n]*
forth-gap ::= forth-ws | "," | forth-comment
forth-program ::= forth-ws* forth-nonempty
forth-nonempty ::= forth-comment forth-more | forth-first forth-more
forth-more ::= forth-gap* ( forth-item forth-gap* )*
forth-first ::= forth-raw | forth-string | forth-def | forth-compact | forth-collection | forth-type | forth-bracket | forth-json | forth-record | forth-first-word
forth-item ::= forth-raw | forth-string | forth-def | forth-compact | forth-collection | forth-type | forth-bracket | forth-json | forth-record | forth-word
forth-raw ::= "s\"\"\"" raw-body "\"\"\"" | "\"\"\"" raw-body "\"\"\""
raw-body ::= ( [^"] | "\"" [^"] | "\"\"" [^"] )*
forth-string ::= ".\"" ascii-ws? esc-body | "s\"" ascii-ws? esc-body | "\"" esc-body
esc-body ::=  esc-char* "\"" 
esc-char ::=  "\\" . | [^"\\] 
forth-def ::= ":" forth-gap+ forth-word forth-gap+ "(" forth-sig-body ")" forth-def-body ";"
forth-sig-body ::= ( forth-gap | forth-string | forth-raw | forth-sig-word | forth-compact | forth-type )*
forth-sig-word ::= [^\t\n\x0b\x0c\r ,"()[\]}]
forth-def-body ::= ( forth-gap+ forth-body-item )* forth-gap*
forth-body-item ::= forth-raw | forth-string | forth-compact | forth-collection | forth-type | forth-bracket | forth-json | forth-record | forth-body-word
forth-compact ::= "record{" compact-body "}" | "variant{" compact-body "}"
forth-collection ::= "map{" | "list{" | "record{" | "}map" | "}list" | "}record"
forth-type ::= "empty-list<" [^ \t\n\r>]* ">" | "empty-map<" [^ \t\n\r>]* ">" | "list<" [^ \t\n\r>]* ">" | "map<" [^ \t\n\r>]* ">" | "option<" [^ \t\n\r>]* ">" | "result<" [^ \t\n\r>]* ">" | "fn<" [^ \t\n\r>]* ">" | "task<" [^ \t\n\r>]* ">" | "fiber<" [^ \t\n\r>]* ">" | "stream<" [^ \t\n\r>]* ">" | "resource<" [^ \t\n\r>]* ">" | "capability<" [^ \t\n\r>]* ">" | "variant<" [^ \t\n\r>]* ">" | "variant-get<" [^ \t\n\r>]* ">"
forth-bracket ::= forth-quote | forth-list
forth-quote ::= "[" forth-gap* "--" forth-gap* forth-qhead "|" forth-quote-body "]"
forth-qhead ::= ( forth-word forth-gap* )*
forth-quote-body ::= ( forth-gap | forth-body-item )*
forth-list ::= "[" forth-gap* ( forth-body-item forth-gap* )* "]"
forth-json ::= json-object
forth-record ::= "{" forth-gap* ( forth-word forth-gap+ forth-body-item forth-gap* )* "}"
forth-word ::= ":" forth-word-char+ | forth-plain-start forth-word-char*
forth-body-word ::= ":" forth-body-word-char+ | forth-body-plain-start forth-body-word-char*
forth-first-word ::= ":" forth-word-char+ | forth-first-start forth-word-char*
forth-plain-start ::= [^:\t\n\x0b\x0c\r ,"[\]}]
forth-body-plain-start ::= [^:\t\n\x0b\x0c\r ,"[\]};]
forth-word-char ::= [^\t\n\x0b\x0c\r ,"[\]}]
forth-body-word-char ::= [^\t\n\x0b\x0c\r ,"[\]};]
forth-first-start ::= [^`(:\t\n\x0b\x0c\r ,"[\]}] | "`" "`"? [^`(:\t\n\x0b\x0c\r ,"[\]}]
